@{
    ViewData["Title"] = "หน้าหลักผู้ดูแลระบบ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-mint">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.PatientCount</h2>
                        <p class="stats-label">ผู้ป่วยทั้งหมด</p>
                    </div>
                    <div>
                        <i class="fas fa-user-injured stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">ข้อมูลล่าสุด</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-dark-green">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.UserCount</h2>
                        <p class="stats-label">ผู้ใช้งานระบบ</p>
                    </div>
                    <div>
                        <i class="fas fa-users stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">ผู้ใช้ที่ลงทะเบียน</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-gray">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.FormCount</h2>
                        <p class="stats-label">แบบฟอร์มประเมิน</p>
                    </div>
                    <div>
                        <i class="fas fa-clipboard-list stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">แบบฟอร์มที่ใช้งานได้</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-mint">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.TodayLogins</h2>
                        <p class="stats-label">เข้าใช้งานวันนี้</p>
                    </div>
                    <div>
                        <i class="fas fa-sign-in-alt stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">ครั้งการเข้าใช้งานวันนี้</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-lg-8 mb-4">
        <div class="modern-card">
            <div class="card-header">
                <i class="fas fa-chart-line me-2"></i>สถิติการใช้งานระบบ
            </div>
            <div class="card-body">
                <div class="chart-placeholder">
                    <div class="text-center">
                        <div class="chart-container" style="position: relative; height: 300px; width: 100%;">
                            <canvas id="loginChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="modern-card">
            <div class="card-header">
                <i class="fas fa-server me-2"></i>สถานะระบบ
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <span class="status-online"></span>
                    <span style="color: var(--dark-green); font-weight: 600;">เซิร์ฟเวอร์ออนไลน์</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="status-online"></span>
                    <span style="color: var(--dark-green); font-weight: 600;">ฐานข้อมูลพร้อมใช้งาน</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="status-online"></span>
                    <span style="color: var(--dark-green); font-weight: 600;">ระบบพร้อมใช้งาน</span>
                </div>
                <hr style="border-color: #e9ecef;">
                <div class="text-center">
                    <a href="@Url.Action("Logs", "Admin")" class="btn btn-mint">
                        <i class="fas fa-history me-2"></i>ดูประวัติการใช้งาน
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
           
            
            // Add any JavaScript functionality here
            $('.stats-card').hover(
                function() {
                    $(this).find('.stats-icon').animate({ fontSize: '45px' }, 200);
                },
                function() {
                    $(this).find('.stats-icon').animate({ fontSize: '40px' }, 200);
                }
            );
        });
        async function renderLoginChartLast30Days() {
            try {
                const response = await fetch('/Admin/LoginChart');
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const chartData = await response.json();

                const existingChart = Chart.getChart('loginChart');
                if (existingChart) {
                    existingChart.destroy();
                }

                const loginCtx = document.getElementById('loginChart').getContext('2d');
                new Chart(loginCtx, {
                    type: 'line',
                    data: {
                        labels: chartData.labels,
                        datasets: [{
                            label: 'จำนวนการเข้าใช้ระบบ',
                            data: chartData.data,
                            backgroundColor: 'rgba(81, 195, 183, 0.2)',
                            borderColor: 'rgba(81, 195, 183, 1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4,
                            pointBackgroundColor: 'rgba(81, 195, 183, 1)',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        animation: {
                            duration: 1000,
                            easing: 'easeOutQuart'
                        },
                        plugins: {
                            legend: {
                                display: true,
                                labels: {
                                    color: '#333',
                                    font: {
                                        family: 'Kanit, sans-serif',
                                        size: 12
                                    }
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                titleColor: '#fff',
                                bodyColor: '#fff',
                                borderColor: 'rgba(81, 195, 183, 1)',
                                borderWidth: 1,
                                callbacks: {
                                    title: function(context) {
                                        return `วันที่ ${context[0].label}`;
                                    },
                                    label: function(context) {
                                        return `ผู้เข้าใช้: ${context.raw} ครั้ง`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'วันที่',
                                    color: '#666',
                                    font: {
                                        family: 'Kanit, sans-serif',
                                        size: 12
                                    }
                                },
                                ticks: {
                                    color: '#666',
                                    font: {
                                        family: 'Kanit, sans-serif',
                                        size: 11
                                    },
                                    maxRotation: 45,
                                    minRotation: 0
                                },
                                grid: {
                                    color: 'rgba(200, 200, 200, 0.3)'
                                }
                            },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    color: '#666',
                                    font: {
                                        family: 'Sarabun, sans-serif',
                                        size: 11
                                    },
                                    callback: function(value) {
                                        if (Number.isInteger(value)) {
                                            return value + ' ครั้ง';
                                        }
                                        return null;
                                    },
                                    stepSize: 1
                                },
                                title: {
                                    display: true,
                                    text: 'จำนวนการเข้าสู่ระบบ',
                                    color: '#666',
                                    font: {
                                        family: 'Sarabun, sans-serif',
                                        size: 12
                                    }
                                },
                                grid: {
                                    color: 'rgba(200, 200, 200, 0.3)'
                                }
                            }
                        }
                    }
                });
            } catch (error) {
                console.error('Error fetching login chart data:', error);
                const chartContainer = document.querySelector('.chart-container');
                if (chartContainer) {
                    chartContainer.innerHTML = `
                        <div class="text-center text-muted p-4">
                            <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                            <p>ไม่สามารถโหลดข้อมูลกราฟได้</p>
                            <small>กรุณาลองใหม่อีกครั้ง</small>
                        </div>
                    `;
                }
            }
        }

        document.addEventListener('DOMContentLoaded', renderLoginChartLast30Days);
    </script>
}

