                            <h6>การสำรองข้อมูล</h6>
                            <small class="text-success">ปกติ</small>
                        </div>
                        <div class="col-md-3 text-center">
                            <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                            <h6>ความปลอดภัย</h6>
                            <small class="text-success">ปกติ</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
