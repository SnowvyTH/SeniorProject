@{
    ViewData["Title"] = "หน้าหลักผู้ดูแลระบบ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-mint">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.PatientCount</h2>
                        <p class="stats-label">ผู้ป่วยทั้งหมด</p>
                    </div>
                    <div>
                        <i class="fas fa-user-injured stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">ข้อมูลล่าสุด</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-dark-green">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.UserCount</h2>
                        <p class="stats-label">ผู้ใช้งานระบบ</p>
                    </div>
                    <div>
                        <i class="fas fa-users stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">ผู้ใช้ที่ลงทะเบียน</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-gray">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.FormCount</h2>
                        <p class="stats-label">แบบฟอร์มประเมิน</p>
                    </div>
                    <div>
                        <i class="fas fa-clipboard-list stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">แบบฟอร์มที่ใช้งานได้</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-4">
        <div class="stats-card card-mint">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="stats-number">@ViewBag.TodayLogins</h2>
                        <p class="stats-label">เข้าใช้งานวันนี้</p>
                    </div>
                    <div>
                        <i class="fas fa-sign-in-alt stats-icon"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="status-online"></span>
                    <small style="color: var(--light-gray);">ครั้งการเข้าใช้งานวันนี้</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-lg-8 mb-4">
        <div class="modern-card">
            <div class="card-header">
                <i class="fas fa-tools me-2"></i>เครื่องมือจัดการระบบ
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-mint w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="min-height: 120px;">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <span>จัดการผู้ใช้</span>
                            <small class="mt-1" style="opacity: 0.8;">@ViewBag.UserCount คน</small>
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a href="@Url.Action("Titles", "Admin")" class="btn btn-mint w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="min-height: 120px;">
                            <i class="fas fa-id-badge fa-2x mb-2"></i>
                            <span>จัดการคำนำหน้า</span>
                            <small class="mt-1" style="opacity: 0.8;">คำนำหน้าชื่อ</small>
                        </a>
                    </div>
                    <div class="col-md-4 mb-3">
                        <a href="@Url.Action("Treatments", "Admin")" class="btn btn-mint w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="min-height: 120px;">
                            <i class="fas fa-user-md fa-2x mb-2"></i>
                            <span>สิทธิ์การรักษา</span>
                            <small class="mt-1" style="opacity: 0.8;">จัดการสิทธิ์</small>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="modern-card">
            <div class="card-header">
                <i class="fas fa-server me-2"></i>สถานะระบบ
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <span class="status-online"></span>
                    <span style="color: var(--dark-green); font-weight: 600;">เซิร์ฟเวอร์ออนไลน์</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="status-online"></span>
                    <span style="color: var(--dark-green); font-weight: 600;">ฐานข้อมูลพร้อมใช้งาน</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <span class="status-online"></span>
                    <span style="color: var(--dark-green); font-weight: 600;">ระบบความปลอดภัย</span>
                </div>
                <hr style="border-color: #e9ecef;">
                <div class="text-center">
                    <a href="@Url.Action("Logs", "Admin")" class="btn btn-mint">
                        <i class="fas fa-history me-2"></i>ดูประวัติการใช้งาน
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart Section -->
<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="modern-card">
            <div class="card-header">
                <i class="fas fa-chart-line me-2"></i>สถิติการใช้งานระบบ
            </div>
            <div class="card-body">
                <div class="chart-placeholder">
                    <div class="text-center">
                        <i class="fas fa-chart-area fa-3x mb-3" style="color: var(--mint-green);"></i>
                        <p style="color: var(--light-gray);">กราฟแสดงสถิติการใช้งานระบบรายเดือน</p>
                        <small style="color: var(--light-gray);">ข้อมูลจะแสดงเมื่อมีการใช้งานระบบ</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="modern-card">
            <div class="card-header">
                <i class="fas fa-clock me-2"></i>กิจกรรมล่าสุด
            </div>
            <div class="card-body">
                <div class="text-center py-4">
                    <i class="fas fa-history fa-2x mb-3" style="color: var(--mint-green);"></i>
                    <p style="color: var(--light-gray);">ไม่มีกิจกรรมล่าสุด</p>
                    <small style="color: var(--light-gray);">กิจกรรมของผู้ใช้จะแสดงที่นี่</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Admin Dashboard loaded successfully');
            
            // Add any JavaScript functionality here
            $('.stats-card').hover(
                function() {
                    $(this).find('.stats-icon').animate({ fontSize: '45px' }, 200);
                },
                function() {
                    $(this).find('.stats-icon').animate({ fontSize: '40px' }, 200);
                }
            );
        });
    </script>
}

    <div class="row">
