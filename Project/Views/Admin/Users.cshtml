@{
    ViewData["Title"] = "จัดการรายชื่อผู้ใช้";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="fas fa-users me-2"></i>จัดการรายชื่อผู้ใช้</h4>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="fas fa-plus me-2"></i>เพิ่มผู้ใช้ใหม่
        </button>
    </div>

    
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" id="searchUser" class="form-control" placeholder="ค้นหาผู้ใช้...">
            </div>
        </div>
        <div class="col-md-3">
            <select id="roleFilter" class="form-select">
                <option value="">ทุกสิทธิ์</option>
                <option value="1">เภสัช</option>
                <option value="2">หัวหน้าเภสัช</option>
                <option value="3">ผู้ดูแลระบบ</option>
            </select>
        </div>
        <div class="col-md-3">
            <select id="statusFilter" class="form-select">
                <option value="">ทุกสถานะ</option>
                <option value="true">ใช้งานได้</option>
                <option value="false">ปิดการใช้งาน</option>
            </select>
        </div>
    </div>

    
    <div class="table-responsive">
        <table class="table table-hover" id="usersTable">
            <thead class="table-light">
                <tr>
                    <th>รหัสผู้ใช้</th>
                    <th>ชื่อ-นามสกุล</th>
                    <th>ชื่อผู้ใช้</th>
                    <th>สิทธิ์</th>
                    <th>สถานะ</th>
                    <th>การจัดการ</th>
                </tr>
            </thead>
            <tbody id="usersTableBody">

            </tbody>
        </table>
    </div>
    
    
    <nav aria-label="Page navigation" class="mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <small class="text-muted" id="usersPaginationInfo"></small>
            </div>
            <ul class="pagination pagination-sm mb-0" id="usersPagination">
                
            </ul>
        </div>
    </nav>

    
    <div id="loadingIndicator" class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">กำลังโหลด...</span>
        </div>
    </div>
</div>


<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>เพิ่มผู้ใช้ใหม่</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addUserForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">คำนำหน้า</label>
                                <select class="form-select" name="TitleID" required>
                                    <option value="">เลือกคำนำหน้า</option>
                                    
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ชื่อ</label>
                                <input type="text" class="form-control" name="FirstName" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">นามสกุล</label>
                                <input type="text" class="form-control" name="LastName" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ชื่อผู้ใช้</label>
                                <input type="text" class="form-control" name="Username" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">รหัสผ่าน</label>
                                <input type="password" class="form-control" name="Password" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">สิทธิ์</label>
                                <select class="form-select" name="RoleID" required>
                                    <option value="">เลือกสิทธิ์</option>
                                    <option value="1">เภสัช</option>
                                    <option value="2">หัวหน้าเภสัช</option>
                                    <option value="3">ผู้ดูแลระบบ</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsActive" checked>
                            <label class="form-check-label">เปิดใช้งาน</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success">เพิ่มผู้ใช้</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>แก้ไขข้อมูลผู้ใช้</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editUserForm">
                <input type="hidden" name="UserID" id="editUserID">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">คำนำหน้า</label>
                                <select class="form-select" name="TitleID" id="editTitleID" required>
                                    
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ชื่อ</label>
                                <input type="text" class="form-control" name="FirstName" id="editFirstName" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">นามสกุล</label>
                                <input type="text" class="form-control" name="LastName" id="editLastName" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ชื่อผู้ใช้</label>
                                <input type="text" class="form-control" name="Username" id="editUsername" disable readonly>
                                <input type="hidden" class="form-control" name="Username" id="editUsername">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">รหัสผ่านใหม่ (เว้นว่างถ้าไม่เปลี่ยน)</label>
                                <input type="password" class="form-control" name="Password" id="editPassword">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">สิทธิ์</label>
                                <select class="form-select" name="RoleID" id="editRoleID" required>
                                    <option value="1">เภสัช</option>
                                    <option value="2">หัวหน้าเภสัช</option>
                                    <option value="3">ผู้ดูแลระบบ</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success">บันทึกการเปลี่ยนแปลง</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="profilePictureModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-image me-2"></i>จัดการรูปโปรไฟล์</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="profileUserId" value="">
                <div class="text-center mb-4">
                    <div class="profile-picture-container mx-auto">
                        <div id="profilePlaceholder" class="profile-picture-placeholder">
                            <i class="fas fa-user fa-3x"></i>
                        </div>
                        <img id="profileImage" class="profile-picture-img" style="display: none;">
                    </div>
                    <h6 id="profileUserName"></h6>
                </div>
                
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label">อัปโหลดรูปภาพใหม่</label>
                        <input type="file" class="form-control" id="profilePictureFile" accept="image/*">
                        <div class="form-text">รองรับไฟล์ JPG, PNG, GIF ขนาดไม่เกิน 5MB</div>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button type="button" class="btn btn-danger" id="removeProfileBtn" onclick="removeUserProfilePicture()" style="display: none;">
                            <i class="fas fa-trash me-2"></i>ลบรูปภาพ
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" class="btn btn-primary" onclick="uploadUserProfilePicture()">
                    <i class="fas fa-upload me-2"></i>บันทึกรูปภาพ
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .profile-picture-container {
            width: 120px;
            height: 120px;
            position: relative;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid #51c3b7;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-picture-placeholder {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #05685e;
        }

        .profile-picture-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-avatar-small {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid #51c3b7;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            color: #05685e;
            font-size: 0.8rem;
            font-weight: bold;
            cursor: pointer;
        }

        .user-avatar-small img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .user-avatar-small:hover {
            border-color: #05685e;
            transform: scale(1.05);
            transition: all 0.2s ease;
        }

        /* Toggle Switch Styles */
        .toggle-switch {
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .toggle-switch:checked {
            background-color: #51c3b7 !important;
            border-color: #51c3b7 !important;
        }

        .toggle-switch:not(:checked) {
            background-color: #dc3545 !important;
            border-color: #dc3545 !important;
        }

        .toggle-switch:focus {
            box-shadow: 0 0 0 0.25rem rgba(81, 195, 183, 0.25) !important;
        }

        .form-switch .form-check-input {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%23fff'/%3e%3c/svg%3e") !important;
        }

        .form-check-label {
            cursor: pointer;
            user-select: none;
        }
    </style>
}

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        let currentUsersPage = 1;
        const usersPageSize = 5;
        let allUsers = [];

        $(document).ready(function() {
            loadUsers();
            loadTitles();

            $('#searchUser').on('keyup', function() {
                currentUsersPage = 1;
                loadUsers();
            });

            $('#roleFilter, #statusFilter').on('change', function() {
                currentUsersPage = 1;
                loadUsers();
            });

            $('#addUserForm').on('submit', function(e) {
                e.preventDefault();
                addUser();
            });

            $('#editUserForm').on('submit', function(e) {
                e.preventDefault();
                updateUser();
            });
        });

        function loadUsers() {
            $('#loadingIndicator').show();
            $('#usersTable tbody').hide();

            const search = $('#searchUser').val();
            const roleFilter = $('#roleFilter').val();
            const statusFilter = $('#statusFilter').val();

            $.ajax({
                url: '@Url.Action("GetUsers", "Admin")',
                method: 'GET',
                data: {
                    search: search,
                    roleFilter: roleFilter,
                    statusFilter: statusFilter
                },
                success: function(data) {
                    allUsers = data; 
                    displayUsers(data);
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการโหลดข้อมูล',
                        confirmButtonColor: '#51c3b7'
                    });
                    $('#loadingIndicator').hide();
                }
            });
        }

        function loadTitles() {
            $.ajax({
                url: '@Url.Action("GetTitles", "Admin")',
                method: 'GET',
                success: function(data) {
                    let options = '<option value="">เลือกคำนำหน้า</option>';
                    data.forEach(function(title) {
                        options += `<option value="${title.titleID}">${title.titleName}</option>`;
                    });
                    $('select[name="TitleID"]').html(options);
                }
            });
        }

        function displayUsers(users) {
            const paginatedData = paginateData(users, currentUsersPage, usersPageSize);
            const tbody = $('#usersTableBody');
            tbody.empty();

            if (paginatedData.items.length === 0) {
                tbody.html('<tr><td colspan="6" class="text-center">ไม่พบข้อมูลผู้ใช้</td></tr>');
                $('#usersPagination').parent().hide();
                $('#usersPaginationInfo').text('');
                $('#loadingIndicator').hide();
                $('#usersTable tbody').show();
                return;
            }
            
            $('#usersPagination').parent().show();

            let html = '';
            paginatedData.items.forEach(function(user) {
                const statusBadge = user.isActive ? 
                    '<span class="badge bg-success">ใช้งานได้</span>' : 
                    '<span class="badge bg-danger">ปิดการใช้งาน</span>';
                
                const roleName = getRoleName(user.roleID);
                const roleClass = (roleName === 'ผู้ดูแลระบบ') ? 'bg-secondary' :
                                        (roleName === 'เภสัช') ? 'bg-mint' :
                                        'bg-success';

                html += `
                    <tr>
                        <td>${user.userID}</td>
                        <td>${user.titleName} ${user.firstName} ${user.lastName}</td>
                        <td>${user.username}</td>
                        <td><span class="badge rounded-pill ${roleClass}">${roleName}</span></td>
                        <td>
                            <div class="form-check form-switch d-flex">
                                <input class="form-check-input toggle-switch" type="checkbox" 
                                       id="userStatus${user.userID}" 
                                       ${user.isActive ? 'checked' : ''} 
                                       onchange="toggleUserStatus(${user.userID}, this.checked)"
                                       style="cursor: pointer; width: 50px; height: 25px;">
                                <label class="form-check-label ms-2 ${user.isActive ? 'text-success' : 'text-danger'}" 
                                       for="userStatus${user.userID}" style="font-size: 0.85rem; font-weight: 600;">
                                    ${user.isActive ? 'เปิดใช้งาน' : 'ปิดใช้งาน'}
                                </label>
                            </div>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-warning" onclick="editUser(${user.userID})">
                                <i class="fas fa-edit"></i> แก้ไข
                            </button>
                        </td>
                    </tr>
                `;
            });
            
            tbody.html(html);
            $('#loadingIndicator').hide();
            $('#usersTable tbody').show();
            
            generatePagination(paginatedData.totalPages, currentUsersPage, 'usersPagination', 'changeUsersPage');
            updatePaginationInfo(currentUsersPage, usersPageSize, paginatedData.totalItems, 'usersPaginationInfo');
        }

        function changeUsersPage(page) {
            currentUsersPage = page;
            displayUsers(allUsers);
        }

        function getRoleName(roleID) {
            switch(roleID) {
                case 1: return 'เภสัช';
                case 2: return 'หัวหน้าเภสัช';
                case 3: return 'ผู้ดูแลระบบ';
                default: return 'ไม่ระบุ';
            }
        }

        function addUser() {
            const formData = new FormData($('#addUserForm')[0]);
            
            $.ajax({
                url: '@Url.Action("CreateUser", "Admin")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if(response.success) {
                        $('#addUserModal').modal('hide');
                        $('#addUserForm')[0].reset();
                        loadUsers();
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: 'เพิ่มผู้ใช้สำเร็จ',
                            confirmButtonColor: '#51c3b7'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการเพิ่มผู้ใช้',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function editUser(userID) {
            $.ajax({
                url: '@Url.Action("GetUser", "Admin")',
                method: 'GET',
                data: { id: userID },
                success: function(user) {
                    $('#editUserID').val(user.userID);
                    $('#editTitleID').val(user.titleID);
                    $('#editFirstName').val(user.firstName);
                    $('#editLastName').val(user.lastName);
                    $('#editUsername').val(user.username);
                    $('#editRoleID').val(user.roleID);
                    $('#editUserModal').modal('show');
                }
            });
        }

        function updateUser() {
            const formData = new FormData($('#editUserForm')[0]);
            
            $.ajax({
                url: '@Url.Action("UpdateUser", "Admin")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if(response.success) {
                        $('#editUserModal').modal('hide');
                        loadUsers();
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: 'อัปเดตข้อมูลผู้ใช้สำเร็จ',
                            confirmButtonColor: '#51c3b7'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการอัปเดตข้อมูล',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function toggleUserStatus(userID, newStatus) {
            const checkbox = document.getElementById(`userStatus${userID}`);
            
            $.ajax({
                url: '@Url.Action("ToggleUserStatus", "Admin")',
                method: 'POST',
                data: { userID: userID, isActive: newStatus },
                success: function(response) {
                    if(response.success) {
                        loadUsers();
                    } else {
                        checkbox.checked = !newStatus;
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    checkbox.checked = !newStatus;
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการเปลี่ยนสถานะ',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function manageProfilePicture(userId, userName, currentPictureUrl) {
            $('#profileUserId').val(userId);
            $('#profileUserName').text(userName);
            
            if (currentPictureUrl && currentPictureUrl !== 'null' && currentPictureUrl !== '') {
                $('#profileImage').attr('src', currentPictureUrl + '?t=' + new Date().getTime()).show();
                $('#profilePlaceholder').hide();
                $('#removeProfileBtn').show();
            } else {
                $('#profileImage').hide();
                $('#profilePlaceholder').show();
                $('#removeProfileBtn').hide();
            }
            
            $('#profilePictureFile').val('');
            
            $('#profilePictureModal').modal('show');
        }

        function uploadUserProfilePicture() {
            const userId = $('#profileUserId').val();
            const fileInput = $('#profilePictureFile')[0];
            
            if (!fileInput.files || fileInput.files.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกไฟล์',
                    text: 'กรุณาเลือกไฟล์รูปภาพที่ต้องการอัปโหลด',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }

            const file = fileInput.files[0];
            
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                Swal.fire({
                    icon: 'error',
                    title: 'รูปแบบไฟล์ไม่ถูกต้อง',
                    text: 'กรุณาเลือกไฟล์รูปภาพ (jpg, jpeg, png, gif)',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({
                    icon: 'error',
                    title: 'ขนาดไฟล์ใหญ่เกินไป',
                    text: 'ขนาดไฟล์ต้องไม่เกิน 5MB',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }

            Swal.fire({
                title: 'กำลังบันทึกรูปภาพ...',
                text: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const formData = new FormData();
            formData.append('userId', userId);
            formData.append('profilePicture', file);

            $.ajax({
                url: '@Url.Action("UploadUserProfilePicture", "Admin")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: response.message,
                            confirmButtonColor: '#51c3b7'
                        }).then(() => {
                            $('#profilePictureModal').modal('hide');
                            loadUsers();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถบันทึกรูปภาพได้',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function removeUserProfilePicture() {
            const userId = $('#profileUserId').val();
            
            Swal.fire({
                title: 'ยืนยันการลบรูปภาพ',
                text: 'คุณต้องการลบรูปภาพโปรไฟล์หรือไม่?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'กำลังลบรูปภาพ...',
                        text: 'กรุณารอสักครู่',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '@Url.Action("RemoveUserProfilePicture", "Admin")',
                        type: 'POST',
                        data: { userId: userId },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'สำเร็จ',
                                    text: response.message,
                                    confirmButtonColor: '#51c3b7'
                                }).then(() => {
                                    $('#profilePictureModal').modal('hide');
                                    loadUsers();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: response.message,
                                    confirmButtonColor: '#51c3b7'
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: 'ไม่สามารถลบรูปภาพได้',
                                confirmButtonColor: '#51c3b7'
                            });
                        }
                    });
                }
            });
        }
    </script>
}
