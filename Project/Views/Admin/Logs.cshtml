@{
    ViewData["Title"] = "ประวัติการเข้าใช้งาน";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="fas fa-history me-2"></i>ประวัติการเข้าใช้งานระบบ</h4>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" onclick="refreshLogs()">
                <i class="fas fa-sync-alt me-1"></i>รีเฟรช
            </button>
        </div>
    </div>

    
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" id="searchUser" class="form-control" placeholder="ค้นหาผู้ใช้...">
            </div>
        </div>
        <div class="col-md-3">
            <input type="date" id="dateFrom" class="form-control" title="วันที่เริ่มต้น">
        </div>
        <div class="col-md-3">
            <input type="date" id="dateTo" class="form-control" title="วันที่สิ้นสุด">
        </div>
        <div class="col-md-3">
            <select id="roleFilter" class="form-select">
                <option value="">ทุกสิทธิ์</option>
                <option value="1">เภสัช</option>
                <option value="2">หัวหน้าเภสัช</option>
                <option value="3">ผู้ดูแลระบบ</option>
            </select>
        </div>
    </div>

    
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">วันนี้</h5>
                            <h3 id="todayCount">0</h3>
                        </div>
                        <i class="fas fa-calendar-day fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">สัปดาห์นี้</h5>
                            <h3 id="weekCount">0</h3>
                        </div>
                        <i class="fas fa-calendar-week fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">เดือนนี้</h5>
                            <h3 id="monthCount">0</h3>
                        </div>
                        <i class="fas fa-calendar-alt fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h5 class="card-title">ทั้งหมด</h5>
                            <h3 id="totalCount">0</h3>
                        </div>
                        <i class="fas fa-chart-bar fa-2x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <div class="table-responsive">
        <table class="table table-hover" id="logsTable">
            <thead class="table-light">
                <tr>
                    <th width="200">วันที่เวลา</th>
                    <th>ผู้ใช้</th>
                    <th width="160">สิทธิ์</th>
                </tr>
            </thead>
            <tbody id="logsTableBody">
                
            </tbody>
        </table>
    </div>

    
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center" id="pagination">
            
        </ul>
    </nav>

    
    <div id="loadingIndicator" class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">กำลังโหลด...</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 5;

        $(document).ready(function() {
            const today = new Date();
            const lastWeek = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
            
            $('#dateTo').val(today.toISOString().split('T')[0]);
            $('#dateFrom').val(lastWeek.toISOString().split('T')[0]);

            loadLogs();
            loadLogStats();

            $('#searchUser, #dateFrom, #dateTo, #roleFilter').on('change keyup', function() {
                currentPage = 1;
                loadLogs();
                loadLogStats();
            });
        });

        function loadLogs() {
            $('#loadingIndicator').show();
            $('#logsTable tbody').hide();

            const search = $('#searchUser').val();
            const dateFrom = $('#dateFrom').val();
            const dateTo = $('#dateTo').val();
            const roleFilter = $('#roleFilter').val();

            $.ajax({
                url: '@Url.Action("GetLogs", "Admin")',
                method: 'GET',
                data: {
                    search: search,
                    dateFrom: dateFrom,
                    dateTo: dateTo,
                    roleFilter: roleFilter,
                    page: currentPage,
                    pageSize: pageSize
                },
                success: function(response) {
                    let html = '';
                    response.logs.forEach(function(log) {
                        const logDate = new Date(log.logDateTime).toLocaleString('th-TH');
                        const roleName = getRoleName(log.roleID);
                        const roleClass = (roleName === 'ผู้ดูแลระบบ') ? 'bg-secondary' :
                                                (roleName === 'เภสัช') ? 'bg-mint' :
                                                'bg-success';

                        html += `
                            <tr>
                                <td><i class="text-primary fas fa-calendar-alt opacity-75"></i> ${logDate}</td>
                                <td>${log.titleName || ''} ${log.firstName || ''} ${log.lastName || ''}</td>
                                <td><span class="badge ${roleClass}">${roleName}</span></td>
                            </tr>
                        `;
                    });
                    
                    $('#logsTableBody').html(html);
                    generatePagination(response.totalPages, response.currentPage);
                    $('#loadingIndicator').hide();
                    $('#logsTable tbody').show();
                },
                error: function() {
                    alert('เกิดข้อผิดพลาดในการโหลดข้อมูล');
                    $('#loadingIndicator').hide();
                }
            });
        }

        function loadLogStats() {
            $.ajax({
                url: '@Url.Action("GetLogStats", "Admin")',
                method: 'GET',
                success: function(stats) {
                    $('#todayCount').text(stats.today);
                    $('#weekCount').text(stats.week);
                    $('#monthCount').text(stats.month);
                    $('#totalCount').text(stats.total);
                }
            });
        }

        function generatePagination(totalPages, currentPageNum) {
            let paginationHtml = '';
            
            paginationHtml += `
                <li class="page-item ${currentPageNum <= 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPageNum - 1})">ก่อนหน้า</a>
                </li>
            `;
            
            for (let i = 1; i <= totalPages; i++) {
                if (i <= 3 || i > totalPages - 3 || Math.abs(i - currentPageNum) <= 1) {
                    paginationHtml += `
                        <li class="page-item ${i === currentPageNum ? 'active' : ''}">
                            <a class="page-link" href="#" onclick="changePage(${i})">${i}</a>
                        </li>
                    `;
                } else if (i === 4 && currentPageNum > 5) {
                    paginationHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                } else if (i === totalPages - 3 && currentPageNum < totalPages - 4) {
                    paginationHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                }
            }
            
            paginationHtml += `
                <li class="page-item ${currentPageNum >= totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPageNum + 1})">ถัดไป</a>
                </li>
            `;
            
            $('#pagination').html(paginationHtml);
        }

        function changePage(page) {
            currentPage = page;
            loadLogs();
        }

        function getRoleName(roleID) {
            switch(roleID) {
                case 1: return 'เภสัช';
                case 2: return 'หัวหน้าเภสัช';
                case 3: return 'ผู้ดูแลระบบ';
                default: return 'ไม่ระบุ';
            }
        }

        function refreshLogs() {
            currentPage = 1;
            loadLogs();
            loadLogStats();
        }

    </script>
}
