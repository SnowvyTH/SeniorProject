@{
    ViewData["Title"] = "จัดการคำนำหน้า";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="fas fa-id-badge me-2"></i>จัดการคำนำหน้าผู้ใช้</h4>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTitleModal">
            <i class="fas fa-plus me-2"></i>เพิ่มคำนำหน้าใหม่
        </button>
    </div>

    
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" id="searchTitle" class="form-control" placeholder="ค้นหาคำนำหน้า...">
            </div>
        </div>
    </div>

    
    <div class="table-responsive">
        <table class="table table-hover" id="titlesTable">
            <thead class="table-light">
                <tr>
                    <th width="100">รหัส</th>
                    <th>คำนำหน้า</th>
                    <th width="200">การจัดการ</th>
                </tr>
            </thead>
            <tbody id="titlesTableBody">
                
            </tbody>
        </table>
    </div>

    
    <div id="loadingIndicator" class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">กำลังโหลด...</span>
        </div>
    </div>

    
    <div class="d-flex justify-content-between align-items-center mt-4">
        <div id="paginationInfo" class="text-muted"></div>
        <nav>
            <ul class="pagination" id="titlesPagination"></ul>
        </nav>
    </div>
</div>


<div class="modal fade" id="addTitleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>เพิ่มคำนำหน้าใหม่</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addTitleForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">คำนำหน้า</label>
                        <input type="text" class="form-control" name="TitleName" required 
                               placeholder="เช่น นาย, นาง, นางสาว, ดร.">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success">เพิ่มคำนำหน้า</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div class="modal fade" id="editTitleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>แก้ไขคำนำหน้า</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editTitleForm">
                <input type="hidden" name="TitleID" id="editTitleID">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">คำนำหน้า</label>
                        <input type="text" class="form-control" name="TitleName" id="editTitleName" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success">บันทึกการเปลี่ยนแปลง</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        let currentPage = 1;
        const pageSize = 5;
        let allTitles = [];

        $(document).ready(function() {
            loadTitles();

            $('#searchTitle').on('keyup', function() {
                currentPage = 1;
                loadTitles();
            });

            $('#addTitleForm').on('submit', function(e) {
                e.preventDefault();
                addTitle();
            });

            $('#editTitleForm').on('submit', function(e) {
                e.preventDefault();
                updateTitle();
            });
        });

        function changeTitlePage(page) {
            currentPage = page;
            displayTitles();
        }

        function loadTitles() {
            $('#loadingIndicator').show();
            $('#titlesTable tbody').hide();

            const search = $('#searchTitle').val();

            $.ajax({
                url: '@Url.Action("GetTitles", "Admin")',
                method: 'GET',
                data: { search: search },
                success: function(data) {
                    allTitles = data;
                    displayTitles();
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการโหลดข้อมูล',
                        confirmButtonColor: '#51c3b7'
                    });
                    $('#loadingIndicator').hide();
                }
            });
        }

        function displayTitles() {
            const paginatedData = paginateData(allTitles, currentPage, pageSize);
            
            if (paginatedData.items.length === 0 && allTitles.length > 0) {
                currentPage = 1;
                displayTitles();
                return;
            }

            let html = '';
            paginatedData.items.forEach(function(title, index) {
                const rowNumber = ((currentPage - 1) * pageSize) + index + 1;
                html += `
                    <tr>
                        <td>${rowNumber}</td>
                        <td>${title.titleName}</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" onclick="editTitle(${title.titleID}, '${title.titleName}')">
                                <i class="fas fa-edit"></i> แก้ไข
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteTitle(${title.titleID}, '${title.titleName}')">
                                <i class="fas fa-trash"></i> ลบ
                            </button>
                        </td>
                    </tr>
                `;
            });
            
            $('#titlesTableBody').html(html);
            $('#loadingIndicator').hide();
            $('#titlesTable tbody').show();

            generatePagination(paginatedData.totalPages, currentPage, 'titlesPagination', 'changeTitlePage');
            updatePaginationInfo(currentPage, pageSize, paginatedData.totalItems, 'paginationInfo');
        }

        function addTitle() {
            const formData = new FormData($('#addTitleForm')[0]);
            
            $.ajax({
                url: '@Url.Action("CreateTitle", "Admin")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if(response.success) {
                        $('#addTitleModal').modal('hide');
                        $('#addTitleForm')[0].reset();
                        loadTitles();
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: 'เพิ่มคำนำหน้าสำเร็จ',
                            confirmButtonColor: '#51c3b7'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'เกิดข้อผิดพลาด: ' + response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการเพิ่มคำนำหน้า',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function editTitle(titleID, titleName) {
            $('#editTitleID').val(titleID);
            $('#editTitleName').val(titleName);
            $('#editTitleModal').modal('show');
        }

        function updateTitle() {
            const formData = new FormData($('#editTitleForm')[0]);
            
            $.ajax({
                url: '@Url.Action("UpdateTitle", "Admin")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if(response.success) {
                        $('#editTitleModal').modal('hide');
                        loadTitles();
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: 'อัปเดตข้อมูลคำนำหน้าสำเร็จ',
                            confirmButtonColor: '#51c3b7'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'เกิดข้อผิดพลาด: ' + response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการอัปเดตข้อมูล',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function deleteTitle(titleID, titleName) {
            Swal.fire({
                title: 'ยืนยันการดำเนินการ',
                text: `คุณต้องการลบคำนำหน้า ${titleName} หรือไม่?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#51c3b7',
                cancelButtonColor: '#d33',
                confirmButtonText: 'ใช่, ดำเนินการ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteTitle", "Admin")',
                        method: 'POST',
                        data: { titleID: titleID },
                        success: function(response) {
                            if(response.success) {
                                loadTitles();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'สำเร็จ',
                                    text: 'ลบคำนำหน้าสำเร็จ',
                                    confirmButtonColor: '#51c3b7'
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: 'เกิดข้อผิดพลาด: ' + response.message,
                                    confirmButtonColor: '#51c3b7'
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: 'เกิดข้อผิดพลาดในการลบข้อมูล',
                                confirmButtonColor: '#51c3b7'
                            });
                        }
                    });
                }
            });
        }
    </script>
}
