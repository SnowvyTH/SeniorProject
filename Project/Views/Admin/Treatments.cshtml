@{
    ViewData["Title"] = "จัดการสิทธิ์การรักษา";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="fas fa-user-md me-2"></i>จัดการสิทธิ์การรักษา</h4>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTreatmentModal">
            <i class="fas fa-plus me-2"></i>เพิ่มสิทธิ์การรักษาใหม่
        </button>
    </div>

    <!-- Search -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" id="searchTreatment" class="form-control" placeholder="ค้นหาสิทธิ์การรักษา...">
            </div>
        </div>
    </div>

    <!-- Treatments Table -->
    <div class="table-responsive">
        <table class="table table-hover" id="treatmentsTable">
            <thead class="table-light">
                <tr>
                    <th width="100">รหัส</th>
                    <th>ชื่อสิทธิ์การรักษา</th>
                    <th width="200">การจัดการ</th>
                </tr>
            </thead>
            <tbody id="treatmentsTableBody">
                <!-- Data will be loaded via AJAX -->
            </tbody>
        </table>
    </div>

    <!-- Loading indicator -->
    <div id="loadingIndicator" class="text-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">กำลังโหลด...</span>
        </div>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div id="paginationInfo" class="text-muted"></div>
        <nav aria-label="Page navigation">
            <ul class="pagination" id="treatmentsPagination"></ul>
        </nav>
    </div>
</div>

<!-- Add Treatment Modal -->
<div class="modal fade" id="addTreatmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>เพิ่มสิทธิ์การรักษาใหม่</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addTreatmentForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">ชื่อสิทธิ์การรักษา</label>
                        <input type="text" class="form-control" name="TreatmentName" required 
                               placeholder="เช่น ประกันสังคม, ข้าราชการ, จ่ายเอง">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success">เพิ่มสิทธิ์การรักษา</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Treatment Modal -->
<div class="modal fade" id="editTreatmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>แก้ไขสิทธิ์การรักษา</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editTreatmentForm">
                <input type="hidden" name="TreatmentID" id="editTreatmentID">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">ชื่อสิทธิ์การรักษา</label>
                        <input type="text" class="form-control" name="TreatmentName" id="editTreatmentName" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-success">บันทึกการเปลี่ยนแปลง</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        let currentPage = 1;
        const pageSize = 5;
        let allTreatments = [];

        $(document).ready(function() {
            loadTreatments();

            // Search functionality
            $('#searchTreatment').on('keyup', function() {
                currentPage = 1;
                loadTreatments();
            });

            // Add treatment form
            $('#addTreatmentForm').on('submit', function(e) {
                e.preventDefault();
                addTreatment();
            });

            // Edit treatment form
            $('#editTreatmentForm').on('submit', function(e) {
                e.preventDefault();
                updateTreatment();
            });
        });

        function loadTreatments() {
            $('#loadingIndicator').show();
            $('#treatmentsTable tbody').hide();

            const search = $('#searchTreatment').val();

            $.ajax({
                url: '@Url.Action("GetTreatments", "Admin")',
                method: 'GET',
                data: { search: search },
                success: function(data) {
                    allTreatments = data;
                    displayTreatments();
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการโหลดข้อมูล',
                        confirmButtonColor: '#51c3b7'
                    });
                    $('#loadingIndicator').hide();
                }
            });
        }

        function displayTreatments() {
            const paginatedData = paginateData(allTreatments, currentPage, pageSize);
            let html = '';
            
            paginatedData.items.forEach(function(treatment, index) {
                const rowNumber = ((currentPage - 1) * pageSize) + index + 1;
                html += `
                    <tr>
                        <td>${rowNumber}</td>
                        <td>${treatment.treatmentName}</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" onclick="editTreatment(${treatment.treatmentID}, '${treatment.treatmentName}')">
                                <i class="fas fa-edit"></i> แก้ไข
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deleteTreatment(${treatment.treatmentID}, '${treatment.treatmentName}')">
                                <i class="fas fa-trash"></i> ลบ
                            </button>
                        </td>
                    </tr>
                `;
            });
            
            $('#treatmentsTableBody').html(html);
            $('#loadingIndicator').hide();
            $('#treatmentsTable tbody').show();
            
            // อัพเดท pagination
            generatePagination(paginatedData.totalPages, currentPage, 'treatmentsPagination', 'changeTreatmentPage');
            updatePaginationInfo(currentPage, pageSize, paginatedData.totalItems, 'paginationInfo');
        }

        function changeTreatmentPage(page) {
            currentPage = page;
            displayTreatments();
        }

        function addTreatment() {
            const formData = new FormData($('#addTreatmentForm')[0]);
            
            $.ajax({
                url: '@Url.Action("CreateTreatment", "Admin")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if(response.success) {
                        $('#addTreatmentModal').modal('hide');
                        $('#addTreatmentForm')[0].reset();
                        currentPage = 1;
                        loadTreatments();
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: 'เพิ่มสิทธิ์การรักษาสำเร็จ',
                            confirmButtonColor: '#51c3b7'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'เกิดข้อผิดพลาด: ' + response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการเพิ่มสิทธิ์การรักษา',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function editTreatment(treatmentID, treatmentName) {
            $('#editTreatmentID').val(treatmentID);
            $('#editTreatmentName').val(treatmentName);
            $('#editTreatmentModal').modal('show');
        }

        function updateTreatment() {
            const formData = new FormData($('#editTreatmentForm')[0]);
            
            $.ajax({
                url: '@Url.Action("UpdateTreatment", "Admin")',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if(response.success) {
                        $('#editTreatmentModal').modal('hide');
                        loadTreatments();
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ',
                            text: 'อัปเดตข้อมูลสิทธิ์การรักษาสำเร็จ',
                            confirmButtonColor: '#51c3b7'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'เกิดข้อผิดพลาด: ' + response.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการอัปเดตข้อมูล',
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }

        function deleteTreatment(treatmentID, treatmentName) {
            Swal.fire({
                title: 'ยืนยันการดำเนินการ',
                text: `คุณต้องการลบสิทธิ์การรักษา ${treatmentName} หรือไม่?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#51c3b7',
                cancelButtonColor: '#d33',
                confirmButtonText: 'ใช่, ดำเนินการ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeleteTreatment", "Admin")',
                        method: 'POST',
                        data: { treatmentID: treatmentID },
                        success: function(response) {
                            if(response.success) {
                                loadTreatments();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'สำเร็จ',
                                    text: 'ลบสิทธิ์การรักษาสำเร็จ',
                                    confirmButtonColor: '#51c3b7'
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: 'เกิดข้อผิดพลาด: ' + response.message,
                                    confirmButtonColor: '#51c3b7'
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: 'เกิดข้อผิดพลาดในการลบข้อมูล',
                                confirmButtonColor: '#51c3b7'
                            });
                        }
                    });
                }
            });
        }
    </script>
}
