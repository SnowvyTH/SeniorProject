@{
    ViewData["Title"] = "หน้าหลัก";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>
                    <i class="fas fa-tachometer-alt me-2"></i>หน้าหลัก
                </h2>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user me-1"></i>@ViewBag.UserName
                    </button>
                    <ul class="dropdown-menu">
                        <li><span class="dropdown-item-text">บทบาท: @ViewBag.RoleName</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="@Url.Action("Logout", "Home")">
                            <i class="fas fa-sign-out-alt me-1"></i>ออกจากระบบ
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">ผู้ป่วย</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="#" class="text-white text-decoration-none">
                        <small>ดูรายละเอียด <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">แบบประเมิน</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-clipboard-list fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="#" class="text-white text-decoration-none">
                        <small>ดูรายละเอียด <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">การประเมิน</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-chart-line fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="#" class="text-white text-decoration-none">
                        <small>ดูรายละเอียด <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">ผู้ใช้งาน</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-user-cog fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a href="#" class="text-white text-decoration-none">
                        <small>ดูรายละเอียด <i class="fas fa-arrow-right"></i></small>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>สถิติการใช้งาน
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-chart-bar fa-3x mb-3"></i>
                        <p>กราฟแสดงสถิติการใช้งานระบบ</p>
                        <small>จะแสดงข้อมูลเมื่อมีการใช้งานระบบ</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>กิจกรรมล่าสุด
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-history fa-2x mb-3"></i>
                        <p>ไม่มีกิจกรรมล่าสุด</p>
                        <small>กิจกรรมจะแสดงที่นี่เมื่อมีการใช้งาน</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // สามารถเพิ่ม JavaScript สำหรับ Dashboard ได้ที่นี่
            console.log('Dashboard loaded successfully');
        });
    </script>
}
