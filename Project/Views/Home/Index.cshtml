@model Project.Models.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                <div class="card login-card shadow-lg">
                    <div class="card-header text-white text-center">
                        <h4 class="mb-0">
                            <i class="fas fa-sign-in-alt me-2"></i>เข้าสู่ระบบ
                        </h4>
                        <small class="d-block mt-1">ระบบจัดการข้อมูลผู้ป่วยและแบบประเมิน</small>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Index" asp-controller="Home" method="post" class="login-form">
                            <div asp-validation-summary="All" class="alert alert-danger" style="display: none;"></div>
                            
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label fw-bold">
                                    <i class="fas fa-user me-1 text-primary"></i>@Html.DisplayNameFor(m => m.Username)
                                </label>
                        <input asp-for="Username" class="form-control" placeholder="กรอกชื่อผู้ใช้" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            <i class="fas fa-lock me-1"></i>@Html.DisplayNameFor(m => m.Password)
                        </label>
                        <input asp-for="Password" class="form-control" placeholder="กรอกรหัสผ่าน" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>เข้าสู่ระบบ
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer text-center text-muted">
                <small>ระบบจัดการข้อมูลผู้ป่วยและแบบประเมิน</small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            // แสดง validation summary เมื่อมี error
            if ($('.validation-summary-errors').length > 0) {
                $('.alert-danger').show();
            }
            
            // Focus ที่ Username field
            $('#Username').focus();
        });
    </script>
}
