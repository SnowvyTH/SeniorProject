@model Project.Models.LoginViewModel
@{
    ViewData["Title"] = "ระบบประเมินผู้ป่วย";
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="/img/logo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --mint-green: #51c3b7;
            --dark-green: #05685e;
            --dark-gray: #545454;
            --light-gray: #737373;
            --white: #ffffff;
            --light-mint: #e8f7f5;
            --shadow: rgba(0, 0, 0, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Kanit', sans-serif;
            background-image: 
                linear-gradient(135deg, rgba(232, 247, 245, 0.85) 0%, rgba(81, 195, 183, 0.75) 50%, rgba(5, 104, 94, 0.8) 100%),
                url('/img/background.avif');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(232, 247, 245, 0.3);
            backdrop-filter: blur(2px);
            z-index: -1;
        }

        .login-container {
            width: 100%;
            max-width: 500px;
            padding: 2rem;
        }

        .brand-logo {
            text-align: center;
            margin-bottom: 2.5rem;
            animation: fadeInDown 0.8s ease-out;
        }

        .logo-icon {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--mint-green), var(--dark-green));
            border-radius: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            box-shadow: 0 10px 30px rgba(81, 195, 183, 0.3);
        }

        .logo-icon i {
            font-size: 2.5rem;
            color: white;
        }

        .brand-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--dark-green);
            margin-bottom: 0.5rem;
        }

        .brand-subtitle {
            font-size: 0.95rem;
            color: var(--light-gray);
        }

        .login-card {
            background: var(--white);
            border-radius: 18px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(81, 195, 183, 0.1);
            padding: 2.5rem;
            animation: fadeInUp 0.8s ease-out;
        }

        .login-header h2 {
            font-size: 1.75rem;
            font-weight: 600;
            color: var(--dark-gray);
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .login-subtitle {
            text-align: center;
            color: var(--light-gray);
            font-size: 0.95rem;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
            position: relative;
        }

        .form-label {
            font-weight: 500;
            color: var(--dark-gray);
            margin-bottom: 0.5rem;
            display: block;
        }

        .form-label i {
            color: var(--mint-green);
            margin-right: 0.5rem;
        }

        .form-control {
            border: 2px solid #e8f0fe;
            border-radius: 12px;
            padding: 0.875rem 1rem;
            font-size: 1rem;
            transition: all 0.3s ease;
            background: #fafbfc;
        }

        .form-control:focus {
            border-color: var(--mint-green);
            box-shadow: 0 0 0 0.2rem rgba(81, 195, 183, 0.15);
            background: white;
            outline: none;
        }

        .form-control::placeholder {
            color: #a0a0a0;
            font-size: 0.95rem;
        }

        .remember-forgot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .form-check {
            display: flex;
            align-items: center;
        }

        .form-check-input {
            margin-right: 0.5rem;
            border-radius: 6px;
            border: 2px solid #e8f0fe;
        }

        .form-check-input:checked {
            background-color: var(--mint-green);
            border-color: var(--mint-green);
        }

        .form-check-label {
            color: var(--dark-gray);
            font-size: 0.9rem;
            margin: 0;
        }

        .forgot-link {
            color: var(--light-gray);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
        }

        .forgot-link:hover {
            color: var(--mint-green);
        }

        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, var(--mint-green), var(--dark-green));
            border: none;
            border-radius: 12px;
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
            margin-bottom: 1.5rem;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(81, 195, 183, 0.3);
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .divider {
            text-align: center;
            margin: 1.5rem 0;
            position: relative;
        }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #e8f0fe;
        }

        .divider span {
            background: white;
            padding: 0 1rem;
            color: var(--light-gray);
            font-size: 0.9rem;
        }

        .footer-text {
            text-align: center;
            color: var(--light-gray);
            font-size: 0.9rem;
            margin-top: 1rem;
        }

        .alert-danger {
            border-radius: 12px;
            border: 1px solid #ff6b6b;
            background: #fff5f5;
            color: #c53030;
            margin-bottom: 1.5rem;
        }

        .text-danger {
            font-size: 0.85rem;
            margin-top: 0.25rem;
        }

        @@keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .login-container {
                padding: 1rem;
            }
            
            .login-card {
                padding: 2rem;
            }
            
            .brand-logo {
                margin-bottom: 2rem;
            }
        }

        .toast-notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: white;
            padding: 16px 24px;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 9999;
            animation: slideInRight 0.3s ease-out, fadeOut 0.3s ease-out 2.7s;
            min-width: 300px;
            border-left: 4px solid;
        }

        .toast-notification.success {
            border-left-color: #10b981;
        }

        .toast-notification.error {
            border-left-color: #ef4444;
        }

        .toast-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .toast-notification.success .toast-icon {
            background: #d1fae5;
            color: #10b981;
        }

        .toast-notification.error .toast-icon {
            background: #fee2e2;
            color: #ef4444;
        }

        .toast-content {
            flex: 1;
        }

        .toast-title {
            font-weight: 600;
            font-size: 14px;
            margin: 0;
            color: #1f2937;
        }

        @@keyframes slideInRight {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes fadeOut {
            from {
                opacity: 1;
            }
            to {
                opacity: 0;
                transform: translateX(400px);
            }
        }
    </style>
</head>
<body>
    <div class="login-container">
        
        <div class="login-card">
            <div class="login-header">
                
                <div class="brand-logo">
                    <div class="logo-icon">
                        <img src="/img/logo.png" width="95px" style="padding-left: 2px;" />
                    </div>
                    <div class="brand-title">ระบบประเมินผู้ป่วย</div>
                    <div class="brand-subtitle">Assessment Management System</div>
                </div>
            </div>

            <form asp-action="Index" asp-controller="Home" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" style="display: none;"></div>
                
                <div class="form-group">
                    <label asp-for="Username" class="form-label">
                        <i class="fas fa-user"></i>Username
                    </label>
                    <input asp-for="Username" class="form-control" placeholder="กรอกชื่อผู้ใช้งาน" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">
                        <i class="fas fa-lock"></i>Password
                    </label>
                    <input asp-for="Password" class="form-control" placeholder="กรอกรหัสผ่าน" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="remember-forgot">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label">
                            จดจำการเข้าสู่ระบบ
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-login" id="loginBtn">
                    <i class="fas fa-sign-in-alt me-2"></i>Log In
                </button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function showToast(type, message) {
            const existingToast = document.querySelector('.toast-notification');
            if (existingToast) {
                existingToast.remove();
            }

            const toast = document.createElement('div');
            toast.className = `toast-notification ${type}`;
            
            const icon = type === 'success' ? '✓' : '✕';
            
            toast.innerHTML = `
                <div class="toast-icon">
                    <span>${icon}</span>
                </div>
                <div class="toast-content">
                    <p class="toast-title">${message}</p>
                </div>
            `;
            
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        $(document).ready(function() {
            let isSubmitting = false;

            if ($('.validation-summary-errors').length > 0 || $('.field-validation-error').length > 0) {
                var errorMessages = [];
                $('.validation-summary-errors li').each(function() {
                    errorMessages.push($(this).text());
                });
                $('.field-validation-error').each(function() {
                    if ($(this).text().trim()) {
                        errorMessages.push($(this).text());
                    }
                });
                
                if (errorMessages.length > 0) {
                    showToast('error', 'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');
                }
            }
            
            $('#Username').focus();

            $('form').on('submit', function(e) {
                e.preventDefault();
                
                if (isSubmitting) {
                    return false;
                }
                
                var $form = $(this);
                var $btn = $('.btn-login');
                var username = $('#Username').val().trim();
                var password = $('#Password').val().trim();
                
                if (!username || !password) {
                    showToast('error', 'กรุณากรอกชื่อผู้ใช้และรหัสผ่าน');
                    return false;
                }
                
                isSubmitting = true;
                $btn.html('<i class="fas fa-spinner fa-spin me-2"></i>กำลังเข้าสู่ระบบ...');
                $btn.prop('disabled', true);
                
                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: $form.serialize(),
                    timeout: 10000, 
                    success: function(response) {
                        if (response.success === false) {
                            isSubmitting = false;
                            $btn.html('<i class="fas fa-sign-in-alt me-2"></i>Log In');
                            $btn.prop('disabled', false);
                            
                            showToast('error', 'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');
                        } else {
                            showToast('success', 'เข้าสู่ระบบสำเร็จ');
                            
                            setTimeout(() => {
                                if (response.redirectUrl) {
                                    window.location.href = response.redirectUrl;
                                } else {
                                    $form.off('submit').submit();
                                }
                            }, 800);
                        }
                    },
                    error: function(xhr, status, error) {
                        isSubmitting = false;
                        $btn.html('<i class="fas fa-sign-in-alt me-2"></i>Log In');
                        $btn.prop('disabled', false);
                        
                        if (status === 'timeout') {
                            showToast('error', 'การเชื่อมต่อล่าช้า กรุณาลองใหม่');
                        } else if (xhr.status === 400 || xhr.status === 401) {
                            showToast('error', 'ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');
                        } else {
                            showToast('error', 'ไม่สามารถเข้าสู่ระบบได้ในขณะนี้');
                        }
                    }
                });
            });

            $('.form-control').on('focus', function() {
                $(this).parent().addClass('focused');
            }).on('blur', function() {
                $(this).parent().removeClass('focused');
            });
            
            $('.form-control').on('input', function() {
                $(this).siblings('.text-danger').text('');
                $('.alert-danger').hide();
            });
        });

    </script>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            if ($('.validation-summary-errors').length > 0) {
                $('.alert-danger').show();
            }
            
            $('#Username').focus();
        });
    </script>
}