@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        let currentIndexPage = 1;
        const indexPageSize = 5;
        let allIndexPatients = [];

        $(document).ready(function() {
            loadIndexPatients();
            setupIndexFilters();
        });

        function setupIndexFilters() {
            $('#searchInput').on('input', function() {
                currentIndexPage = 1;
                loadIndexPatients();
            });
            $('#patientTypeFilter, #evaluationFilter').on('change', function() {
                currentIndexPage = 1;
                loadIndexPatients();
            });
        }

        function loadIndexPatients() {
            $('#loadingSpinner').show();
            $('#noDataMessage').hide();
            
            const searchQuery = $('#searchInput').val().toLowerCase();
            const patientTypeFilter = $('#patientTypeFilter').val();
            const evaluationFilter = $('#evaluationFilter').val();

            if (allIndexPatients.length === 0) {
                $('.patient-row').each(function() {
                    const row = $(this);
                    allIndexPatients.push({
                        element: row.clone(),
                        hn: row.data('hn') ? row.data('hn').toString() : '',
                        name: row.find('td:eq(1)').text().trim(),
                        patientType: row.data('type') ? row.data('type').toString() : '',
                        hasEvaluations: row.data('evaluated') === 'true' || row.data('evaluated') === true
                    });
                });
            }

            const filteredPatients = allIndexPatients.filter(function(patient) {
                const matchesSearch = searchQuery === '' || 
                    patient.hn.toLowerCase().includes(searchQuery) || 
                    patient.name.toLowerCase().includes(searchQuery);
                const matchesType = !patientTypeFilter || patient.patientType === patientTypeFilter;
                const matchesEvaluation = !evaluationFilter || 
                    (evaluationFilter === 'with' && patient.hasEvaluations) ||
                    (evaluationFilter === 'without' && !patient.hasEvaluations);
                
                return matchesSearch && matchesType && matchesEvaluation;
            });

            displayIndexPatients(filteredPatients);
            $('#loadingSpinner').hide();
        }

        function displayIndexPatients(patients) {
            const paginatedData = paginateData(patients, currentIndexPage, indexPageSize);
            const tbody = $('#patientsTable tbody');
            tbody.empty();

            if (paginatedData.items.length === 0) {
                document.getElementById('indexPagination').innerHTML = '';
                $('#noDataMessage').show();
                $('#indexPagination').parent().hide();
                $('#indexPaginationInfo').text('');
                $('#patientsTable tbody').hide();
                return;
            }
            
            $('#noDataMessage').hide();
            $('#indexPagination').parent().show();
            $('#patientsTable tbody').addClass('loaded').show();
            
            paginatedData.items.forEach(function(patient, index) {
                const rowNumber = ((currentIndexPage - 1) * indexPageSize) + index + 1;
                const newRow = patient.element.clone();
                newRow.find('td:first').text(rowNumber);
                tbody.append(newRow);
            });
            
            generatePagination(paginatedData.totalPages, currentIndexPage, 'indexPagination', 'changeIndexPage');
            updatePaginationInfo(currentIndexPage, indexPageSize, paginatedData.totalItems, 'indexPaginationInfo');
        }

        function changeIndexPage(page) {
            currentIndexPage = page;
            displayIndexPatients(allIndexPatients);
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#patientTypeFilter').val('');
            $('#evaluationFilter').val('');
            loadIndexPatients();
        }
            $('.dropdown').on('show.bs.dropdown', function () {
                $('.dropdown').not(this).each(function() {
                    $(this).find('.dropdown-toggle').dropdown('hide');
                });
                
                const dropdown = $(this);
                const dropdownMenu = dropdown.find('.dropdown-menu');
                const dropdownToggle = dropdown.find('.dropdown-toggle');
                
                const buttonOffset = dropdownToggle.offset();
                const buttonHeight = dropdownToggle.outerHeight();
                
                dropdownMenu.css({
                    'position': 'fixed',
                    'left': buttonOffset.left + 'px',
                    'display': 'block'
                });
            });

            $('.dropdown').on('hide.bs.dropdown', function () {
                const dropdown = $(this);
                const dropdownMenu = dropdown.find('.dropdown-menu');
                
                dropdownMenu.css({
                    'position': '',
                    'top': '',
                    'left': '',
                    'display': ''
                });
            });

            $(window).on('scroll', function() {
                $('.dropdown-menu.show').each(function() {
                    const dropdown = $(this).closest('.dropdown');
                    dropdown.find('.dropdown-toggle').dropdown('hide');
                });
            });

            $('.table-responsive').on('scroll', function() {
                $('.dropdown-menu.show').each(function() {
                    const dropdown = $(this).closest('.dropdown');
                    dropdown.find('.dropdown-toggle').dropdown('hide');
                });
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown-menu.show').each(function() {
                        const dropdown = $(this).closest('.dropdown');
                        dropdown.find('.dropdown-toggle').dropdown('hide');
                    });
                }
            });
            
            $('.dropdown').on('show.bs.dropdown', function () {
                const dropdown = $(this);
                const menu = dropdown.find('.dropdown-menu');
                
                menu.removeClass('dropdown-menu-end dropdown-menu-start');
                menu.css({
                    'position': 'absolute',
                    'inset': 'auto',
                    'margin': '0',
                    'transform': 'none'
                });
                
                setTimeout(function() {
                    const rect = dropdown[0].getBoundingClientRect();
                    const menuRect = menu[0].getBoundingClientRect();
                    const viewportWidth = window.innerWidth;
                    
                    if (rect.right + menuRect.width > viewportWidth) {
                        menu.addClass('dropdown-menu-end');
                    }
                }, 10);
            });

            $('.dropdown').on('hide.bs.dropdown', function () {
                const menu = $(this).find('.dropdown-menu');
                menu.css({
                    'position': '',
                    'inset': '',
                    'margin': '',
                    'transform': ''
                });
            });
            
        function selectEvaluation(recordId, result, patientHN) {
            let severityClass = '';
            let severityIcon = '';
            
            if(result.includes('รุนแรง') || result.includes('Severe')) {
                severityClass = 'badge-critical';
                severityIcon = 'fas fa-exclamation-triangle';
            }
            else if(result.includes('Moderate') || result.includes('ปานกลาง')) {
                severityClass = 'badge-high-risk';
                severityIcon = 'fas fa-exclamation-circle';
            }
            else if(result.includes('Mild') || result.includes('เล็กน้อย')) {
                severityClass = 'badge-low-risk';
                severityIcon = 'fas fa-info-circle';
            }
            else {
                severityClass = 'badge-safe';
                severityIcon = 'fas fa-check-circle';
            }

            const severityDisplay = $(`#severity-${patientHN}`);
            severityDisplay.html(`<span class="badge ${severityClass}"><i class="${severityIcon} me-1"></i>${result}</span>`);
            severityDisplay.attr('data-selected-evaluation-id', recordId);
            
            const clickedItem = $(`.evaluation-item[onclick*="${recordId}"]`);
            let formName = clickedItem.find('.fw-bold').text();
            formName = formName.replace(' (ล่าสุด)', '').replace('(ล่าสุด)', '').trim();
            const recordDate = clickedItem.find('.small.text-muted').text().split(' ')[0]; 
            
            const dropdownButton = clickedItem.closest('.dropdown').find('.dropdown-toggle');
            dropdownButton.html(`
                <div class="d-flex align-items-center flex-grow-1">
                    <i class="fas fa-file-medical text-primary me-2"></i>
                    <span class="fw-bold text-dark me-2">${formName}</span>
                    <span class="text-muted">${recordDate}</span>
                </div>
            `);
            
            $('.dropdown').each(function() {
                $(this).find('.dropdown-toggle').dropdown('hide');
            });
        }

        function viewEvaluationDetail(patientHN) {
            const severityDisplay = $(`#severity-${patientHN}`);
            let recordId = severityDisplay.attr('data-selected-evaluation-id');
            
            if (!recordId) {
                const latestEvaluationItem = $(`.evaluation-item[data-patient-hn="${patientHN}"]`).first();
                recordId = latestEvaluationItem.data('record-id');
            }
            
            if (recordId) {
                window.location.href = `/Pharma/EvaluationDetail?evaId=${recordId}`;
            } else {
                alert('ไม่พบข้อมูลการประเมิน');
            }
        }

        function printEvaluation(patientHN) {
            const severityDisplay = $(`#severity-${patientHN}`);
            let recordId = severityDisplay.attr('data-selected-evaluation-id');
            
            if (!recordId) {
                const latestEvaluationItem = $(`.evaluation-item[data-patient-hn="${patientHN}"]`).first();
                recordId = latestEvaluationItem.data('record-id');
            }
            
            if (recordId) {
                Swal.fire({
                    title: 'กำลังสร้าง PDF...',
                    text: 'กรุณารอสักครู่',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                window.open(`/Pharma/ExportEvaluationPDF?evaId=${recordId}`, '_blank');
                
                setTimeout(() => {
                    Swal.close();
                }, 2000);
            } else {
                Swal.fire({
                    icon: 'warning',
                    title: 'ไม่พบข้อมูลการประเมิน',
                    text: 'กรุณาเลือกประวัติการประเมินที่ต้องการพิมพ์',
                    confirmButtonColor: '#51c3b7'
                });
            }
        }
    </script>
}
