@{
    ViewData["Title"] = "ระบบเภสัชกรรม";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-primary">
                    <i class="fas fa-pills me-2"></i>ระบบเภสัชกรรม
                </h2>
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user me-1"></i>@ViewBag.UserName
                    </button>
                    <ul class="dropdown-menu">
                        <li><span class="dropdown-item-text">บทบาท: @ViewBag.RoleName</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="@Url.Action("Logout", "Home")">
                            <i class="fas fa-sign-out-alt me-1"></i>ออกจากระบบ
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">ผู้ป่วยวันนี้</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-user-injured fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>จำนวนผู้ป่วยที่ต้องประเมิน</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">แบบประเมิน</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-clipboard-check fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>แบบประเมินที่เสร็จสมบูรณ์</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">รอดำเนินการ</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-clock fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>การประเมินที่รอดำเนินการ</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">ยาที่แจกจ่าย</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-prescription-bottle-alt fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>จำนวนยาที่แจกจ่ายวันนี้</small>
                </div>
            </div>
        </div>
    </div>
</div>
