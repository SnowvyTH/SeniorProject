@model IEnumerable<Project.Models.Entity.Patient>
@{
    ViewData["Title"] = "ประวัติผู้ป่วย";
    Layout = "_PharmaLayout";
}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-history me-2 mt-4"></i>ประวัติการประเมิน
            </h2>
            <p class="text-muted mb-0">ดูและจัดการประวัติการประเมินของผู้ป่วย</p>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="modern-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">ค้นหาผู้ป่วย</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหา HN, ชื่อ, หรือนามสกุล...">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">ประเภทผู้ป่วย</label>
                    <select class="form-select" id="patientTypeFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                        <option value="WARD">ผู้ป่วยใน (WARD)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">สถานะการประเมิน</label>
                    <select class="form-select" id="evaluationFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="with">มีประวัติการประเมิน</option>
                        <option value="without">ไม่มีประวัติการประเมิน</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-2"></i>ล้าง
                    </button>
                </div>
            </div>
        </div>
    </div>



    <!-- Patients Table -->
    <div class="modern-card">
        <div class="card-body p-0">
            <div class="table-responsive mt-4" style="overflow: visible;">
                <table class="table table-hover mb-0" id="patientsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="25%">ชื่อผู้ป่วย</th>
                            <th width="12%">ประเภทผู้ป่วย</th>
                            <th width="25%">ประวัติการตรวจ</th>
                            <th width="15%">ความรุนแรง</th>
                            <th width="13%">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="patientsTableBody">
                        @foreach (var patient in Model)
                        {
                            <tr class="patient-row" data-hn="@patient.HN" data-name="@(patient.Title?.TitleName) @patient.FirstName @patient.LastName" data-type="@patient.PatientType" data-evaluated="@(patient.Evaluations.Any() ? "true" : "false")">
                                
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            <i class="fas fa-user-injured"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@(patient.Title?.TitleName) @patient.FirstName @patient.LastName</div>
                                                <small class="text-muted">@patient.HN</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(patient.PatientType == "OPD" ? "bg-primary" : "bg-success") mx-4">
                                        @patient.PatientType
                                    </span>
                                </td>
                                <td>
                                    @if (patient.Evaluations.Any())
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                @(patient.Evaluations.OrderByDescending(r => r.RecordDate).First().Form?.FormName) - @(patient.Evaluations.OrderByDescending(r => r.RecordDate).First().RecordDate.ToString("dd/MM/yyyy"))
                                            </button>
                                            <ul class="dropdown-menu">
                                                @foreach (var record in patient.Evaluations.OrderByDescending(r => r.RecordDate))
                                                {
                                                    <li><a class="dropdown-item evaluation-item" href="#" data-record-id="@record.EvaID" data-result="@record.Result" data-patient-hn="@patient.HN">
                                                            <i class="fas fa-file-alt me-2"></i>@(record.Form?.FormName) - @(record.RecordDate.ToString("dd/MM/yyyy"))
                                                        </a></li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted mx-3">
                                            <i class="fas fa-minus-circle me-1"></i>ไม่มีข้อมูล
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (patient.Evaluations.Any())
                                    {
                                        var latestEvaluation = patient.Evaluations.OrderByDescending(r => r.RecordDate).First();
                                        <div class="severity-display mx-1" id="severity-@patient.HN" data-selected-evaluation-id="@latestEvaluation.EvaID">
                                            <span class="badge bg-warning">@(latestEvaluation.Result ?? "ไม่ระบุ")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted mx-lg-4">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons mx-2">
                                        <a type="button" class="btn btn-sm btn-outline-info mx-1" href="@Url.Action("ExportToPdf", "Pharma")" title="ดูรายละเอียดการประเมิน">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-success" onclick="printEvaluation('@patient.HN')" title="พิมพ์">
                                            <i class="fas fa-print"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลผู้ป่วย</h5>
                <p class="text-muted">ลองปรับเปลี่ยนเงื่อนไขการค้นหา</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --mint-green: #51c3b7;
            --dark-green: #05685e;
        }

        .card-primary {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
        }
        
        .card-success {
            background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
            color: white;
        }
        
        .card-info {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
            color: white;
        }
        
        .card-warning {
            background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
            color: white;
        }

        .stats-card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        .stats-number {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .stats-label {
            font-size: 0.9rem;
            margin: 0;
            opacity: 0.9;
        }

        .stats-icon {
            font-size: 2.5rem;
            opacity: 0.7;
        }

        .avatar-sm {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .avatar-xs {
            width: 30px;
            height: 30px;
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.8rem;
        }

        .action-buttons {
            display: flex;
            gap: 0.25rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }

        .patient-row.hidden {
            display: none;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
        }

        .table td {
            overflow: visible !important;
            position: relative;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .modern-card {
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border: none;
            overflow: visible !important;
        }

        .modern-card .card-header {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border-bottom: none;
            font-weight: 600;
            padding: 1rem 1.5rem;
        }

        .modern-card .card-body {
            padding: 1.5rem;
        }

        .btn {
            border-radius: 6px;
        }

        .form-control, .form-select {
            border-radius: 6px;
            border: 1px solid #e0e6ed;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--mint-green);
            box-shadow: 0 0 0 0.2rem rgba(81, 195, 183, 0.25);
        }

        .input-group-text {
            background-color: var(--mint-green);
            color: white;
            border: 1px solid var(--mint-green);
            border-radius: 6px 0 0 6px;
        }

        .input-group .form-control {
            border-radius: 0 6px 6px 0;
        }

        .badge {
            border-radius: 4px;
        }

        .dropdown-menu {
            border-radius: 6px;
            min-width: 280px;
            max-width: 350px;
            z-index: 1050 !important;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border: 1px solid rgba(0,0,0,.125);
            position: absolute !important;
            transform: none !important;
            inset: auto !important;
            margin: 0 !important;
        }

        .dropdown {
            position: static !important;
        }

        .table-responsive .dropdown-menu {
            position: absolute !important;
            will-change: transform;
        }

        .dropdown-menu.show {
            display: block;
            position: absolute !important;
            right: auto !important;
            bottom: auto !important;
        }

        .severity-display .badge {
            font-size: 0.85rem;
            padding: 0.5rem 0.8rem;
        }

        .evaluation-item:hover {
            background-color: #f8f9fa;
        }

        .evaluation-item {
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        /* Fix Bootstrap dropdown overflow issues */
        .table-responsive .table {
            position: static !important;
            overflow: visible !important;
        }

    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Fix dropdown positioning
            $('.dropdown').on('show.bs.dropdown', function () {
                // Close all other open dropdowns first
                $('.dropdown').not(this).each(function() {
                    $(this).find('.dropdown-toggle').dropdown('hide');
                });
                
                const dropdown = $(this);
                const dropdownMenu = dropdown.find('.dropdown-menu');
                const dropdownToggle = dropdown.find('.dropdown-toggle');
                
                // Get button position
                const buttonOffset = dropdownToggle.offset();
                const buttonHeight = dropdownToggle.outerHeight();
                
                // Position dropdown menu
                dropdownMenu.css({
                    'position': 'fixed',
                    'left': buttonOffset.left + 'px',
                    'display': 'block'
                });
            });

            $('.dropdown').on('hide.bs.dropdown', function () {
                const dropdown = $(this);
                const dropdownMenu = dropdown.find('.dropdown-menu');
                
                // Reset positioning
                dropdownMenu.css({
                    'position': '',
                    'top': '',
                    'left': '',
                    'display': ''
                });
            });

            // Close dropdown on scroll to prevent floating menu
            $(window).on('scroll', function() {
                $('.dropdown-menu.show').each(function() {
                    const dropdown = $(this).closest('.dropdown');
                    dropdown.find('.dropdown-toggle').dropdown('hide');
                });
            });

            // Close dropdown on table scroll
            $('.table-responsive').on('scroll', function() {
                $('.dropdown-menu.show').each(function() {
                    const dropdown = $(this).closest('.dropdown');
                    dropdown.find('.dropdown-toggle').dropdown('hide');
                });
            });

            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown-menu.show').each(function() {
                        const dropdown = $(this).closest('.dropdown');
                        dropdown.find('.dropdown-toggle').dropdown('hide');
                    });
                }
            });
            
            // Search and filter functionality
            function filterPatients() {
                const searchQuery = $('#searchInput').val().toLowerCase();
                const patientTypeFilter = $('#patientTypeFilter').val();
                const evaluationFilter = $('#evaluationFilter').val();
                
                let visibleCount = 0;
                
                $('.patient-row').each(function() {
                    const $row = $(this);
                    const hn = $row.data('hn').toString().toLowerCase();
                    const name = $row.data('name').toString().toLowerCase();
                    const patientType = $row.data('type').toString();
                    const hasEvaluation = $row.data('evaluated') === true || $row.data('evaluated') === 'true';
                    
                    let showRow = true;
                    
                    // Search filter (ค้นหา HN หรือชื่อ)
                    if (searchQuery && !hn.includes(searchQuery) && !name.includes(searchQuery)) {
                        showRow = false;
                    }
                    
                    // Patient type filter
                    if (patientTypeFilter && patientType !== patientTypeFilter) {
                        showRow = false;
                    }
                    
                    // Evaluation status filter
                    if (evaluationFilter) {
                        if (evaluationFilter === 'with' && !hasEvaluation) {
                            showRow = false;
                        } else if (evaluationFilter === 'without' && hasEvaluation) {
                            showRow = false;
                        }
                    }
                    
                    if (showRow) {
                        $row.show();
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });
                
                updateResultsCount(visibleCount);
                updateStatistics();
            }
            
            function updateResultsCount(visibleCount) {
                const totalRows = $('.patient-row').length;
                
                if (visibleCount !== totalRows) {
                    $('#resultsCount').html(`<small class="text-muted"><i class="fas fa-search me-1"></i>แสดง ${visibleCount} จาก ${totalRows} รายการ</small>`).show();
                    $('#noDataMessage').toggle(visibleCount === 0);
                } else {
                    $('#resultsCount').hide();
                    $('#noDataMessage').hide();
                }
            }
            
            function updateStatistics() {
                const visibleRows = $('.patient-row:visible');
                const totalVisible = visibleRows.length;
                const opdVisible = visibleRows.filter('[data-type="OPD"]').length;
                const wardVisible = visibleRows.filter('[data-type="WARD"]').length;
                const evaluatedVisible = visibleRows.filter('[data-evaluated="true"]').length;
                
                $('#totalPatients').text(totalVisible);
                $('#opdPatients').text(opdVisible);
                $('#wardPatients').text(wardVisible);
                $('#evaluatedPatients').text(evaluatedVisible);
                $('#patientsCount').text(totalVisible + ' รายการ');
            }
            
            // Event listeners
            $('#searchInput').on('input', filterPatients);
            $('#patientTypeFilter, #evaluationFilter').on('change', filterPatients);
            
            // Handle evaluation dropdown selection
            $(document).on('click', '.evaluation-item', function(e) {
                e.preventDefault();
                const recordId = $(this).data('record-id');
                const result = $(this).data('result');
                const patientHN = $(this).data('patient-hn');
                
                // Update severity display in real-time
                const severityDisplay = $(`#severity-${patientHN}`);
                severityDisplay.html(`<span class="badge bg-warning">${result || 'ไม่ระบุ'}</span>`);
                
                // Store the selected evaluation ID for this patient
                severityDisplay.attr('data-selected-evaluation-id', recordId);
                
                // Update dropdown button HTML (preserve icon)
                const dropdownButton = $(this).closest('.dropdown').find('.dropdown-toggle');
                const itemHtml = $(this).html(); // Get the full HTML content including icons
                dropdownButton.html(itemHtml);
                
                // Close dropdown
                $(this).closest('.dropdown-menu').removeClass('show');
                $(this).closest('.dropdown').find('.dropdown-toggle').removeClass('show');
            });
            
            // Initialize
            updateResultsCount($('.patient-row').length);
        });

        // Clear filters function (global scope)
        function clearFilters() {
            $('#searchInput').val('');
            $('#patientTypeFilter').val('');
            $('#evaluationFilter').val('');
            
            $('.patient-row').show();
            $('#resultsCount').hide();
            $('#noDataMessage').hide();
            
            // Reset statistics to original values
            $('#totalPatients').text(@Model.Count());
            $('#opdPatients').text(@Model.Where(p => p.PatientType == "OPD").Count());
            $('#wardPatients').text(@Model.Where(p => p.PatientType == "WARD").Count());
            $('#evaluatedPatients').text(@Model.Where(p => p.Evaluations.Any()).Count());
            $('#patientsCount').text('@Model.Count() รายการ');
        }

        function viewEvaluationDetail(patientHN) {
            // Get selected evaluation ID from severity display data attribute
            const severityDisplay = $(`#severity-${patientHN}`);
            let recordId = severityDisplay.attr('data-selected-evaluation-id');
            
            // If no specific evaluation selected, use the latest one
            if (!recordId) {
                const latestEvaluationItem = $(`.evaluation-item[data-patient-hn="${patientHN}"]`).first();
                recordId = latestEvaluationItem.data('record-id');
            }
            
            if (recordId) {
                // Navigate to evaluation detail page
                window.location.href = `/Pharma/EvaluationDetail?evaId=${recordId}`;
            } else {
                alert('ไม่พบข้อมูลการประเมิน');
            }
        }

        function printEvaluation(patientId) {
            // This would typically generate a PDF report
            alert('ฟีเจอร์การพิมพ์รายงาน - ผู้ป่วย ID: ' + patientId);
        }
    </script>
}
