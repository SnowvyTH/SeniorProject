@model IEnumerable<Project.Models.Entity.Patient>
@{
    ViewData["Title"] = "ประวัติการประเมิน";
    Layout = "_PharmaLayout";
}

<div class="container">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-history me-2 mt-4"></i>ประวัติการประเมิน
            </h2>
            <p class="text-muted mb-0">ดูและจัดการประวัติการประเมินของผู้ป่วย</p>
        </div>
    </div>

    
    <div class="modern-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label fw-bold">ค้นหาผู้ป่วย</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหา HN, ชื่อ, หรือนามสกุล...">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">ประเภทผู้ป่วย</label>
                    <select class="form-select" id="patientTypeFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                        <option value="WARD">ผู้ป่วยใน (WARD)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-2"></i>ล้าง
                    </button>
                </div>
            </div>
        </div>
    </div>



    
    <div class="modern-card">
        <div class="card-body p-0">
            <div class="table-responsive mt-4" style="overflow: visible;">
                <table class="table table-hover mb-0" id="patientsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="5%">ลำดับ</th>
                            <th width="28%">ชื่อผู้ป่วย</th>
                            <th width="8%">ประเภทผู้ป่วย</th>
                            <th width="22%">ประวัติการประเมิน</th>
                            <th width="14%">ความรุนแรง</th>
                            <th width="13%">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="patientsTableBody">
                        @{
                            int index = 1;
                        }
                        @foreach (var patient in Model)
                        {
                            <tr class="patient-row" data-hn="@patient.HN" data-name="@(patient.Title?.TitleName) @patient.FirstName @patient.LastName" data-type="@patient.PatientType" data-evaluated="@(patient.Evaluations.Any() ? "true" : "false")">
                                <td class="text-center">@index</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            <i class="fas fa-user-injured"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@(patient.Title?.TitleName) @patient.FirstName @patient.LastName</div>
                                                <small class="text-muted">@patient.HN</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge mt-2 @(patient.PatientType == "OPD" ? "mx-4 bg-primary bg-gradient" : "mx-4 bg-success bg-gradient")">
                                        @patient.PatientType
                                    </span>
                                </td>
                                <td>
                                    @if (patient.Evaluations.Any())
                                    {
                                        var latestRecord = patient.Evaluations.OrderByDescending(r => r.RecordDate).First();
                                        <div class="dropdown position-static">
                                            <button class="btn btn-light border dropdown-toggle text-start d-flex align-items-center justify-content-between" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 85%; min-width: 220px; height: 45px;">
                                                <div class="d-flex align-items-center flex-grow-1">
                                                    <i class="fas fa-file-medical text-primary me-2"></i>
                                                    <span class="fw-bold text-dark me-2">@(latestRecord.Form?.FormName ?? "ไม่ระบุแบบประเมิน")</span>
                                                    <span class="text-muted">@latestRecord.RecordDate.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </button>
                                            <ul class="dropdown-menu shadow-lg">
                                                <li><h6 class="dropdown-header"><i class="fas fa-list me-2"></i>ประวัติการประเมิน</h6></li>
                                                @{
                                                    var evaluationsList = patient.Evaluations.OrderByDescending(r => r.RecordDate).Take(5).ToList();
                                                }
                                                @for(int i = 0; i < evaluationsList.Count; i++)
                                                {
                                                    var record = evaluationsList[i];
                                                    var severityClass = "";
                                                    var severityIcon = "";
                                                    var resultText = record.Result ?? "ไม่ระบุ";
                                                    
                                                    // กำหนดสีและไอคอนตามความรุนแรง
                                                    if(resultText.Contains("รุนแรง") || resultText.Contains("Severe"))
                                                    {
                                                        severityClass = "badge-critical";
                                                        severityIcon = "fas fa-exclamation-triangle";
                                                    }
                                                    else if(resultText.Contains("Moderate") || resultText.Contains("ปานกลาง"))
                                                    {
                                                        severityClass = "badge-high-risk";
                                                        severityIcon = "fas fa-exclamation-circle";
                                                    }
                                                    else if(resultText.Contains("Mild") || resultText.Contains("เล็กน้อย"))
                                                    {
                                                        severityClass = "badge-low-risk";
                                                        severityIcon = "fas fa-info-circle";
                                                    }
                                                    else
                                                    {
                                                        severityClass = "badge-safe";
                                                        severityIcon = "fas fa-check-circle";
                                                    }
                                                    
                                                    <li>
                                                        <div class="dropdown-item-text evaluation-item p-2" style="cursor: pointer;" onclick="selectEvaluation('@record.EvaID', '@record.Result', '@patient.HN')">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <div class="flex-grow-1">
                                                                    <div class="fw-bold text-primary small">
                                                                        @record.Form?.FormName
                                                                        @if(i == 0)
                                                                        {
                                                                            <span class="text-success small fw-normal">(ล่าสุด)</span>
                                                                        }
                                                                    </div>
                                                                    <div class="small text-muted">@record.RecordDate.ToString("dd/MM/yyyy HH:mm")</div>
                                                                </div>
                                                                <div class="severity-display ms-2">
                                                                    <span class="badge @severityClass small">
                                                                        <i class="@severityIcon me-1"></i>@resultText
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                    @if(i < evaluationsList.Count - 1)
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="fas fa-info-circle me-1"></i>ยังไม่มีการประเมิน
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (patient.Evaluations.Any())
                                    {
                                        var latestEvaluation = patient.Evaluations.OrderByDescending(r => r.RecordDate).First();
                                        var severityClass = "";
                                        var severityIcon = "";
                                        var resultText = latestEvaluation.Result ?? "ไม่ระบุ";
                                        
                                        // กำหนดสีและไอคอนตามความรุนแรง
                                        if(resultText.Contains("รุนแรง") || resultText.Contains("Severe"))
                                        {
                                            severityClass = "badge-critical";
                                            severityIcon = "fas fa-exclamation-triangle";
                                        }
                                        else if(resultText.Contains("Moderate") || resultText.Contains("ปานกลาง"))
                                        {
                                            severityClass = "badge-high-risk";
                                            severityIcon = "fas fa-exclamation-circle";
                                        }
                                        else if(resultText.Contains("Mild") || resultText.Contains("เล็กน้อย"))
                                        {
                                            severityClass = "badge-low-risk";
                                            severityIcon = "fas fa-info-circle";
                                        }
                                        else
                                        {
                                            severityClass = "badge-safe";
                                            severityIcon = "fas fa-check-circle";
                                        }
                                        
                                        <div class="severity-display mx-1 mt-2" id="severity-@patient.HN" data-selected-evaluation-id="@latestEvaluation.EvaID">
                                            <span class="badge @severityClass">
                                                <i class="@severityIcon me-1"></i>@resultText
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted mx-lg-4">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons mt-2">
                                        <button type="button" class="btn btn-sm btn-info text-white mx-1" onclick="viewEvaluationDetail('@patient.HN')" title="ดูรายละเอียดการประเมิน">
                                            <i class="fas fa-eye"></i> รายละเอียด
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="printEvaluation('@patient.HN')" title="พิมพ์">
                                            <i class="fas fa-file-pdf"></i> PDF
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>           
            <div id="loadingSpinner" class="text-center p-4" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">กำลังโหลด...</span>
                </div>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลผู้ป่วย</h5>
                <p class="text-muted">ลองปรับเปลี่ยนเงื่อนไขการค้นหา</p>
            </div>
        </div>
    </div> 
    
    <nav aria-label="Page navigation" class="mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <small class="text-muted" id="indexPaginationInfo"></small>
            </div>
            <ul class="pagination pagination-sm mb-0" id="indexPagination">
                
            </ul>
        </div>
    </nav>
</div>

