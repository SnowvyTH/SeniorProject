@model IEnumerable<Project.Models.Entity.Patient>
@{
    ViewData["Title"] = "ประวัติผู้ป่วย";
    Layout = "_PharmaLayout";
}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-history me-2 mt-4"></i>ประวัติการประเมิน
            </h2>
            <p class="text-muted mb-0">ดูและจัดการประวัติการประเมินของผู้ป่วย</p>
        </div>
    </div>

    <!-- Search and Filter Section -->
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">ค้นหาผู้ป่วย</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหา HN, ชื่อ, หรือนามสกุล...">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">ประเภทผู้ป่วย</label>
                    <select class="form-select" id="patientTypeFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                        <option value="WARD">ผู้ป่วยใน (WARD)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">สถานะการประเมิน</label>
                    <select class="form-select" id="evaluationFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="with">มีประวัติการประเมิน</option>
                        <option value="without">ไม่มีประวัติการประเมิน</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-2"></i>ล้าง
                    </button>
                </div>
            </div>



    <!-- Patients Table -->
    <div class="modern-card">
        <div class="card-body p-0">
            <div class="table-responsive mt-4">
                <table class="table table-hover mb-0" id="patientsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="25%">ชื่อผู้ป่วย</th>
                            <th width="12%">ประเภทผู้ป่วย</th>
                            <th width="25%">ประวัติการตรวจ</th>
                            <th width="15%">ผู้ประเมิน</th>
                            <th width="13%">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="patientsTableBody">
                        @foreach (var patient in Model)
                        {
                            <tr class="patient-row" data-hn="@patient.HN" data-name="@(patient.Title?.TitleName) @patient.FirstName @patient.LastName" data-type="@patient.PatientType" data-evaluated="@(patient.Evaluations.Any() ? "true" : "false")">
                                
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            <i class="fas fa-user-injured"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@(patient.Title?.TitleName) @patient.FirstName @patient.LastName</div>
                                                <small class="text-muted">@patient.HN</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(patient.PatientType == "OPD" ? "bg-primary" : "bg-success")">
                                        @patient.PatientType
                                    </span>
                                </td>
                                <td>
                                    @if (patient.Evaluations.Any())
                                    {
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                @(patient.Evaluations.OrderByDescending(r => r.RecordDate).First().Form?.FormName) - @(patient.Evaluations.OrderByDescending(r => r.RecordDate).First().RecordDate.ToString("dd/MM/yyyy"))
                                            </button>
                                            <ul class="dropdown-menu">
                                                @foreach (var record in patient.Evaluations.OrderByDescending(r => r.RecordDate))
                                                {
                                                    <li><a class="dropdown-item" href="#" data-record-id="@record.EvaID">
                                                            <i class="fas fa-file-alt me-2"></i>@(record.Form?.FormName) - @(record.RecordDate.ToString("dd/MM/yyyy"))
                                                        </a></li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            <i class="fas fa-minus-circle me-1"></i>ไม่มีข้อมูล
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (patient.Evaluations.Any())
                                    {
                                        var firstRecord = patient.Evaluations.OrderBy(r => r.RecordDate).First();
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-xs me-2">
                                                <i class="fas fa-user-md"></i>
                                            </div>
                                            <small>@($"{firstRecord.User?.Title?.TitleName}{firstRecord.User?.FirstName} {firstRecord.User?.LastName}")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button type="button" class="btn btn-sm btn-outline-info" onclick="viewPatientDetails('@patient.HN')" title="ดูรายละเอียด">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-success" onclick="printEvaluation('@patient.HN')" title="พิมพ์">
                                            <i class="fas fa-print"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลผู้ป่วย</h5>
                <p class="text-muted">ลองปรับเปลี่ยนเงื่อนไขการค้นหา</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-primary {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
        }
        
        .card-success {
            background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
            color: white;
        }
        
        .card-info {
            background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
            color: white;
        }
        
        .card-warning {
            background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
            color: white;
        }

        .stats-card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }

        .stats-number {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .stats-label {
            font-size: 0.9rem;
            margin: 0;
            opacity: 0.9;
        }

        .stats-icon {
            font-size: 2.5rem;
            opacity: 0.7;
        }

        .avatar-sm {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .avatar-xs {
            width: 30px;
            height: 30px;
            background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.8rem;
        }

        .action-buttons {
            display: flex;
            gap: 0.25rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }

        .patient-row.hidden {
            display: none;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
        }

        .modern-card {
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .modern-card .card-header {
            border-radius: 8px 8px 0 0;
            background: #f8f9fa;
            border-bottom: 1px solid #e0e6ed;
            font-weight: 600;
        }

        .modern-card .card-body {
            border-radius: 0 0 8px 8px;
        }

        .btn {
            border-radius: 6px;
        }

        .form-control, .form-select {
            border-radius: 6px;
        }

        .input-group-text {
            border-radius: 6px 0 0 6px;
        }

        .input-group .form-control {
            border-radius: 0 6px 6px 0;
        }

        .badge {
            border-radius: 4px;
        }

        .dropdown-menu {
            border-radius: 6px;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Search and filter functionality
            function filterPatients() {
                const searchQuery = $('#searchInput').val().toLowerCase();
                const patientTypeFilter = $('#patientTypeFilter').val();
                const evaluationFilter = $('#evaluationFilter').val();
                
                let visibleCount = 0;
                
                $('.patient-row').each(function() {
                    const $row = $(this);
                    const hn = $row.data('hn').toString().toLowerCase();
                    const name = $row.data('name').toString().toLowerCase();
                    const patientType = $row.data('type').toString();
                    const hasEvaluation = $row.data('evaluated') === true || $row.data('evaluated') === 'true';
                    
                    let showRow = true;
                    
                    // Search filter (ค้นหา HN หรือชื่อ)
                    if (searchQuery && !hn.includes(searchQuery) && !name.includes(searchQuery)) {
                        showRow = false;
                    }
                    
                    // Patient type filter
                    if (patientTypeFilter && patientType !== patientTypeFilter) {
                        showRow = false;
                    }
                    
                    // Evaluation status filter
                    if (evaluationFilter) {
                        if (evaluationFilter === 'with' && !hasEvaluation) {
                            showRow = false;
                        } else if (evaluationFilter === 'without' && hasEvaluation) {
                            showRow = false;
                        }
                    }
                    
                    if (showRow) {
                        $row.show();
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });
                
                updateResultsCount(visibleCount);
                updateStatistics();
            }
            
            function updateResultsCount(visibleCount) {
                const totalRows = $('.patient-row').length;
                
                if (visibleCount !== totalRows) {
                    $('#resultsCount').html(`<small class="text-muted"><i class="fas fa-search me-1"></i>แสดง ${visibleCount} จาก ${totalRows} รายการ</small>`).show();
                    $('#noDataMessage').toggle(visibleCount === 0);
                } else {
                    $('#resultsCount').hide();
                    $('#noDataMessage').hide();
                }
            }
            
            function updateStatistics() {
                const visibleRows = $('.patient-row:visible');
                const totalVisible = visibleRows.length;
                const opdVisible = visibleRows.filter('[data-type="OPD"]').length;
                const wardVisible = visibleRows.filter('[data-type="WARD"]').length;
                const evaluatedVisible = visibleRows.filter('[data-evaluated="true"]').length;
                
                $('#totalPatients').text(totalVisible);
                $('#opdPatients').text(opdVisible);
                $('#wardPatients').text(wardVisible);
                $('#evaluatedPatients').text(evaluatedVisible);
                $('#patientsCount').text(totalVisible + ' รายการ');
            }
            
            // Event listeners
            $('#searchInput').on('input', filterPatients);
            $('#patientTypeFilter, #evaluationFilter').on('change', filterPatients);
            
            // Initialize
            updateResultsCount($('.patient-row').length);
        });

        // Clear filters function (global scope)
        function clearFilters() {
            $('#searchInput').val('');
            $('#patientTypeFilter').val('');
            $('#evaluationFilter').val('');
            
            $('.patient-row').show();
            $('#resultsCount').hide();
            $('#noDataMessage').hide();
            
            // Reset statistics to original values
            $('#totalPatients').text(@Model.Count());
            $('#opdPatients').text(@Model.Where(p => p.PatientType == "OPD").Count());
            $('#wardPatients').text(@Model.Where(p => p.PatientType == "WARD").Count());
            $('#evaluatedPatients').text(@Model.Where(p => p.Evaluations.Any()).Count());
            $('#patientsCount').text('@Model.Count() รายการ');
        }

        function viewPatientDetails(hn) {
            alert('ดูรายละเอียดผู้ป่วย HN: ' + hn);
            // TODO: Navigate to patient details page
        }

        function printEvaluation(patientId) {
            // This would typically generate a PDF report
            alert('ฟีเจอร์การพิมพ์รายงาน - ผู้ป่วย ID: ' + patientId);
        }
    </script>
}
