}

@section Scripts {
    <script>
        let isEditMode = false;
        let currentPatientHN = null;

        $(document).ready(function() {
            loadInitialData();
            setupFilters();
        });

        function loadInitialData() {
            // Load dropdown data
            loadTitles();
            loadRights();
            loadProvinces();
        }

        function setupFilters() {
            $('#searchInput').on('input', filterPatients);
            $('#provinceFilter, #patientTypeFilter').on('change', filterPatients);
        }

        function filterPatients() {
            const searchQuery = $('#searchInput').val().toLowerCase();
            const provinceFilter = $('#provinceFilter').val();
            const patientTypeFilter = $('#patientTypeFilter').val();
            
            let visibleCount = 0;
            
            $('.patient-row').each(function() {
                const $row = $(this);
                const hn = $row.data('hn').toString().toLowerCase();
                const name = $row.data('name').toString().toLowerCase();
                const patientType = $row.data('type').toString();
                const province = $row.data('province').toString();
                
                let showRow = true;
                
                if (searchQuery && !hn.includes(searchQuery) && !name.includes(searchQuery)) {
                    showRow = false;
                }
                
                if (patientTypeFilter && patientType !== patientTypeFilter) {
                    showRow = false;
                }
                
                if (provinceFilter && province !== provinceFilter) {
                    showRow = false;
                }
                
                if (showRow) {
                    $row.show();
                    visibleCount++;
                } else {
                    $row.hide();
                }
            });
            
            $('#noDataMessage').toggle(visibleCount === 0);
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#provinceFilter').val('');
            $('#patientTypeFilter').val('');
            $('.patient-row').show();
            $('#noDataMessage').hide();
        }

        function openAddPatientModal() {
            isEditMode = false;
            currentPatientHN = null;
            $('#patientModalTitle').html('<i class="fas fa-plus me-2"></i>เพิ่มผู้ป่วยใหม่');
            clearPatientForm();
            generateNextHN();
            $('#patientModal').modal('show');
        }

        function openEditPatientModal(hn) {
            isEditMode = true;
            currentPatientHN = hn;
            $('#patientModalTitle').html('<i class="fas fa-edit me-2"></i>แก้ไขข้อมูลผู้ป่วย');
            loadPatientData(hn);
            $('#patientModal').modal('show');
        }

        function clearPatientForm() {
            $('#patientForm')[0].reset();
            $('#age').val('');
            $('#amphoeId').html('<option value="">เลือกอำเภอ</option>');
            $('#tambonId').html('<option value="">เลือกตำบล</option>');
        }

        function generateNextHN() {
            $.ajax({
                url: '@Url.Action("GetNextHN", "Pharma")',
                type: 'GET',
                success: function(result) {
                    $('#hn').val(result.nextHN);
                },
                error: function() {
                    console.error('Error generating HN');
                }
            });
        }

        function calculateAge() {
            const birthDate = new Date($('#birthDate').val());
            const today = new Date();
            
            if (birthDate && birthDate <= today) {
                let age = today.getFullYear() - birthDate.getFullYear();
                const monthDiff = today.getMonth() - birthDate.getMonth();
                
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                
                $('#age').val(age + ' ปี');
            } else {
                $('#age').val('');
            }
        }

        // Format functions for input fields
        function formatPhone(input) {
            // เอาเฉพาะตัวเลข
            let value = input.value.replace(/\D/g, '');
            
            // จำกัดไม่เกิน 10 ตัวเลข
            if (value.length > 10) {
                value = value.substring(0, 10);
            }
            
            // Format เป็น 0x-xxxx-xxxx
            if (value.length >= 6) {
                value = value.substring(0, 2) + '-' + value.substring(2, 6) + '-' + value.substring(6);
            } else if (value.length >= 2) {
                value = value.substring(0, 2) + '-' + value.substring(2);
            }
            
            input.value = value;
        }

        function formatAndValidateCitizenId(input) {
            formatCitizenId(input);
            validateCitizenId(input);
        }

        function formatCitizenId(input) {
            // เอาเฉพาะตัวเลข
            let value = input.value.replace(/\D/g, '');
            
            // จำกัดไม่เกิน 13 ตัวเลข
            if (value.length > 13) {
                value = value.substring(0, 13);
            }
            
            // Format เป็น x-xxxx-xxxxx-xx-x
            if (value.length >= 11) {
                value = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5, 10) + '-' + value.substring(10, 12) + '-' + value.substring(12);
            } else if (value.length >= 6) {
                value = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5, 10) + '-' + value.substring(10);
            } else if (value.length >= 2) {
                value = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5);
            } else if (value.length >= 1) {
                value = value.substring(0, 1) + '-' + value.substring(1);
            }
            
            input.value = value;
        }

        function validateCitizenId(input) {
            const citizenidFeedback = $('#citizenidFeedback');
            const citizenInput = $(input);
            
            // ดึงเฉพาะตัวเลข
            const cleanValue = input.value.replace(/\D/g, '');
            
            // ตรวจสอบความยาว
            if (cleanValue.length === 0) {
                citizenInput.removeClass('is-valid is-invalid');
                citizenidFeedback.hide();
                return;
            }
            
            if (cleanValue.length !== 13) {
                citizenInput.removeClass('is-valid').addClass('is-invalid');
                citizenidFeedback.text('เลขบัตรประชาชนต้องมี 13 หลัก').show();
                return;
            }
            
            // ตรวจสอบ Check Digit
            if (isValidCitizenId(cleanValue)) {
                citizenInput.removeClass('is-invalid').addClass('is-valid');
                citizenidFeedback.hide();
            } else {
                citizenInput.removeClass('is-valid').addClass('is-invalid');
                citizenidFeedback.text('เลขบัตรประชาชนไม่ถูกต้อง กรุณาตรวจสอบอีกครั้ง').show();
            }
        }

        function isValidCitizenId(citizenId) {
            // ตรวจสอบความยาว
            if (citizenId.length !== 13) {
                return false;
            }
            
            // ตรวจสอบว่าเป็นตัวเลขทั้งหมด
            if (!/^\d{13}$/.test(citizenId)) {
                return false;
            }
            
            // คำนวณ Check Digit
            let sum = 0;
            for (let i = 0; i < 12; i++) {
                sum += parseInt(citizenId.charAt(i)) * (13 - i);
            }
            
            let remainder = sum % 11;
            let checkDigit = (11 - remainder) % 10;
            
            // เปรียบเทียบกับหลักสุดท้าย
            return checkDigit === parseInt(citizenId.charAt(12));
        }

        // Helper function to clean formatted data before sending to server
        function cleanPhoneNumber(phone) {
            return phone ? phone.replace(/\D/g, '') : '';
        }

        function cleanCitizenId(citizenId) {
            return citizenId ? citizenId.replace(/\D/g, '') : '';
        }

        function loadTitles() {
            $.ajax({
                url: '@Url.Action("GetTitles", "Pharma")',
                type: 'GET',
                success: function(titles) {
                    const select = $('#titleId');
                    select.html('<option value="">เลือกคำนำหน้า</option>');
                    titles.forEach(title => {
                        select.append(`<option value="${title.titleID}">${title.titleName}</option>`);
                    });
                }
            });
        }

        function loadRights() {
            $.ajax({
                url: '@Url.Action("GetRights", "Pharma")',
                type: 'GET',
                success: function(rights) {
                    const select = $('#rightId');
                    select.html('<option value="">ว่าง</option>');
                    rights.forEach(right => {
                        select.append(`<option value="${right.rightID}">${right.rightName}</option>`);
                    });
                }
            });
        }

        function loadProvinces() {
            $.ajax({
                url: '@Url.Action("GetProvinces", "Pharma")',
                type: 'GET',
                success: function(provinces) {
                    const select = $('#provinceId');
                    const filterSelect = $('#provinceFilter');
                    
                    select.html('<option value="">เลือกจังหวัด</option>');
                    filterSelect.html('<option value="">ทั้งหมด</option>');
                    
                    provinces.forEach(province => {
                        select.append(`<option value="${province.provinceID}">${province.provinceName}</option>`);
                        filterSelect.append(`<option value="${province.provinceName}">${province.provinceName}</option>`);
                    });
                }
            });
        }

        function loadAmphoes() {
            const provinceId = $('#provinceId').val();
            if (!provinceId) {
                $('#amphoeId').html('<option value="">เลือกอำเภอ</option>');
                $('#tambonId').html('<option value="">เลือกตำบล</option>');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetAmphoes", "Pharma")/' + provinceId,
                type: 'GET',
                success: function(amphoes) {
                    const select = $('#amphoeId');
                    select.html('<option value="">เลือกอำเภอ</option>');
                    amphoes.forEach(amphoe => {
                        select.append(`<option value="${amphoe.amphID}">${amphoe.amphName}</option>`);
                    });
                    $('#tambonId').html('<option value="">เลือกตำบล</option>');
                }
            });
        }

        function loadTambons() {
            const amphoeId = $('#amphoeId').val();
            if (!amphoeId) {
                $('#tambonId').html('<option value="">เลือกตำบล</option>');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetTambons", "Pharma")/' + amphoeId,
                type: 'GET',
                success: function(tambons) {
                    const select = $('#tambonId');
                    select.html('<option value="">เลือกตำบล</option>');
                    tambons.forEach(tambon => {
                        select.append(`<option value="${tambon.tambonID}">${tambon.tambonName}</option>`);
                    });
                }
            });
        }

        function loadPatientData(hn) {
            $.ajax({
                url: '@Url.Action("GetPatient", "Pharma")/' + hn,
                type: 'GET',
                success: function(patient) {
                    $('#hn').val(patient.hn);
                    // Format citizen ID and phone when loading data
                    if (patient.citizenID) {
                        $('#citizenId').val(patient.citizenID);
                        formatAndValidateCitizenId(document.getElementById('citizenId'));
                    }
                    $('#titleId').val(patient.titleID);
                    $('#firstName').val(patient.firstName);
                    $('#lastName').val(patient.lastName);
                    $('#birthDate').val(patient.birthDate ? patient.birthDate.split('T')[0] : '');
                    $('#weight').val(patient.weight);
                    $('#height').val(patient.height);
                    $('#rightId').val(patient.rightID);
                    if (patient.phone) {
                        $('#phone').val(patient.phone);
                        formatPhone(document.getElementById('phone'));
                    }
                    $('#patientType').val(patient.patientType);
                    
                    if (patient.birthDate) {
                        calculateAge();
                    }
                    
                    // Load location data
                    if (patient.provinceID) {
                        $('#provinceId').val(patient.provinceID);
                        loadAmphoes();
                        setTimeout(() => {
                            $('#amphoeId').val(patient.amphoeID);
                            loadTambons();
                            setTimeout(() => {
                                $('#tambonId').val(patient.tambonID);
                            }, 500);
                        }, 500);
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถโหลดข้อมูลผู้ป่วยได้'
                    });
                }
            });
        }

        function savePatient() {
            if (!$('#patientForm')[0].checkValidity()) {
                $('#patientForm')[0].reportValidity();
                return;
            }

            // ตรวจสอบการเลือกข้อมูลที่จำเป็น
            const titleId = $('#titleId').val();
            const tambonId = $('#tambonId').val();

            if (!titleId || titleId === '0') {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกข้อมูล',
                    text: 'กรุณาเลือกคำนำหน้า'
                });
                return;
            }

            if (!tambonId || tambonId === '0') {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกข้อมูล',
                    text: 'กรุณาเลือกตำบล'
                });
                return;
            }

            // ตรวจสอบความถูกต้องของเลขบัตรประชาชน
            const citizenIdInput = $('#citizenId');
            if (citizenIdInput.hasClass('is-invalid')) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ข้อมูลไม่ถูกต้อง',
                    text: 'กรุณาตรวจสอบเลขบัตรประชาชนให้ถูกต้อง'
                });
                citizenIdInput.focus();
                return;
            }

            // ตรวจสอบเลขบัตรประชาชนอีกครั้งก่อนบันทึก
            const cleanCitizenIdValue = cleanCitizenId($('#citizenId').val());
            if (cleanCitizenIdValue && !isValidCitizenId(cleanCitizenIdValue)) {
                Swal.fire({
                    icon: 'error',
                    title: 'เลขบัตรประชาชนไม่ถูกต้อง',
                    text: 'กรุณาตรวจสอบเลขบัตรประชาชนให้ถูกต้อง'
                });
                return;
            }

            const patientData = {
                HN: $('#hn').val(),
                CitizenID: cleanCitizenIdValue,
                TitleID: titleId,
                FirstName: $('#firstName').val(),
                LastName: $('#lastName').val(),
                BirthDate: $('#birthDate').val(),
                Weight: $('#weight').val() || null,
                Height: $('#height').val() || null,
                RightID: $('#rightId').val() || null,
                Phone: cleanPhoneNumber($('#phone').val()),
                PatientType: $('#patientType').val(),
                TambonID: tambonId
            };

            const url = isEditMode 
                ? '@Url.Action("UpdatePatient", "Pharma")'
                : '@Url.Action("CreatePatient", "Pharma")';

            $.ajax({
                url: url,
                type: 'POST',
                data: JSON.stringify(patientData),
                contentType: 'application/json',
                success: function(result) {
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ!',
                            text: isEditMode ? 'แก้ไขข้อมูลผู้ป่วยเรียบร้อยแล้ว' : 'เพิ่มผู้ป่วยใหม่เรียบร้อยแล้ว',
                            timer: 1500
                        }).then(() => {
                            $('#patientModal').modal('hide');
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: result.message
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถบันทึกข้อมูลได้'
                    });
                }
            });
        }
    </script>
}
