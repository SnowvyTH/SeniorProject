@model IEnumerable<Project.Models.Entity.Patient>
@{
    ViewData["Title"] = "ทะเบียนผู้ป่วย";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-users me-2"></i>ทะเบียนผู้ป่วยทั้งหมด
            </h2>
            <p class="text-muted mb-0">จัดการข้อมูลผู้ป่วยในระบบ</p>
        </div>
        <button type="button" class="btn btn-primary" onclick="openAddPatientModal()">
            <i class="fas fa-plus me-2"></i>เพิ่มผู้ป่วยใหม่
        </button>
    </div>

    <!-- Search and Filter Section -->
    <div class="modern-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">ค้นหาผู้ป่วย</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหา HN, ชื่อ, หรือนามสกุล...">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">จังหวัด</label>
                    <select class="form-select" id="provinceFilter">
                        <option value="">ทั้งหมด</option>
                        <!-- จะถูกเติมด้วย JavaScript -->
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">ประเภทผู้ป่วย</label>
                    <select class="form-select" id="patientTypeFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                        <option value="WARD">ผู้ป่วยใน (WARD)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-2"></i>ล้าง
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Patients Table -->
    <div class="modern-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="patientsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="5%">ลำดับ</th>
                            <th width="20%">ชื่อผู้ป่วย</th>
                            <th width="15%">เลขบัตรประชาชน</th>
                            <th width="7%">อายุ (ปี)</th>
                            <th width="12%">จังหวัด</th>
                            <th width="12%">อำเภอ</th>
                            <th width="10%">ประเภทผู้ป่วย</th>
                            <th width="10%">สิทธิ์การรักษา</th>
                            <th width="6%">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="patientsTableBody">
                        @{int index = 1;}
                        @foreach (var patient in Model)
                        {
                            <tr class="patient-row" 
                                data-hn="@patient.HN" 
                                data-name="@(patient.Title?.TitleName) @patient.FirstName @patient.LastName" 
                                data-type="@patient.PatientType"
                                data-province="@(patient.District?.Amphur?.Province?.PROVINCE_NAME ?? "")">
                                <td class="text-center">@index</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            <i class="fas fa-user-injured"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@(patient.Title?.TitleName) @patient.FirstName @patient.LastName</div>
                                            <small class="text-muted">@patient.HN</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(patient.CitizenID))
                                    {
                                        @if (patient.CitizenID.Length >= 5)
                                        {
                                            var last5 = patient.CitizenID.Substring(patient.CitizenID.Length - 5);
                                            @($"x-xxxx-xxx{last5.Substring(0, 2)}-{last5.Substring(2, 2)}-{last5.Substring(4, 1)}")
                                        }
                                        else
                                        {
                                            <span class="text-muted">ข้อมูลไม่ครบ</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (patient.BirthDate.HasValue)
                                    {
                                        @((DateTime.Now.Year - patient.BirthDate.Value.Year)) @:
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(patient.District?.Amphur?.Province?.PROVINCE_NAME ?? "-")</td>
                                <td>@(patient.District?.Amphur?.AMPHUR_NAME ?? "-")</td>
                                <td>
                                    <span class="badge @(patient.PatientType == "OPD" ? "bg-primary" : "bg-success") mx-4">
                                        @patient.PatientType
                                    </span>
                                </td>
                                <td class="text-center">@(patient.Treatment?.TreatmentName ?? "-")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="openEditPatientModal('@patient.HN')" title="แก้ไข">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลผู้ป่วย</h5>
                <p class="text-muted">ลองปรับเปลี่ยนเงื่อนไขการค้นหา</p>
            </div>
        </div>
    </div>
</div>

<!-- Patient Modal -->
<div class="modal fade" id="patientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientModalTitle">
                    <i class="fas fa-user me-2"></i>ข้อมูลผู้ป่วย
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="patientForm">
                    <div class="row g-3">
                        <!-- HN -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">HN</label>
                            <input type="text" class="form-control" id="hn" readonly style="background-color: #f8f9fa;">
                        </div>
                        
                        <!-- เลขบัตรประชาชน -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">เลขบัตรประชาชน</label>
                            <input type="text" class="form-control" id="citizenId" placeholder="x-xxxx-xxxxx-xx-x" maxlength="17" required oninput="formatAndValidateCitizenId(this)">
                            <div id="citizenidFeedback" class="invalid-feedback"></div>
                        </div>
                        
                        <!-- คำนำหน้า + ชื่อ -->
                        <div class="col-md-3">
                            <label class="form-label fw-bold">คำนำหน้า</label>
                            <select class="form-select" id="titleId" required>
                                <option value="">เลือกคำนำหน้า</option>
                                <!-- จะถูกเติมด้วย JavaScript -->
                            </select>
                        </div>
                        
                        <div class="col-md-9">
                            <label class="form-label fw-bold">ชื่อจริง</label>
                            <input type="text" class="form-control" id="firstName" placeholder="กรอกชื่อจริง" required>
                        </div>
                        
                        <!-- นามสกุล -->
                        <div class="col-md-12">
                            <label class="form-label fw-bold">นามสกุล</label>
                            <input type="text" class="form-control" id="lastName" placeholder="กรอกนามสกุล" required>
                        </div>
                        
                        <!-- วันเดือนปีเกิด + อายุ -->
                        <div class="col-md-8">
                            <label class="form-label fw-bold">วันเดือนปีเกิด</label>
                            <input type="date" class="form-control" id="birthDate" onchange="calculateAge()" required>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label fw-bold">อายุ (ปี)</label>
                            <input type="text" class="form-control" id="age" readonly style="background-color: #f8f9fa;" placeholder="อายุ (ปี)">
                        </div>
                        
                        <!-- น้ำหนัก + ส่วนสูง -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">น้ำหนัก (กก.) <small class="text-muted">(ไม่บังคับ)</small></label>
                            <input type="number" class="form-control" id="weight" placeholder="น้ำหนัก" step="0.1" min="0">
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">ส่วนสูง (ซม.) <small class="text-muted">(ไม่บังคับ)</small></label>
                            <input type="number" class="form-control" id="height" placeholder="ส่วนสูง" step="0.1" min="0">
                        </div>
                        
                        <!-- สิทธิ์รักษา -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">สิทธิ์รักษา <small class="text-muted">(ไม่บังคับ)</small></label>
                            <select class="form-select" id="rightId">
                                <option value="">ว่าง</option>
                                <!-- จะถูกเติมด้วย JavaScript -->
                            </select>
                        </div>
                        
                        <!-- โทรศัพท์ -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">โทรศัพท์</label>
                            <input type="tel" class="form-control" id="phone" placeholder="0x-xxxx-xxxx" maxlength="12" oninput="formatPhone(this)">
                        </div>
                        
                        <!-- ประเภทผู้ป่วย -->
                        <div class="col-md-12">
                            <label class="form-label fw-bold">ประเภทผู้ป่วย</label>
                            <select class="form-select" id="patientType" required>
                                <option value="">--เลือกประเภทผู้ป่วย--</option>
                                <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                                <option value="WARD">ผู้ป่วยใน (WARD)</option>
                            </select>
                        </div>
                        
                        <!-- จังหวัด -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">จังหวัด</label>
                            <select class="form-select" id="provinceId" onchange="loadAmphoes()" required>
                                <option value="">--เลือกจังหวัด--</option>
                                <!-- จะถูกเติมด้วย JavaScript -->
                            </select>
                        </div>
                        
                        <!-- อำเภอ -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">อำเภอ</label>
                            <select class="form-select" id="amphoeId" onchange="loadTambons()" required>
                                <option value="">--เลือกอำเภอ--</option>
                                <!-- จะถูกเติมด้วย JavaScript -->
                            </select>
                        </div>
                        
                        <!-- ตำบล -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold">ตำบล</label>
                            <select class="form-select" id="tambonId" required>
                                <option value="">--เลือกตำบล--</option>
                                <!-- จะถูกเติมด้วย JavaScript -->
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary" onclick="savePatient()">
                    <i class="fas fa-save me-2"></i>บันทึก
                </button>
            </div>
        </div>
    </div>
</div>

