@model IEnumerable<Project.Models.Entity.Patient>
@{
    ViewData["Title"] = "เวชระเบียนผู้ป่วย";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
}

<div class="container">
    
    <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-users me-2"></i>เวชระเบียนผู้ป่วย
            </h2>
            <p class="text-muted mb-0">จัดการข้อมูลผู้ป่วยในระบบ</p>
        </div>
        <button type="button" class="btn btn-primary" onclick="openAddPatientModal()">
            <i class="fas fa-plus me-2"></i>เพิ่มผู้ป่วยใหม่
        </button>
    </div>

    
    <div class="modern-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label fw-bold">ค้นหาผู้ป่วย</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหา HN, ชื่อ, หรือนามสกุล...">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">ประเภทผู้ป่วย</label>
                    <select class="form-select" id="patientTypeFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                        <option value="IPD">ผู้ป่วยใน (IPD)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-2"></i>ล้าง
                    </button>
                </div>
            </div>
        </div>
    </div>

    
    <div class="modern-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="patientsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="5%">ลำดับ</th>
                            <th width="20%">ชื่อผู้ป่วย</th>
                            <th width="12%">เลขบัตรประชาชน</th>
                            <th width="7%">อายุ (ปี)</th>
                            <th width="12%">จังหวัด</th>
                            <th width="12%">อำเภอ</th>
                            <th width="10%">ประเภทผู้ป่วย</th>
                            <th width="10%">สิทธิ์การรักษา</th>
                            <th width="7%">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody id="patientsTableBody">
                        @{int index = 1;}
                        @foreach (var patient in Model)
                        {
                            <tr class="patient-row" 
                                data-hn="@patient.HN" 
                                data-name="@(patient.Title?.TitleName) @patient.FirstName @patient.LastName" 
                                data-type="@patient.PatientType"
                                data-province="@(patient.District?.Amphur?.Province?.PROVINCE_NAME ?? "")">
                                <td class="text-center">@index</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            <i class="fas fa-user-injured"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@(patient.Title?.TitleName) @patient.FirstName @patient.LastName</div>
                                            <small class="text-muted">@patient.HN</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(patient.CitizenID))
                                    {
                                        var last4 = patient.CitizenID.Substring(patient.CitizenID.Length - 4);
                                        @($"x-xxxx-xxxx{last4.Substring(0, 1)}-{last4.Substring(1, 2)}-{last4.Substring(3, 1)}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (patient.BirthDate.HasValue)
                                    {
                                        @((DateTime.Now.Year - patient.BirthDate.Value.Year)) @:
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(patient.District?.Amphur?.Province?.PROVINCE_NAME ?? "-")</td>
                                <td>@(patient.District?.Amphur?.AMPHUR_NAME ?? "-")</td>
                                <td>
                                    <span class="badge @(patient.PatientType == "OPD" ? "bg-primary bg-gradient" : "bg-success bg-gradient") mx-4">
                                        @patient.PatientType
                                    </span>
                                </td>
                                <td class="text-center">@(patient.Treatment?.TreatmentName ?? "-")</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-warning" onclick="openEditPatientModal('@patient.HN')" title="แก้ไข">
                                        <i class="fas fa-edit"></i> แก้ไข
                                    </button>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>     
            <div id="loadingSpinner" class="text-center p-4" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">กำลังโหลด...</span>
                </div>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลผู้ป่วย</h5>
                <p class="text-muted">ลองเพิ่มผู้ป่วยใหม่หรือปรับเปลี่ยนการค้นหา</p>
            </div>
        </div>
    </div>
    
    <nav aria-label="Page navigation" class="mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <small class="text-muted" id="paginationInfo"></small>
            </div>
            <ul class="pagination pagination-sm mb-0" id="patientsPagination">
                
            </ul>
        </div>
    </nav>
</div>


<div class="modal fade" id="patientModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientModalTitle">
                    <i class="fas fa-user me-2"></i>ข้อมูลผู้ป่วย
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="patientForm">
                    <div class="row g-3">
                        
                        <div class="col-md-12 form-label fw-bold">
                            <i class="fas fa-calendar-plus me-2"></i>วันที่บันทึกเวชระเบียน
                            <input type="date" class="form-control mt-1" id="recordDate" required>
                        </div>
                        
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">HN</label>
                            <input type="text" class="form-control" id="hn" readonly style="background-color: #f8f9fa;">
                        </div>
                        
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">เลขบัตรประชาชน</label>
                            <input type="text" class="form-control" id="citizenId" placeholder="x-xxxx-xxxxx-xx-x" maxlength="17" required oninput="formatAndValidateCitizenId(this)">
                            <div id="citizenidFeedback" class="invalid-feedback"></div>
                        </div>
                        
                        
                        <div class="col-md-3">
                            <label class="form-label fw-bold">คำนำหน้า</label>
                            <select class="form-select" id="titleId" required>
                                <option value="">เลือกคำนำหน้า</option>
                                
                            </select>
                        </div>
                        
                        <div class="col-md-9">
                            <label class="form-label fw-bold">ชื่อจริง</label>
                            <input type="text" class="form-control" id="firstName" placeholder="กรอกชื่อจริง" required>
                        </div>
                        
                        
                        <div class="col-md-12">
                            <label class="form-label fw-bold">นามสกุล</label>
                            <input type="text" class="form-control" id="lastName" placeholder="กรอกนามสกุล" required>
                        </div>
                        
                        
                        <div class="col-md-8">
                            <label class="form-label fw-bold">วันเดือนปีเกิด</label>
                            <input type="date" class="form-control" id="birthDate" onchange="calculateAge()" required>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label fw-bold">อายุ (ปี)</label>
                            <input type="text" class="form-control" id="age" readonly style="background-color: #f8f9fa;" placeholder="อายุ (ปี)">
                        </div>
                        
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">น้ำหนัก (กก.) <small class="text-muted">(ไม่บังคับ)</small></label>
                            <input type="number" class="form-control" id="weight" placeholder="น้ำหนัก" step="0.1" min="0">
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">ส่วนสูง (ซม.) <small class="text-muted">(ไม่บังคับ)</small></label>
                            <input type="number" class="form-control" id="height" placeholder="ส่วนสูง" step="0.1" min="0">
                        </div>
                        
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">สิทธิ์รักษา <small class="text-muted">(ไม่บังคับ)</small></label>
                            <select class="form-select" id="rightId">
                                <option value="">ว่าง</option>
                                
                            </select>
                        </div>
                        
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">โทรศัพท์</label>
                            <input type="tel" class="form-control" id="phone" placeholder="0x-xxxx-xxxx" maxlength="12" oninput="formatPhone(this)">
                        </div>
                        
                        
                        <div class="col-md-12">
                            <label class="form-label fw-bold">ประเภทผู้ป่วย</label>
                            <select class="form-select" id="patientType" required>
                                <option value="">--เลือกประเภทผู้ป่วย--</option>
                                <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                                <option value="IPD">ผู้ป่วยใน (IPD)</option>
                            </select>
                        </div>
                        
                        
                        <div class="col-md-4">
                            <label class="form-label fw-bold">จังหวัด</label>
                            <select class="form-select" id="provinceId" onchange="loadAmphoes()" required>
                                <option value="">--เลือกจังหวัด--</option>
                                
                            </select>
                        </div>
                        
                        
                        <div class="col-md-4">
                            <label class="form-label fw-bold">อำเภอ</label>
                            <select class="form-select" id="amphoeId" onchange="loadTambons()" required>
                                <option value="">--เลือกอำเภอ--</option>
                                
                            </select>
                        </div>
                        
                        
                        <div class="col-md-4">
                            <label class="form-label fw-bold">ตำบล</label>
                            <select class="form-select" id="tambonId" required>
                                <option value="">--เลือกตำบล--</option>
                                
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="button" class="btn btn-primary" onclick="savePatient()">
                    <i class="fas fa-save me-2"></i>บันทึก
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .modern-card {
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border: none;
        }

        .modern-card .card-header {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border-bottom: none;
            font-weight: 600;
            padding: 1rem 1.5rem;
        }

        .modern-card .card-body {
            padding: 1.5rem;
        }

        .avatar-sm {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
            background-color: #f8f9fa;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(81, 195, 183, 0.1);
        }

        .btn {
            border-radius: 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--dark-green) 0%, var(--mint-green) 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(81, 195, 183, 0.3);
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #e0e6ed;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--mint-green);
            box-shadow: 0 0 0 0.2rem rgba(81, 195, 183, 0.25);
        }

        .input-group-text {
            background-color: var(--mint-green);
            color: white;
            border: 1px solid var(--mint-green);
            border-radius: 8px 0 0 8px;
        }

        .input-group .form-control {
            border-radius: 0 8px 8px 0;
        }

        .modal-content {
            border-radius: 15px;
            border: none;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }

        .modal-header {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border-bottom: none;
        }

        .btn-close {
            filter: invert(1);
        }

        :root {
            --mint-green: #51c3b7;
            --dark-green: #05685e;
        }

        .page-title {
            color: var(--dark-green);
            font-weight: 700;
        }

        .patient-row.hidden {
            display: none;
        }

        /* ซ่อนตารางตั้งแต่แรกเพื่อป้องกันการกระพริบ */
        #patientsTable tbody {
            display: none;
        }
        
        #patientsTable tbody.loaded {
            display: table-row-group;
        }
    </style>
}

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        let isEditMode = false;
        let currentPatientHN = null;
        let currentPage = 1;
        const pageSize = 5;
        let allPatients = []; 
        let filteredPatients = []; 

        $(document).ready(function() {
            loadInitialData();
            setupFilters();
            loadPatients();
        });

        function loadPatients() {
            $('#loadingSpinner').show();
            $('#noDataMessage').hide();
            
            const searchQuery = $('#searchInput').val().toLowerCase();
            const provinceFilter = $('#provinceFilter').val();
            const patientTypeFilter = $('#patientTypeFilter').val();

            if (allPatients.length === 0) {
                $('.patient-row').each(function() {
                    const row = $(this);
                    allPatients.push({
                        element: row.clone(),
                        hn: row.data('hn') ? row.data('hn').toString() : '',
                        name: row.find('td:eq(1)').text().trim(),
                        province: row.data('province') ? row.data('province').toString() : '',
                        patientType: row.data('type') ? row.data('type').toString() : ''
                    });
                });
            }

            filteredPatients = allPatients.filter(function(patient) {
                const matchesSearch = searchQuery === '' || 
                    patient.hn.toLowerCase().includes(searchQuery) || 
                    patient.name.toLowerCase().includes(searchQuery);
                const matchesProvince = !provinceFilter || patient.province === provinceFilter;
                const matchesType = !patientTypeFilter || patient.patientType === patientTypeFilter;
                
                return matchesSearch && matchesProvince && matchesType;
            });

            displayPatients(filteredPatients);
            $('#loadingSpinner').hide();
        }



        function displayPatients(patients) {
            const paginatedData = paginateData(patients, currentPage, pageSize);
            const tbody = $('#patientsTableBody');
            tbody.empty();

            if (paginatedData.items.length === 0) {
                document.getElementById('patientsPagination').innerHTML = '';
                $('#noDataMessage').show();
                $('#patientsPagination').parent().hide();
                $('#paginationInfo').text('');
                $('#patientsTable tbody').hide();
                return;
            }
            
            $('#noDataMessage').hide();
            $('#patientsPagination').parent().show();
            $('#patientsTable tbody').addClass('loaded').show();
            
            paginatedData.items.forEach(function(patient, index) {
                const rowNumber = ((currentPage - 1) * pageSize) + index + 1;
                const newRow = patient.element.clone();
                newRow.find('td:first').text(rowNumber);
                tbody.append(newRow);
            });
            
            generatePagination(paginatedData.totalPages, currentPage, 'patientsPagination', 'changePatientPage');
            updatePaginationInfo(currentPage, pageSize, paginatedData.totalItems, 'paginationInfo');
        }

        function changePatientPage(page) {
            currentPage = page;
            displayPatients(filteredPatients);
        }

        function setupFilters() {
            $('#searchInput').on('input', function() {
                currentPage = 1;
                loadPatients();
            });
            $('#provinceFilter, #patientTypeFilter').on('change', function() {
                currentPage = 1;
                loadPatients();
            });
        }

        function loadInitialData() {
            loadTitles();
            loadRights();
            loadProvinces();
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#provinceFilter').val('');
            $('#patientTypeFilter').val('');
            currentPage = 1;
            loadPatients();
        }

        function openAddPatientModal() {
            isEditMode = false;
            currentPatientHN = null;
            $('#patientModalTitle').html('<i class="fas fa-plus me-2"></i>เพิ่มผู้ป่วยใหม่');
            clearPatientForm();
            generateNextHN();
            setCurrentDateAsDefault();
            $('#patientModal').modal('show');
        }

        function openEditPatientModal(hn) {
            isEditMode = true;
            currentPatientHN = hn;
            $('#patientModalTitle').html('<i class="fas fa-edit me-2"></i>แก้ไขข้อมูลผู้ป่วย');
            loadPatientData(hn);
            $('#patientModal').modal('show');
        }

        function clearPatientForm() {
            $('#patientForm')[0].reset();
            $('#age').val('');
            $('#amphoeId').html('<option value="">เลือกอำเภอ</option>');
            $('#tambonId').html('<option value="">เลือกตำบล</option>');
            setCurrentDateAsDefault();
        }
        
        function setCurrentDateAsDefault() {
            const today = new Date();
            const formattedDate = today.toISOString().split('T')[0];
            $('#recordDate').val(formattedDate);
            
            $('#recordDate').attr('max', formattedDate);
        }
        
        function validateRecordDate() {
            const recordDate = new Date($('#recordDate').val());
            const today = new Date();
            today.setHours(23, 59, 59, 999); 
            
            if (recordDate > today) {
                Swal.fire({
                    icon: 'warning',
                    title: 'วันที่ไม่ถูกต้อง',
                    text: 'วันที่บันทึกเวชระเบียนไม่สามารถเกินวันปัจจุบันได้',
                    confirmButtonColor: '#51c3b7'
                });
                
                const todayFormatted = new Date().toISOString().split('T')[0];
                $('#recordDate').val(todayFormatted);
                return false;
            }
            return true;
        }

        function generateNextHN() {
            $.ajax({
                url: '@Url.Action("GetNextHN", "Pharma")',
                type: 'GET',
                success: function(result) {
                    $('#hn').val(result.nextHN);
                },
                error: function() {
                    console.error('Error generating HN');
                }
            });
        }

        function calculateAge() {
            const birthDate = new Date($('#birthDate').val());
            const today = new Date();
            
            if (birthDate && birthDate <= today) {
                let age = today.getFullYear() - birthDate.getFullYear();
                const monthDiff = today.getMonth() - birthDate.getMonth();
                
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                
                $('#age').val(age + ' ปี');
            } else {
                $('#age').val('');
            }
        }

        function formatPhone(input) {
            let value = input.value.replace(/\D/g, '');
            
            if (value.length > 10) {
                value = value.substring(0, 10);
            }
            
            if (value.length >= 6) {
                value = value.substring(0, 2) + '-' + value.substring(2, 6) + '-' + value.substring(6);
            } else if (value.length >= 2) {
                value = value.substring(0, 2) + '-' + value.substring(2);
            }
            
            input.value = value;
        }

        function formatAndValidateCitizenId(input) {
            formatCitizenId(input);
            validateCitizenId(input);
        }

        function formatCitizenId(input) {
            let value = input.value.replace(/\D/g, '');
            
            if (value.length > 13) {
                value = value.substring(0, 13);
            }
            
            if (value.length >= 11) {
                value = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5, 10) + '-' + value.substring(10, 12) + '-' + value.substring(12);
            } else if (value.length >= 6) {
                value = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5, 10) + '-' + value.substring(10);
            } else if (value.length >= 2) {
                value = value.substring(0, 1) + '-' + value.substring(1, 5) + '-' + value.substring(5);
            } else if (value.length >= 1) {
                value = value.substring(0, 1) + '-' + value.substring(1);
            }
            
            input.value = value;
        }

        function validateCitizenId(input) {
            const citizenidFeedback = $('#citizenidFeedback');
            const citizenInput = $(input);
            
            const cleanValue = input.value.replace(/\D/g, '');
            
            if (cleanValue.length === 0) {
                citizenInput.removeClass('is-valid is-invalid');
                citizenidFeedback.hide();
                return;
            }
            
            if (cleanValue.length !== 13) {
                citizenInput.removeClass('is-valid').addClass('is-invalid');
                citizenidFeedback.text('เลขบัตรประชาชนต้องมี 13 หลัก').show();
                return;
            }
            
            if (isValidCitizenId(cleanValue)) {
                citizenInput.removeClass('is-invalid').addClass('is-valid');
                citizenidFeedback.hide();
            } else {
                citizenInput.removeClass('is-valid').addClass('is-invalid');
                citizenidFeedback.text('เลขบัตรประชาชนไม่ถูกต้อง กรุณาตรวจสอบอีกครั้ง').show();
            }
        }

        function isValidCitizenId(citizenId) {
            if (citizenId.length !== 13) {
                return false;
            }
            
            if (!/^\d{13}$/.test(citizenId)) {
                return false;
            }
            
            let sum = 0;
            for (let i = 0; i < 12; i++) {
                sum += parseInt(citizenId.charAt(i)) * (13 - i);
            }
            
            let remainder = sum % 11;
            let checkDigit = (11 - remainder) % 10;
            
            return checkDigit === parseInt(citizenId.charAt(12));
        }

        function cleanPhoneNumber(phone) {
            return phone ? phone.replace(/\D/g, '') : '';
        }

        function cleanCitizenId(citizenId) {
            return citizenId ? citizenId.replace(/\D/g, '') : '';
        }

        function loadTitles() {
            $.ajax({
                url: '@Url.Action("GetTitles", "Pharma")',
                type: 'GET',
                success: function(titles) {
                    const select = $('#titleId');
                    select.html('<option value="">เลือกคำนำหน้า</option>');
                    titles.forEach(title => {
                        select.append(`<option value="${title.titleID}">${title.titleName}</option>`);
                    });
                }
            });
        }

        function loadRights() {
            $.ajax({
                url: '@Url.Action("GetRights", "Pharma")',
                type: 'GET',
                success: function(rights) {
                    const select = $('#rightId');
                    select.html('<option value="">ว่าง</option>');
                    rights.forEach(right => {
                        select.append(`<option value="${right.rightID}">${right.rightName}</option>`);
                    });
                }
            });
        }

        function loadProvinces() {
            $.ajax({
                url: '@Url.Action("GetProvinces", "Pharma")',
                type: 'GET',
                success: function(provinces) {
                    const select = $('#provinceId');
                    const filterSelect = $('#provinceFilter');
                    
                    select.html('<option value="">เลือกจังหวัด</option>');
                    filterSelect.html('<option value="">ทั้งหมด</option>');
                    
                    provinces.forEach(province => {
                        select.append(`<option value="${province.provinceID}">${province.provinceName}</option>`);
                        filterSelect.append(`<option value="${province.provinceName}">${province.provinceName}</option>`);
                    });
                }
            });
        }

        function loadAmphoes() {
            const provinceId = $('#provinceId').val();
            if (!provinceId) {
                $('#amphoeId').html('<option value="">เลือกอำเภอ</option>');
                $('#tambonId').html('<option value="">เลือกตำบล</option>');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetAmphoes", "Pharma")/' + provinceId,
                type: 'GET',
                success: function(amphoes) {
                    const select = $('#amphoeId');
                    select.html('<option value="">เลือกอำเภอ</option>');
                    amphoes.forEach(amphoe => {
                        select.append(`<option value="${amphoe.amphID}">${amphoe.amphName}</option>`);
                    });
                    $('#tambonId').html('<option value="">เลือกตำบล</option>');
                }
            });
        }

        function loadTambons() {
            const amphoeId = $('#amphoeId').val();
            if (!amphoeId) {
                $('#tambonId').html('<option value="">เลือกตำบล</option>');
                return;
            }

            $.ajax({
                url: '@Url.Action("GetTambons", "Pharma")/' + amphoeId,
                type: 'GET',
                success: function(tambons) {
                    const select = $('#tambonId');
                    select.html('<option value="">เลือกตำบล</option>');
                    tambons.forEach(tambon => {
                        select.append(`<option value="${tambon.tambonID}">${tambon.tambonName}</option>`);
                    });
                }
            });
        }

        function loadPatientData(hn) {
            $.ajax({
                url: '@Url.Action("GetPatient", "Pharma")/' + hn,
                type: 'GET',
                success: function(patient) {
                    $('#hn').val(patient.hn);
                    if (patient.citizenID) {
                        $('#citizenId').val(patient.citizenID);
                        formatAndValidateCitizenId(document.getElementById('citizenId'));
                    }
                    $('#titleId').val(patient.titleID);
                    $('#firstName').val(patient.firstName);
                    $('#lastName').val(patient.lastName);
                    $('#birthDate').val(patient.birthDate ? patient.birthDate.split('T')[0] : '');
                    $('#recordDate').val(patient.recordDate ? patient.recordDate.split('T')[0] : '');
                    $('#weight').val(patient.weight);
                    $('#height').val(patient.height);
                    $('#rightId').val(patient.rightID);
                    if (patient.phone) {
                        $('#phone').val(patient.phone);
                        formatPhone(document.getElementById('phone'));
                    }
                    $('#patientType').val(patient.patientType);
                    
                    if (patient.birthDate) {
                        calculateAge();
                    }
                    
                    if (patient.provinceID) {
                        $('#provinceId').val(patient.provinceID);
                        loadAmphoes();
                        setTimeout(() => {
                            $('#amphoeId').val(patient.amphoeID);
                            loadTambons();
                            setTimeout(() => {
                                $('#tambonId').val(patient.tambonID);
                            }, 500);
                        }, 500);
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถโหลดข้อมูลผู้ป่วยได้'
                    });
                }
            });
        }

        function savePatient() {
            if (!$('#patientForm')[0].checkValidity()) {
                $('#patientForm')[0].reportValidity();
                return;
            }
            
            if (!validateRecordDate()) {
                return;
            }

            const titleId = $('#titleId').val();
            const tambonId = $('#tambonId').val();

            if (!titleId || titleId === '0') {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกข้อมูล',
                    text: 'กรุณาเลือกคำนำหน้า'
                });
                return;
            }

            if (!tambonId || tambonId === '0') {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกข้อมูล',
                    text: 'กรุณาเลือกตำบล'
                });
                return;
            }

            const citizenIdInput = $('#citizenId');
            if (citizenIdInput.hasClass('is-invalid')) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ข้อมูลไม่ถูกต้อง',
                    text: 'กรุณาตรวจสอบเลขบัตรประชาชนให้ถูกต้อง'
                });
                citizenIdInput.focus();
                return;
            }

            const cleanCitizenIdValue = cleanCitizenId($('#citizenId').val());
            if (cleanCitizenIdValue && !isValidCitizenId(cleanCitizenIdValue)) {
                Swal.fire({
                    icon: 'error',
                    title: 'เลขบัตรประชาชนไม่ถูกต้อง',
                    text: 'กรุณาตรวจสอบเลขบัตรประชาชนให้ถูกต้อง'
                });
                return;
            }

            checkDuplicatePatient(cleanCitizenIdValue, $('#firstName').val(), $('#lastName').val(), $('#hn').val(), function() {
                savePatientDataToServer();
            });
        }

        function checkDuplicatePatient(citizenId, firstName, lastName, currentHN, callback) {
            $.ajax({
                url: '@Url.Action("CheckDuplicatePatient", "Pharma")',
                type: 'GET',
                data: {
                    citizenId: citizenId,
                    firstName: firstName,
                    lastName: lastName,
                    currentHN: currentHN
                },
                success: function(result) {
                    if (result.success && result.duplicates.length > 0) {
                        let message = 'พบข้อมูลที่ซ้ำกันในระบบ:\n\n';
                        
                        result.duplicates.forEach(function(dup) {
                            if (dup.type === 'citizenId') {
                                message += `• เลขบัตรประชาชน: ${dup.citizenId}\n`;
                                message += `  ผู้ป่วย: ${dup.name} (HN: ${dup.hn})\n\n`;
                            } else if (dup.type === 'fullName') {
                                message += `• ชื่อ-นามสกุล: ${dup.name}\n`;
                                message += `  HN: ${dup.hn}\n\n`;
                            }
                        });
                        
                        message += 'ไม่สามารถบันทึกข้อมูลที่ซ้ำกันได้';
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'พบข้อมูลซ้ำ',
                            text: message,
                            confirmButtonColor: '#d33'
                        });
                    } else {
                        callback();
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถตรวจสอบข้อมูลซ้ำได้'
                    });
                }
            });
        }

        function savePatientDataToServer() {
            const patientData = {
                HN: $('#hn').val(),
                CitizenID: cleanCitizenId($('#citizenId').val()),
                TitleID: $('#titleId').val(),
                FirstName: $('#firstName').val(),
                LastName: $('#lastName').val(),
                BirthDate: $('#birthDate').val(),
                RecordDate: $('#recordDate').val(),
                Weight: $('#weight').val() || null,
                Height: $('#height').val() || null,
                RightID: $('#rightId').val() || null,
                Phone: cleanPhoneNumber($('#phone').val()),
                PatientType: $('#patientType').val(),
                TambonID: $('#tambonId').val()
            };

            const url = isEditMode 
                ? '@Url.Action("UpdatePatient", "Pharma")'
                : '@Url.Action("CreatePatient", "Pharma")';

            $.ajax({
                url: url,
                type: 'POST',
                data: JSON.stringify(patientData),
                contentType: 'application/json',
                success: function(result) {
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ!',
                            text: isEditMode ? 'แก้ไขข้อมูลผู้ป่วยเรียบร้อยแล้ว' : 'เพิ่มผู้ป่วยใหม่เรียบร้อยแล้ว',
                            timer: 1500
                        }).then(() => {
                            $('#patientModal').modal('hide');
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: result.message
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถบันทึกข้อมูลได้'
                    });
                }
            });
        }
    </script>
}
