@model Project.Models.Entity.Evaluation
@{
    Layout = null;
    var patient = Model.Patient;
    var form = Model.Form;
    var user = Model.User;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>รายงานผลการประเมิน - @(form?.FormName)</title>
    <style>
        body {
            font-family: 'Sarabun', Arial, sans-serif;
            font-size: 14px;
            line-height: 1.4;
            margin: 20px;
            color: #333;
        }
        
        .header {
            text-align: center;
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        
        .header h1 {
            margin: 0;
            font-size: 20px;
            font-weight: bold;
        }
        
        .header h2 {
            margin: 5px 0 0 0;
            font-size: 16px;
            color: #666;
        }
        
        .info-section {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
            background-color: #f9f9f9;
        }
        
        .info-row {
            display: flex;
            margin-bottom: 8px;
        }
        
        .info-label {
            font-weight: bold;
            width: 150px;
            flex-shrink: 0;
        }
        
        .info-value {
            flex: 1;
        }
        
        .questions-section {
            margin-top: 30px;
        }
        
        .question-item {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #eee;
            border-radius: 5px;
        }
        
        .question-number {
            font-weight: bold;
            color: #2c5530;
            margin-bottom: 8px;
        }
        
        .question-text {
            margin-bottom: 10px;
            line-height: 1.5;
        }
        
        .answer-section {
            margin-left: 20px;
            margin-top: 10px;
        }
        
        .selected-answer {
            background-color: #e7f3e7;
            padding: 8px;
            border-left: 4px solid #51c3b7;
            border-radius: 3px;
            font-weight: bold;
        }
        
        .answer-options {
            margin-top: 8px;
            color: #666;
            font-size: 12px;
        }
        
        .result-section {
            margin-top: 30px;
            padding: 20px;
            border: 2px solid #51c3b7;
            border-radius: 8px;
            background-color: #f0f8f8;
        }
        
        .result-title {
            font-size: 16px;
            font-weight: bold;
            color: #2c5530;
            margin-bottom: 15px;
        }
        
        .severity-badge {
            display: inline-block;
            padding: 8px 16px;
            background-color: #dc3545;
            color: white;
            border-radius: 4px;
            font-weight: bold;
            margin-bottom: 10px;
        }
        
        .practice-guidelines {
            background-color: white;
            padding: 15px;
            border-radius: 5px;
            border-left: 4px solid #ffc107;
            margin-top: 10px;
        }
        
        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            text-align: center;
            color: #666;
            font-size: 12px;
        }
        
        .page-break {
            page-break-before: always;
        }
        
        @@media print {
            body {
                margin: 0;
                -webkit-print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <h1>รายงานผลการประเมิน</h1>
        <h2>@(form?.FormName)</h2>
    </div>

    <!-- Patient Information -->
    <div class="info-section">
        <h3 style="margin-top: 0; color: #2c5530;">ข้อมูลผู้ป่วย</h3>
        <div class="info-row">
            <div class="info-label">HN:</div>
            <div class="info-value">@patient?.HN</div>
        </div>
        <div class="info-row">
            <div class="info-label">ชื่อ-นามสกุล:</div>
            <div class="info-value">@(patient?.Title?.TitleName)@(patient?.FirstName) @(patient?.LastName)</div>
        </div>
        <div class="info-row">
            <div class="info-label">ประเภทผู้ป่วย:</div>
            <div class="info-value">@patient?.PatientType</div>
        </div>
        @if (patient?.BirthDate.HasValue == true)
        {
            <div class="info-row">
                <div class="info-label">วันเกิด:</div>
                <div class="info-value">@patient.BirthDate.Value.ToString("dd/MM/yyyy")</div>
            </div>
        }
    </div>

    <!-- Evaluation Information -->
    <div class="info-section">
        <h3 style="margin-top: 0; color: #2c5530;">ข้อมูลการประเมิน</h3>
        <div class="info-row">
            <div class="info-label">แบบประเมิน:</div>
            <div class="info-value">@form?.FormName</div>
        </div>
        <div class="info-row">
            <div class="info-label">ประเภท:</div>
            <div class="info-value">
                @{
                    string formTypeText = form?.FormType switch
                    {
                        1 => "แบบประเมินทั่วไป",
                        2 => "แบบประเมินแจงรายละเอียด",
                        3 => "แบบประเมินชุดคำถาม",
                        _ => "ไม่ระบุ"
                    };
                }
                @formTypeText
            </div>
        </div>
        <div class="info-row">
            <div class="info-label">วันที่ประเมิน:</div>
            <div class="info-value">@Model.RecordDate.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="info-row">
            <div class="info-label">ผู้ประเมิน:</div>
            <div class="info-value">@(user?.Title?.TitleName)@(user?.FirstName) @(user?.LastName)</div>
        </div>
        @if (ViewBag.CalculatedScore != null)
        {
            <div class="info-row">
                <div class="info-label">คะแนนรวม:</div>
                <div class="info-value">@ViewBag.CalculatedScore คะแนน</div>
            </div>
        }
    </div>

    <!-- Questions and Answers -->
    <div class="questions-section">
        <h3 style="color: #2c5530;">รายละเอียดคำตอบ</h3>
        
        @if (Model.EvaluationDetails?.Any() == true)
        {
            @if (form?.FormType == 3)
            {
                // แบบประเมินแบบกลุ่ม - แสดงตาม section
                var groupedQuestions = Model.EvaluationDetails
                    .Where(d => d.Question != null)
                    .GroupBy(d => d.Question!.Section ?? "ทั่วไป")
                    .OrderBy(g => g.Key);

                int globalQuestionIndex = 0;
                
                foreach (var group in groupedQuestions)
                {
                    <h4 style="color: #51c3b7; margin-top: 25px; margin-bottom: 15px;">@group.Key</h4>
                    
                    foreach (var detail in group.OrderBy(d => d.Question!.QuestionID))
                    {
                        globalQuestionIndex++;
                        var question = detail.Question!;
                        var selectedOption = question.Options.FirstOrDefault(o => o.Value == detail.Score);
                        
                        <div class="question-item">
                            <div class="question-number">คำถามที่ @globalQuestionIndex</div>
                            <div class="question-text">@Html.Raw(question.QuestionText?.Replace("\n", "<br>"))</div>
                            
                            <div class="answer-section">
                                @if (selectedOption != null)
                                {
                                    <div class="selected-answer">
                                        ตอบ: @Html.Raw(selectedOption.OptionText?.Replace("\n", "<br>"))
                                        <strong>(@detail.Score คะแนน)</strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="selected-answer">
                                        คะแนน: @detail.Score
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                // แบบประเมินปกติ - แสดงทีละคำถาม
                int questionIndex = 0;
                foreach (var detail in Model.EvaluationDetails.Where(d => d.Question != null).OrderBy(d => d.Question!.QuestionID))
                {
                    questionIndex++;
                    var question = detail.Question!;
                    var selectedOption = question.Options.FirstOrDefault(o => o.Value == detail.Score);
                    
                    <div class="question-item">
                        <div class="question-number">คำถามที่ @questionIndex</div>
                        <div class="question-text">@Html.Raw(question.QuestionText?.Replace("\n", "<br>"))</div>
                        
                        <div class="answer-section">
                            @if (selectedOption != null)
                            {
                                <div class="selected-answer">
                                    ตอบ: @Html.Raw(selectedOption.OptionText?.Replace("\n", "<br>"))
                                    <strong>(@detail.Score คะแนน)</strong>
                                </div>
                            }
                            else
                            {
                                <div class="selected-answer">
                                    คะแนน: @detail.Score
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <p style="text-align: center; color: #666; font-style: italic;">ไม่มีข้อมูลคำตอบ</p>
        }
    </div>

    <!-- Results -->
    <div class="result-section">
        <div class="result-title">ผลการประเมิน</div>
        
        <div style="margin-bottom: 15px;">
            <strong>ระดับความรุนแรง:</strong>
            <div class="severity-badge">@(ViewBag.InterpreterName ?? Model.Result ?? "ไม่ระบุ")</div>
        </div>
        
        @if (!string.IsNullOrEmpty(ViewBag.InterpreterText))
        {
            <div>
                <strong>แนวทางปฏิบัติ:</strong>
                <div class="practice-guidelines">
                    @Html.Raw(((string)ViewBag.InterpreterText).Replace("\n", "<br>"))
                </div>
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="footer">
        <p>สร้างรายงานเมื่อ @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</p>
        <p>ระบบจัดการโรงพยาบาล - แผนกเภสัชกรรม</p>
    </div>

    <script>
        // Auto print when page loads
        window.onload = function() {
            setTimeout(function() {
                window.print();
            }, 500);
        };
    </script>
</body>
</html>
