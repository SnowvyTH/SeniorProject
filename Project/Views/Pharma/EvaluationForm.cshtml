@{
    ViewData["Title"] = "ทำแบบประเมิน";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
    var patient = ViewBag.Patient as Project.Models.Entity.Patient;
    var form = ViewBag.Form as Project.Models.Entity.Form;
    var today = DateTime.Now.ToString("ddddที่ d MMMM yyyy", new System.Globalization.CultureInfo("th-TH"));

}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-clipboard-list me-2 mt-4"></i>@form!.FormName
            </h2>
            <p class="text-muted mb-0">ผู้ป่วย: @($"{patient!.HN} - {patient.Title?.TitleName}{patient.FirstName} {patient.LastName}")</p>
            <p class="text-muted mb-0">วันที่ทำการประเมิน: @today</p>
            <p class="text-muted mb-0">
                <small>
                    <i class="fas fa-calculator me-1"></i>
                    วิธีการนับคะแนน: 
                    @{
                        string scoringText = form.Scoring switch
                        {
                            "max" => "คะแนนสูงสุด",
                            "min" => "คะแนนต่ำสุด", 
                            "sum" => "รวมคะแนน",
                            _ => "รวมคะแนน"
                        };
                        
                        string typeText = form.FormType switch
                        {
                            1 => "แบบประเมินมาตรฐาน",
                            2 => "แบบประเมินข้อความยาว",
                            3 => "แบบประเมินแบบกลุ่ม",
                            _ => "แบบประเมินมาตรฐาน"
                        };
                    }
                    @scoringText
                    <span class="mx-2">•</span>
                    <i class="fas fa-clipboard-list me-1"></i>
                    @typeText
                </small>
            </p>
        </div>
        <div>
            <a href="/Pharma/Evaluation" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>กลับ
            </a>
        </div>
    </div>

    <!-- Progress Bar -->
    <div class="row">
        <!-- Questions Form -->
        <div class="col-md-8">
            <form id="evaluationForm">
                <input type="hidden" id="patientId" value="@patient.HN">
                <input type="hidden" id="formId" value="@form.FormID">
                
                <!-- Question Container -->
                <div id="questionContainer">
                    @if (form.FormType == 3)
                    {
                        <!-- Type 3: Section/Group based questions -->
                        var questionGroups = form.Questions.OrderBy(q => q.QuestionID).GroupBy(q => q.Section ?? "ทั่วไป");
                        int globalQuestionIndex = 0;
                        
                        @foreach (var group in questionGroups)
                        {
                            @foreach (var question in group.OrderBy(q => q.QuestionID))
                            {
                                globalQuestionIndex++;
                                <div class="question-slide modern-card mb-4" data-question-index="@(globalQuestionIndex - 1)" style="display: none;">
                                    <div class="card-header section-header">
                                        <h5 class="mb-1">
                                            <i class="fas fa-layer-group me-2"></i>
                                            @group.Key
                                        </h5>
                                        <small class="text-white-50">คำถามที่ @globalQuestionIndex</small>
                                    </div>
                                    <div class="card-body">
                                        <div class="question-text mb-4">
                                            <h6 class="fw-bold">@Html.Raw(question.QuestionText.Replace("\n", "<br>"))</h6>
                                        </div>
                                        
                                        <div class="choices-container">
                                            @foreach (var choice in question.Options.OrderBy(c => c.OptionID))
                                            {
                                                <div class="form-check choice-item" onclick="selectChoice('choice_@choice.OptionID')">
                                                    <input class="form-check-input" type="radio" 
                                                           name="question_@question.QuestionID" 
                                                           id="choice_@choice.OptionID"
                                                           value="@choice.Value"
                                                           data-question="@question.QuestionID"
                                                           onchange="updateProgress(); updateQuestionStatus(@(globalQuestionIndex - 1))">
                                                    <label class="form-check-label" for="choice_@choice.OptionID">
                                                        @Html.Raw(choice.OptionText.Replace("\n", "<br>"))
                                                        <span class="badge bg-secondary ms-2">@choice.Value</span>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <!-- Type 1 & 2: Individual questions -->
                        int questionIndex = 0;
                        @foreach (var question in form.Questions.OrderBy(q => q.QuestionID))
                        {
                            <div class="question-slide modern-card mb-4" data-question-index="@questionIndex" style="display: none;">
                                <div class="card-header">
                                    <h6 class="mb-0">
                                        <i class="fas fa-question-circle me-2"></i>
                                        คำถามที่ @(questionIndex + 1)
                                    </h6>
                                </div>
                                <div class="card-body">
                                    @if (form.FormType == 2)
                                    {
                                        <!-- Type 2: Multi-line text support -->
                                        <div class="question-text mb-4">
                                            <h6 class="fw-bold">@Html.Raw(question.QuestionText.Replace("\n", "<br>"))</h6>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Type 1: Single line text -->
                                        <div class="question-text mb-4">
                                            <h6 class="fw-bold">@question.QuestionText</h6>
                                        </div>
                                    }
                                    
                                    <div class="choices-container">
                                        @foreach (var choice in question.Options.OrderBy(c => c.OptionID))
                                        {
                                            <div class="form-check choice-item" onclick="selectChoice('choice_@choice.OptionID')">
                                                <input class="form-check-input" type="radio" 
                                                       name="question_@question.QuestionID" 
                                                       id="choice_@choice.OptionID"
                                                       value="@choice.Value"
                                                       data-question="@question.QuestionID"
                                                       onchange="updateProgress(); updateQuestionStatus(@questionIndex)">
                                                <label class="form-check-label" for="choice_@choice.OptionID">
                                                    @if (form.FormType == 2)
                                                    {
                                                        @Html.Raw(choice.OptionText.Replace("\n", "<br>"))
                                                    }
                                                    else
                                                    {
                                                        @choice.OptionText
                                                    }
                                                    <span class="badge bg-info ms-2">@choice.Value คะแนน</span>
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            questionIndex++;
                        }
                    }
                </div>
                
                <!-- Navigation Buttons -->
                <div class="d-flex justify-content-between mt-4 mb-4">
                    <button type="button" class="btn btn-outline-secondary" id="prevBtn" onclick="previousQuestion()" style="display: none;">
                        <i class="fas fa-chevron-left me-2"></i>หน้าก่อนนี้
                    </button>
                    <div></div>
                    <button type="button" class="btn btn-primary" id="nextBtn" onclick="nextQuestion()">
                        หน้าถัดไป<i class="fas fa-chevron-right ms-2"></i>
                    </button>
                    <button type="button" class="btn btn-success btn-lg" id="submitBtn" onclick="submitEvaluation()" style="display: none;">
                        <i class="fas fa-save me-2"></i>สิ้นสุดการทำแบบประเมิน
                    </button>
                </div>
            </form>
        </div>
        
        <!-- Progress Bar Sidebar -->
        <div class="col-md-4">
            <!-- Page Navigation -->
            <div class="modern-card sticky-top mb-3" style="top: 20px;">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-map me-2"></i>นำทางหน้า
                    </h6>
                </div>
                <div class="card-body">
                    <div class="page-grid" id="pageNavigation">
                        <!-- Page buttons will be generated by JavaScript -->
                    </div>
                    <div class="mt-2 text-center">
                        <small class="text-muted">คลิกเพื่อไปยังหน้าที่ต้องการ</small>
                    </div>
                </div>
            </div>
            
            <div class="modern-card sticky-top" style="top: 140px;">
                <div class="card-header">
                    <h6 class="mb-0">
                        <i class="fas fa-chart-line me-2"></i>ความคืบหน้า
                    </h6>
                </div>
                <div class="card-body">                    
                    <div class="progress mb-3">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: 0%" 
                             id="progressBar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    
                    <div class="text-center">
                        <p class="mb-1">
                            <span class="fw-bold" id="answeredCount">0</span> / @form.Questions.Count คำถาม
                        </p>
                        <small class="text-muted">ที่ตอบแล้ว</small>
                    </div>
                    
                    <div class="mt-3 pt-3 border-top">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            กรุณาตอบคำถามให้ครบทุกข้อ
                        </small>
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="fas fa-calculator me-1"></i>
                                วิธีการนับ: @scoringText
                            </small>
                        </div>
                        <div class="mt-1">
                            <small class="text-muted">
                                <i class="fas fa-clipboard-list me-1"></i>
                                ประเภท: @typeText
                            </small>
                        </div>
                        <div class="mt-2">
                            <small class="text-muted">
                                <i class="fas fa-eye me-1"></i>
                                หน้าปัจจุบัน: <span id="currentPageDisplay">1</span> / @form.Questions.Count
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --mint-green: #51c3b7;
            --dark-green: #05685e;
        }

        .modern-card {
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border: none;
        }

        .modern-card .card-header {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border-bottom: none;
            font-weight: 600;
            padding: 1rem 1.5rem;
        }

        .modern-card .card-body {
            padding: 1.5rem;
        }

        .question-text {
            font-size: 1.1rem;
            font-weight: 500;
            color: #333;
        }

        .choice-item {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .choice-item:hover {
            background: rgba(81, 195, 183, 0.1);
            border-color: var(--mint-green);
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(81, 195, 183, 0.2);
        }

        .choice-item input[type="radio"]:checked + label {
            color: var(--dark-green);
            font-weight: 600;
        }

        .choice-item input[type="radio"]:checked {
            background-color: var(--mint-green);
            border-color: var(--mint-green);
        }

        /* Selected choice item styling */
        .choice-item input[type="radio"]:checked ~ *,
        .choice-item:has(input[type="radio"]:checked) {
            background: rgba(81, 195, 183, 0.15) !important;
            border-color: var(--mint-green) !important;
            box-shadow: 0 2px 8px rgba(81, 195, 183, 0.3) !important;
        }

        /* Alternative fallback for browsers that don't support :has() */
        .choice-item.selected {
            background: rgba(81, 195, 183, 0.15) !important;
            border-color: var(--mint-green) !important;
            box-shadow: 0 2px 8px rgba(81, 195, 183, 0.3) !important;
        }

        .form-check-input:checked {
            background-color: var(--mint-green);
            border-color: var(--mint-green);
        }

        .form-check-input:focus {
            border-color: var(--mint-green);
            box-shadow: 0 0 0 0.2rem rgba(81, 195, 183, 0.25);
        }

        .progress {
            height: 20px;
        }
        
        .progress-bar {
            transition: width 0.5s ease;
            font-weight: 600;
        }

        .progress-circle-container {
            display: flex;
            justify-content: center;
            margin-bottom: 1rem;
        }

        .progress-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: conic-gradient(var(--mint-green) 0deg, #e9ecef 0deg);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: background 0.5s ease;
        }

        .progress-circle::before {
            content: '';
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: white;
            position: absolute;
        }

        .progress-circle span {
            position: relative;
            z-index: 1;
            font-weight: 700;
            font-size: 1rem;
            color: var(--dark-green);
        }

        .sticky-top {
            position: sticky !important;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        .btn-success {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            border: none;
        }

        .btn-success:hover {
            background: linear-gradient(135deg, #20c997 0%, #28a745 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        }

        .page-title {
            color: var(--dark-green);
            font-weight: 700;
        }

        .badge {
            font-size: 0.75rem;
        }

        .bg-info {
            background-color: var(--mint-green) !important;
        }

        /* Type 3 Specific Styles */
        .section-card {
            border-left: 5px solid var(--mint-green);
        }

        .section-header {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
        }

        .question-group {
            margin-left: 1rem;
        }

        .question-number {
            color: var(--dark-green);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .choices-container-type3 {
            margin-left: 1.5rem;
        }

        .choice-item-type3 {
            background: #f8f9fa;
            border-radius: 6px;
            padding: 0.5rem 0.75rem;
            margin-bottom: 0.4rem;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }

        .choice-item-type3:hover {
            background: rgba(81, 195, 183, 0.1);
            border-left-color: var(--mint-green);
        }

        .choice-item-type3 input[type="radio"]:checked + label {
            color: var(--dark-green);
            font-weight: 600;
        }

        .badge.bg-secondary {
            background-color: #6c757d !important;
        }

        /* Question Navigation Styles */
        .question-nav-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem;
            margin-bottom: 0.25rem;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 1px solid transparent;
        }

        .question-nav-item:hover {
            background: rgba(81, 195, 183, 0.1);
            border-color: var(--mint-green);
        }

        .question-nav-item.active {
            background: var(--mint-green);
            color: white;
        }

        .question-nav-item.answered {
            background: rgba(40, 167, 69, 0.1);
            border-color: #28a745;
        }

        .question-nav-item.answered .question-status i {
            color: #28a745;
        }

        .question-number {
            font-weight: 600;
            min-width: 20px;
        }

        .section-title {
            color: var(--dark-green);
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            padding-bottom: 0.25rem;
            border-bottom: 1px solid #dee2e6;
        }

        .section-nav {
            border-left: 3px solid var(--mint-green);
            padding-left: 0.5rem;
        }

        /* Question Slide Styles */
        .question-slide {
            min-height: 400px;
        }

        .question-text h6 {
            color: #333;
            line-height: 1.6;
        }

        /* Page Navigation Grid */
        .page-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 0.5rem;
        }

        .page-btn {
            aspect-ratio: 1;
            border: 1px solid #dee2e6;
            background: white;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .page-btn:hover {
            background: rgba(81, 195, 183, 0.1);
            border-color: var(--mint-green);
        }

        .page-btn.current {
            background: var(--mint-green);
            color: white;
            border-color: var(--mint-green);
        }

        .page-btn.answered {
            background: rgba(40, 167, 69, 0.1);
            border-color: #28a745;
            color: #28a745;
        }

        .page-btn.answered.current {
            background: #28a745;
            color: white;
            border-color: #28a745;
        }

        /* Navigation Button Styles */
        .btn {
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentQuestionIndex = 0;
        const totalQuestions = @form.Questions.Count;

        $(document).ready(function() {
            initializeQuestionNavigation();
            showQuestion(0);
            updateProgress();
            generatePageNavigation();
            
            // Add click event for choice items
            $(document).on('click', '.choice-item', function(e) {
                // Prevent double triggering if user clicks on radio button or label
                if (e.target.type !== 'radio' && !$(e.target).is('label')) {
                    const radioButton = $(this).find('input[type="radio"]');
                    if (radioButton.length) {
                        radioButton.prop('checked', true);
                        radioButton.trigger('change');
                    }
                }
            });
            
            // Handle radio button change events to update styling
            $(document).on('change', 'input[type="radio"]', function() {
                // Remove selected class from all choice items in the same question
                const questionName = $(this).attr('name');
                $(`input[name="${questionName}"]`).closest('.choice-item').removeClass('selected');
                
                // Add selected class to the current choice item
                $(this).closest('.choice-item').addClass('selected');
            });
        });

        function selectChoice(choiceId) {
            const radioButton = $('#' + choiceId);
            if (radioButton.length) {
                radioButton.prop('checked', true);
                radioButton.trigger('change');
            }
        }

        function initializeQuestionNavigation() {
            // Hide all questions initially
            $('.question-slide').hide();
            
            // Reset current question index to 0
            currentQuestionIndex = 0;
            
            // Show first question
            showQuestion(0);
        }

        function showQuestion(index) {
            // Hide all questions
            $('.question-slide').hide();
            
            // Show current question
            $(`.question-slide[data-question-index="${index}"]`).show();
            
            // Update current question index
            currentQuestionIndex = index;
            
            // Update navigation
            updateNavigation();
            updateCurrentPageDisplay();
            
            // Update active state in question navigation
            $('.question-nav-item').removeClass('active');
            $(`.question-nav-item[data-question-index="${index}"]`).addClass('active');
            
            // Update page navigation
            updatePageNavigation();
        }

        function updateNavigation() {
            const prevBtn = $('#prevBtn');
            const nextBtn = $('#nextBtn');
            const submitBtn = $('#submitBtn');
            
            // Show/hide previous button
            if (currentQuestionIndex === 0) {
                prevBtn.hide();
            } else {
                prevBtn.show();
            }
            
            // Show/hide next/submit button
            if (currentQuestionIndex === totalQuestions - 1) {
                nextBtn.hide();
                submitBtn.show();
            } else {
                nextBtn.show();
                submitBtn.hide();
            }
        }

        function previousQuestion() {
            if (currentQuestionIndex > 0) {
                showQuestion(currentQuestionIndex - 1);
            }
        }

        function nextQuestion() {
            if (currentQuestionIndex < totalQuestions - 1) {
                showQuestion(currentQuestionIndex + 1);
            }
        }

        function goToQuestion(index) {
            if (index >= 0 && index < totalQuestions) {
                showQuestion(index);
            }
        }

        function updateQuestionStatus(questionIndex) {
            // Mark question as answered in navigation
            const navItem = $(`.question-nav-item[data-question-index="${questionIndex}"]`);
            navItem.addClass('answered');
            navItem.find('.question-status i').removeClass('text-muted').addClass('text-success');
            
            // Update page navigation
            updatePageNavigation();
        }

        function generatePageNavigation() {
            const pageNavigation = $('#pageNavigation');
            pageNavigation.empty();
            
            for (let i = 0; i < totalQuestions; i++) {
                const pageBtn = $(`
                    <div class="page-btn" data-page="${i}" onclick="goToQuestion(${i})">
                        ${i + 1}
                    </div>
                `);
                pageNavigation.append(pageBtn);
            }
            
            // Set first question as active by default
            updatePageNavigation();
        }

        function updatePageNavigation() {
            $('.page-btn').removeClass('current answered');
            
            // Mark current page
            $(`.page-btn[data-page="${currentQuestionIndex}"]`).addClass('current');
            
            // Mark answered pages
            $('input[type="radio"]:checked').each(function() {
                const questionElement = $(this).closest('.question-slide');
                const questionIndex = questionElement.data('question-index');
                $(`.page-btn[data-page="${questionIndex}"]`).addClass('answered');
            });
            
            // Maintain current page styling even if answered
            $(`.page-btn[data-page="${currentQuestionIndex}"]`).addClass('current');
        }

        function updateCurrentPageDisplay() {
            $('#currentPageDisplay').text(currentQuestionIndex + 1);
        }

        function getScoringMethodText(method) {
            switch(method) {
                case 'max':
                    return 'คะแนนสูงสุด';
                case 'min':
                    return 'คะแนนต่ำสุด';
                case 'sum':
                    return 'รวมคะแนน';
                default:
                    return 'รวมคะแนน';
            }
        }

        function updateProgress() {
            const totalQuestions = @form.Questions.Count;
            const answeredQuestions = $('input[type="radio"]:checked').length;
            const percentage = Math.round((answeredQuestions / totalQuestions) * 100);
            
            // Update progress bar
            $('#progressBar').css('width', percentage + '%');
            $('#progressText').text(percentage + '%');
            $('#answeredCount').text(answeredQuestions);
            
            // Update progress circle
            const degrees = (percentage / 100) * 360;
            const progressCircle = $('#progressCircle');
            
            if (percentage === 0) {
                progressCircle.css('background', `conic-gradient(#e9ecef 0deg)`);
            } else {
                let color = '#dc3545'; // Red
                if (percentage >= 50 && percentage < 100) {
                    color = '#ffc107'; // Yellow
                } else if (percentage === 100) {
                    color = '#28a745'; // Green
                }
                
                progressCircle.css('background', 
                    `conic-gradient(${color} ${degrees}deg, #e9ecef ${degrees}deg)`
                );
            }
            
            // Update progress bar color
            if (percentage < 50) {
                $('#progressBar').removeClass('bg-warning bg-success').addClass('bg-danger');
            } else if (percentage < 100) {
                $('#progressBar').removeClass('bg-danger bg-success').addClass('bg-warning');
            } else {
                $('#progressBar').removeClass('bg-danger bg-warning').addClass('bg-success');
            }
        }

        // Keyboard navigation
        $(document).keydown(function(e) {
            if (e.key === 'ArrowLeft' && currentQuestionIndex > 0) {
                e.preventDefault();
                previousQuestion();
            } else if (e.key === 'ArrowRight' && currentQuestionIndex < totalQuestions - 1) {
                e.preventDefault();
                nextQuestion();
            } else if (e.key === 'Enter' && currentQuestionIndex === totalQuestions - 1) {
                e.preventDefault();
                submitEvaluation();
            }
        });

        function submitEvaluation() {
            const totalQuestions = @form.Questions.Count;
            const answeredQuestions = $('input[type="radio"]:checked').length;
            
            if (answeredQuestions < totalQuestions) {
                Swal.fire({
                    icon: 'warning',
                    title: 'คำถามยังไม่ครบ',
                    text: `กรุณาตอบคำถามให้ครบทั้ง ${totalQuestions} ข้อ (ตอบแล้ว ${answeredQuestions} ข้อ)`,
                    confirmButtonColor: '#ffc107'
                });
                return;
            }

            // Collect answers
            const answers = [];
            const scores = [];
            
            $('input[type="radio"]:checked').each(function() {
                const questionId = parseInt($(this).data('question'));
                const score = parseInt($(this).val());
                
                answers.push({
                    QuestionId: questionId,
                    Score: score
                });
                
                scores.push(score);
            });

            answers.sort((a, b) => a.QuestionId - b.QuestionId);
            answers.forEach(ans => {
            });

            const scoringMethod = '@form.Scoring'; 
            let finalScore = 0;
            let result = '';
            let resultText = '';
            
            switch(scoringMethod) {
                case 'aims':
                    // เฉพาะเจาะจงสำหรับ AIMS
                    // สมมติว่าข้อ 1-7 คือ QuestionID 1-7 และข้อ 8 คือ QuestionID 8
                    const faceMouthQuestions = answers.filter(a => a.QuestionId >= 50 && a.QuestionId <= 53); // ข้อ 1-4 ใบหน้าและปาก
                    const movementQuestions = answers.filter(a => a.QuestionId >= 50 && a.QuestionId <= 56); // ข้อ 1-7
                    const q8 = answers.find(a => a.QuestionId === 57); // ข้อ 8
                    const totalQ1to7 = movementQuestions.reduce((sum, a) => sum + a.Score, 0);

                    let conditions = [];

                    //1.เมื่อคะแนนประเมินผลตั้งแต่ 1 คะแนนขึ้นไป โดยเฉพาะการเคลื่อนไหวผิดปกติที่ใบหน้าและปาก ควร consult แพทย์เพื่อปรับแผนการรักษา
                    if (faceMouthQuestions.some(a => a.Score >= 1)) {
                        conditions.push("ควร Consult แพทย์เพื่อปรับแผนการรักษา");
                    }
                    
                    //2.หากมีข้อที่ได้ 2 คะแนนใน 2 ข้อขึ้นไปหรือมีข้อที่ได้คะแนน 3 หรือ 4 คะแนนเพียงหนึ่งข้อ บ่งชี้ว่า ผู้ป่วยมี Tardive dyskinesia
                    const countScore = movementQuestions.filter(a => a.Score === 2).length;
                    if (movementQuestions.some(a => a.Score >= 3) || countScore >= 2) {
                        conditions.push("ผู้ป่วยมี Tardive dyskinesia");
                    }
                    
                    //3.การติดตามประเมินผลการรักษาพิจารณาจาก ข้อ 8 ความรุนแรงของการเคลื่อนไหวผิกปกติทั้งหมด และ รวมคะแนนข้อ 1-7
                    if (q8 && totalQ1to7 > 0) {
                        // ดึง OptionText ของข้อ 8 จากตัวเลือกที่เลือก (ทำความสะอาดข้อความ)
                        const q8ConditionLabel = $(`input[name="question_57"]:checked`).next('label').clone();
                        q8ConditionLabel.find('.badge').remove(); // ลบ badge ออก
                        const q8OptionText = q8ConditionLabel.text().trim();
                        
                    }

                    // กำหนด result ตามคำตอบของข้อ 8 และ resultText ตามลำดับความสำคัญ
                    if (q8) {
                        // ใช้คำตอบของข้อ 8 เป็น result (ใช้ QuestionID 57)
                        const q8Option = $(`input[name="question_57"]:checked`).next('label').clone();
                        // ลบ badge ออกก่อนแล้วดึงข้อความ
                        q8Option.find('.badge').remove();
                        const q8OptionText = q8Option.text().trim();
                        
                        result = q8OptionText || `คะแนน ${q8.Score}`;
                        finalScore = q8.Score; // ใช้คะแนนข้อ 8 เป็น finalScore

                    }

                    // รวม resultText ตามลำดับความสำคัญ 1>2>3
                    if (conditions.length > 0) {
                        resultText = conditions.join(' และ ');
                    } else {
                        resultText = 'ไม่พบความผิดปกติ';
                    }
                    
                    break;
                case 'max':
                    finalScore = Math.max(...scores);
                    break;
                case 'min':
                    finalScore = Math.min(...scores);
                    break;
                case 'sum':
                default:
                    finalScore = scores.reduce((sum, score) => sum + score, 0);
                    break;
            }

            if (scoringMethod !== 'aims') {
                const interpreters = @Html.Raw(Json.Serialize(form.Interpreters.Select(i => new { 
                    minScore = i.MinScore, 
                    maxScore = i.MaxScore, 
                    interName = i.InterName, 
                    interText = i.InterText 
                }).OrderBy(i => i.minScore)));
                
                result = 'ไม่สามารถประเมินผลได้';
                resultText = '';
                
                for (let interpreter of interpreters) {
                    if (finalScore >= interpreter.minScore && finalScore <= interpreter.maxScore) {
                        result = interpreter.interName || `ระดับ ${interpreter.minScore}-${interpreter.maxScore}`;
                        resultText = interpreter.interText || '';
                        break;
                    }
                }
            }

            // Create submission data with scoring method info
            const submissionData = {
                PatientId: $('#patientId').val(),
                FormId: parseInt($('#formId').val()),
                Result: result,
                ResultDetail: resultText, // เปลี่ยนจาก ResultText เป็น ResultDetail
                FinalScore: finalScore,
                ScoringMethod: scoringMethod,
                Answers: answers
            };

            // Show loading
            Swal.fire({
                title: 'กำลังบันทึก...',
                text: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Submit to server
            $.ajax({
                url: '/Pharma/SubmitEvaluation',
                type: 'POST',
                data: JSON.stringify(submissionData),
                contentType: 'application/json',
                success: function(result) {
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'สำเร็จ!',
                            text: 'บันทึกผลการประเมินเรียบร้อยแล้ว',
                            confirmButtonColor: '#28a745'
                        }).then(() => {
                            window.location.href = '/Pharma/';
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: result.message || 'ไม่สามารถบันทึกผลการประเมินได้'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้'
                    });
                }
            });
        }
    </script>
}
