@{
    ViewData["Title"] = "แก้ไขข้อมูลส่วนตัว";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-user-edit me-2 mt-4"></i>แก้ไขข้อมูลส่วนตัว
            </h2>
            <p class="text-muted mb-0">จัดการข้อมูลส่วนตัวและรหัสผ่านของคุณ</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 mx-auto">
            <!-- Profile Information Card -->
            <div class="modern-card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-user me-2"></i>ข้อมูลส่วนตัว
                    </h5>
                </div>
                <div class="card-body">
                    <form id="profileForm">
                        <div class="row">
                            <!-- Profile Picture Section -->
                            <div class="col-md-4 text-center">
                                <div class="profile-picture-section">
                                    <div class="profile-picture-container" id="profilePictureContainer">
                                        <div class="profile-picture-placeholder" id="profilePicturePlaceholder">
                                            <i class="fas fa-user fa-3x"></i>
                                        </div>
                                        <img id="profilePictureImg" class="profile-picture-img" style="display: none;" />
                                    </div>
                                    <div class="mt-3">
                                        <input type="file" id="profilePictureInput" accept="image/*" style="display: none;">
                                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="$('#profilePictureInput').click()">
                                            <i class="fas fa-camera"></i> เปลี่ยนรูปภาพ
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm ms-2" id="removePictureBtn" style="display: none;" onclick="removeProfilePicture()">
                                            <i class="fas fa-trash"></i> ลบรูป
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Profile Form -->
                            <div class="col-md-8">
                                <div class="row g-3">
                                    <!-- Username (Read-only) -->
                                    <div class="col-md-12">
                                        <label class="form-label fw-bold">ชื่อผู้ใช้</label>
                                        <input type="text" class="form-control bg-light" id="username" readonly>
                                        <small class="form-text text-muted">ไม่สามารถแก้ไขชื่อผู้ใช้ได้</small>
                                    </div>

                                    <!-- Title -->
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">คำนำหน้า</label>
                                        <select class="form-select" id="titleId" required>
                                            <option value="">เลือกคำนำหน้า</option>
                                            <!-- จะถูกเติมด้วย JavaScript -->
                                        </select>
                                    </div>

                                    <!-- First Name -->
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">ชื่อจริง</label>
                                        <input type="text" class="form-control" id="firstName" placeholder="กรอกชื่อจริง" required>
                                    </div>

                                    <!-- Last Name -->
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">นามสกุล</label>
                                        <input type="text" class="form-control" id="lastName" placeholder="กรอกนามสกุล" required>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Password Change Card -->
            <div class="modern-card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-lock me-2"></i>เปลี่ยนรหัสผ่าน
                    </h5>
                </div>
                <div class="card-body">
                    <form id="passwordForm">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            หากไม่ต้องการเปลี่ยนรหัสผ่าน สามารถเว้นช่องนี้ไว้ได้
                        </div>
                        
                        <div class="row g-3">
                            <!-- Current Password -->
                            <div class="col-md-12">
                                <label class="form-label fw-bold">รหัสผ่านปัจจุบัน</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="currentPassword" placeholder="กรอกรหัสผ่านปัจจุบัน">
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('currentPassword')">
                                        <i class="fas fa-eye" id="currentPasswordIcon"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- New Password -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">รหัสผ่านใหม่</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="newPassword" placeholder="กรอกรหัสผ่านใหม่">
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('newPassword')">
                                        <i class="fas fa-eye" id="newPasswordIcon"></i>
                                    </button>
                                </div>
                                <small class="form-text text-muted">รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร</small>
                            </div>

                            <!-- Confirm New Password -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">ยืนยันรหัสผ่านใหม่</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="confirmPassword" placeholder="ยืนยันรหัสผ่านใหม่">
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('confirmPassword')">
                                        <i class="fas fa-eye" id="confirmPasswordIcon"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end mt-4 gap-2">
                <button type="button" class="btn btn-secondary" onclick="resetForm()">
                    <i class="fas fa-undo me-2"></i>รีเซ็ต
                </button>
                <button type="button" class="btn btn-primary" onclick="saveProfile()">
                    <i class="fas fa-save me-2"></i>บันทึกการเปลี่ยนแปลง
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Image Crop Modal -->
<div class="modal fade crop-modal" id="imageCropModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-crop me-2"></i>ปรับขนาดรูปภาพ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-8">
                        <div class="crop-container" id="cropContainer">
                            <!-- Canvas will be inserted here -->
                        </div>
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                คลิกและลากเพื่อเลื่อนพื้นที่ครอบ | ใช้ล้อเมาส์เพื่อปรับขนาด
                            </small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center">
                            <h6>ตัวอย่าง</h6>
                            <div class="crop-preview" id="cropPreview">
                                <img id="previewImg" src="" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>ยกเลิก
                </button>
                <button type="button" class="btn btn-primary" onclick="confirmCrop()">
                    <i class="fas fa-check me-2"></i>ยืนยัน
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --mint-green: #51c3b7;
            --dark-green: #05685e;
        }

        .modern-card {
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border: none;
        }

        .modern-card .card-header {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border-bottom: none;
            font-weight: 600;
            padding: 1rem 1.5rem;
        }

        .modern-card .card-body {
            padding: 1.5rem;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #e0e6ed;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--mint-green);
            box-shadow: 0 0 0 0.2rem rgba(81, 195, 183, 0.25);
        }

        .form-control.bg-light {
            background-color: #f8f9fa !important;
            cursor: not-allowed;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--dark-green) 0%, var(--mint-green) 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(81, 195, 183, 0.3);
        }

        .alert-info {
            background-color: rgba(81, 195, 183, 0.1);
            border-color: var(--mint-green);
            color: var(--dark-green);
            border-radius: 8px;
        }

        .page-title {
            color: var(--dark-green);
            font-weight: 700;
        }

        .input-group .btn {
            border-color: #e0e6ed;
        }

        .input-group .btn:hover {
            background-color: var(--mint-green);
            border-color: var(--mint-green);
            color: white;
        }

        .form-text {
            font-size: 0.875rem;
        }

        .profile-picture-section {
            margin-bottom: 2rem;
        }

        .profile-picture-container {
            width: 150px;
            height: 150px;
            margin: 0 auto 1rem;
            position: relative;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid var(--mint-green);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-picture-placeholder {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dark-green);
        }

        .profile-picture-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .crop-modal .modal-dialog {
            max-width: 600px;
        }

        .crop-container {
            width: 100%;
            height: 400px;
            border: 1px solid #ddd;
            border-radius: 8px;
            position: relative;
            overflow: hidden;
            background: #f8f9fa;
        }

        .crop-preview {
            width: 150px;
            height: 150px;
            border: 2px solid var(--mint-green);
            border-radius: 50%;
            overflow: hidden;
            margin: 0 auto;
        }

        .crop-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentImageElement = null;
        let imageCropper = null;

        $(document).ready(function() {
            // Load titles first, then load user profile
            loadTitles();
            
            // Add a fallback timer in case the API calls fail
            setTimeout(function() {
                if (!$('#username').val()) {
                    loadUserProfileData();
                }
            }, 2000);

            // Handle file input change
            $('#profilePictureInput').on('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    handleImageUpload(file);
                }
                // Reset input to allow same file selection
                this.value = '';
            });
        });

        function loadUserProfile() {
            $.get('/Pharma/GetUserProfile')
                .done(function(data) {
                    if (data.success) {
                        $('#username').val(data.username);
                        $('#titleId').val(data.titleID);
                        $('#firstName').val(data.firstName);
                        $('#lastName').val(data.lastName);
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: data.message || 'ไม่สามารถโหลดข้อมูลผู้ใช้ได้'
                        });
                    }
                })
                .fail(function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถโหลดข้อมูลผู้ใช้ได้'
                    });
                });
        }

        function loadTitles() {
            $.get('/Pharma/GetTitles')
                .done(function(titles) {
                    const select = $('#titleId');
                    // Clear existing options except the first one
                    select.find('option:not(:first)').remove();
                    
                    titles.forEach(title => {
                        select.append(`<option value="${title.titleID}">${title.titleName}</option>`);
                    });
                    
                    // Reload user profile after titles are loaded to set the correct selected title
                    loadUserProfileData();
                })
                .fail(function(xhr, status, error) {
                    console.error('Error loading titles:', xhr.responseText);
                    // Try to load user profile anyway even if titles fail
                    loadUserProfileData();
                });
        }

        function handleImageUpload(file) {
            // Validate file type
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
            if (!allowedTypes.includes(file.type)) {
                Swal.fire({
                    icon: 'error',
                    title: 'รูปแบบไฟล์ไม่ถูกต้อง',
                    text: 'กรุณาเลือกไฟล์รูปภาพ (jpg, jpeg, png, gif)'
                });
                return;
            }

            // Validate file size (5MB)
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire({
                    icon: 'error',
                    title: 'ขนาดไฟล์ใหญ่เกินไป',
                    text: 'ขนาดไฟล์ต้องไม่เกิน 5MB'
                });
                return;
            }

            // Show simple confirmation for now (without cropping)
            const reader = new FileReader();
            reader.onload = function(e) {
                showImagePreview(e.target.result, file);
            };
            reader.readAsDataURL(file);
        }

        function showImagePreview(imageSrc, file) {
            Swal.fire({
                title: 'ยืนยันการเปลี่ยนรูปภาพ',
                html: `
                    <div class="text-center">
                        <img src="${imageSrc}" style="max-width: 200px; max-height: 200px; border-radius: 50%; object-fit: cover; border: 3px solid var(--mint-green);">
                        <p class="mt-3">คุณต้องการใช้รูปภาพนี้หรือไม่?</p>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#51c3b7',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'ใช้รูปนี้',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    uploadProfilePicture(file);
                }
            });
        }

        function uploadProfilePicture(file) {
            // Show loading
            Swal.fire({
                title: 'กำลังบันทึกรูปภาพ...',
                text: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Create FormData to send file
            const formData = new FormData();
            formData.append('profilePicture', file);

            $.ajax({
                url: '/Pharma/UploadProfilePicture',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        // Update profile picture display
                        updateProfilePictureDisplay(response.pictureUrl);
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ',
                            text: response.message,
                            timer: 2000
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถบันทึกรูปภาพได้'
                    });
                }
            });
        }

        function updateProfilePictureDisplay(pictureUrl) {
            const timestamp = new Date().getTime();
            const imageUrl = pictureUrl + '?t=' + timestamp;
            
            $('#profilePicturePlaceholder').hide();
            $('#profilePictureImg').attr('src', imageUrl).show();
            $('#removePictureBtn').show();
            
            // Update navbar avatar using global function
            if (typeof window.updateNavbarAvatar === 'function') {
                window.updateNavbarAvatar(imageUrl);
            }
            
            // Also force refresh from server to ensure consistency
            if (typeof window.forceRefreshNavbarAvatar === 'function') {
                setTimeout(function() {
                    window.forceRefreshNavbarAvatar();
                }, 500); // Small delay to ensure file is saved
            }
        }

        function updateNavbarAvatar(imageUrl) {
            // Find all navbar avatars and update them
            const navbarAvatars = $('.user-avatar, .avatar-circle');
            navbarAvatars.each(function() {
                const $avatar = $(this);
                
                // Remove existing image if any
                $avatar.find('img').remove();
                
                // Add new image
                const $img = $('<img>')
                    .attr('src', imageUrl)
                    .addClass('avatar-img')
                    .css({
                        'width': '100%',
                        'height': '100%',
                        'object-fit': 'cover',
                        'border-radius': '50%'
                    });
                
                $avatar.empty().append($img);
            });
        }

        function resetNavbarAvatar() {
            // Find all navbar avatars and reset to initials
            const navbarAvatars = $('.user-avatar, .avatar-circle');
            navbarAvatars.each(function() {
                const $avatar = $(this);
                
                // Remove existing image
                $avatar.find('img').remove();
                
                // Reset to initials if data exists
                const initials = $avatar.data('initials') || 'U';
                $avatar.text(initials);
            });
        }

        function removeProfilePicture() {
            Swal.fire({
                title: 'ยืนยันการลบรูปภาพ',
                text: 'คุณต้องการลบรูปภาพโปรไฟล์หรือไม่?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loading
                    Swal.fire({
                        title: 'กำลังลบรูปภาพ...',
                        text: 'กรุณารอสักครู่',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Call API to remove picture
                    $.ajax({
                        url: '/Pharma/RemoveProfilePicture',
                        type: 'POST',
                        success: function(response) {
                            if (response.success) {
                                $('#profilePictureImg').hide();
                                $('#profilePicturePlaceholder').show();
                                $('#removePictureBtn').hide();
                                
                                // Update navbar avatar to show initials using global function
                                if (typeof window.resetNavbarAvatar === 'function') {
                                    window.resetNavbarAvatar();
                                }
                                
                                Swal.fire({
                                    icon: 'success',
                                    title: 'ลบรูปภาพสำเร็จ',
                                    text: response.message,
                                    timer: 1500
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: response.message
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: 'ไม่สามารถลบรูปภาพได้'
                            });
                        }
                    });
                }
            });
        }

        function loadUserProfileData() {
            $.get('/Pharma/GetUserProfile')
                .done(function(data) {
                    if (data.success) {
                        $('#username').val(data.username || '');
                        $('#firstName').val(data.firstName || '');
                        $('#lastName').val(data.lastName || '');
                        
                        // Set title after options are loaded
                        if (data.titleID && data.titleID > 0) {
                            $('#titleId').val(data.titleID);
                        } else {
                            $('#titleId').val(''); // Reset to default
                        }

                        // Load profile picture if exists
                        if (data.profilePictureUrl) {
                            updateProfilePictureDisplay(data.profilePictureUrl);
                        }
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: data.message || 'ไม่สามารถโหลดข้อมูลผู้ใช้ได้'
                        });
                    }
                })
                .fail(function(xhr, status, error) {
                    console.error('Profile load request failed:', xhr.responseText);
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถโหลดข้อมูลผู้ใช้ได้'
                    });
                });
        }

        function togglePasswordVisibility(fieldId) {
            const field = document.getElementById(fieldId);
            const icon = document.getElementById(fieldId + 'Icon');
            
            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        function validatePasswordFields() {
            const currentPassword = $('#currentPassword').val();
            const newPassword = $('#newPassword').val();
            const confirmPassword = $('#confirmPassword').val();

            // ถ้าไม่มีการกรอกรหัสผ่านใดๆ ถือว่าไม่ต้องการเปลี่ยน
            if (!currentPassword && !newPassword && !confirmPassword) {
                return { valid: true, changePassword: false };
            }

            // ถ้ากรอกบางช่อง ต้องกรอกครบทุกช่อง
            if (!currentPassword) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณากรอกข้อมูล',
                    text: 'กรุณากรอกรหัสผ่านปัจจุบัน'
                });
                return { valid: false };
            }

            if (!newPassword) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณากรอกข้อมูล',
                    text: 'กรุณากรอกรหัสผ่านใหม่'
                });
                return { valid: false };
            }

            if (newPassword.length < 6) {
                Swal.fire({
                    icon: 'warning',
                    title: 'รหัสผ่านไม่ถูกต้อง',
                    text: 'รหัสผ่านใหม่ต้องมีอย่างน้อย 6 ตัวอักษร'
                });
                return { valid: false };
            }

            if (newPassword !== confirmPassword) {
                Swal.fire({
                    icon: 'warning',
                    title: 'รหัสผ่านไม่ตรงกัน',
                    text: 'รหัสผ่านใหม่และการยืนยันไม่ตรงกัน'
                });
                return { valid: false };
            }

            return { valid: true, changePassword: true, currentPassword, newPassword };
        }

        function saveProfile() {
            // Validate basic profile data
            if (!$('#profileForm')[0].checkValidity()) {
                $('#profileForm')[0].reportValidity();
                return;
            }

            // Validate password fields
            const passwordValidation = validatePasswordFields();
            if (!passwordValidation.valid) {
                return;
            }

            const profileData = {
                TitleID: $('#titleId').val(),
                FirstName: $('#firstName').val(),
                LastName: $('#lastName').val()
            };

            // Add password data if user wants to change password
            if (passwordValidation.changePassword) {
                profileData.CurrentPassword = passwordValidation.currentPassword;
                profileData.NewPassword = passwordValidation.newPassword;
            }

            // Show loading
            Swal.fire({
                title: 'กำลังบันทึก...',
                text: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            $.ajax({
                url: '/Pharma/UpdateUserProfile',
                type: 'POST',
                data: JSON.stringify(profileData),
                contentType: 'application/json',
                success: function(result) {
                    if (result.success) {
                        // Clear password fields first
                        $('#currentPassword').val('');
                        $('#newPassword').val('');
                        $('#confirmPassword').val('');
                        
                        // Check if password was changed
                        if (passwordValidation.changePassword) {
                            // Password was changed - require re-login
                            Swal.fire({
                                icon: 'success',
                                title: 'สำเร็จ!',
                                text: 'บันทึกข้อมูลเรียบร้อยแล้ว กรุณาเข้าสู่ระบบใหม่อีกครั้ง',
                                confirmButtonColor: '#198754',
                                confirmButtonText: 'ตกลง',
                                allowOutsideClick: false
                            }).then(() => {
                                // Redirect to logout/login page
                                window.location.href = '/Home/Logout';
                            });
                        } else {
                            // Only profile info was changed - redirect to index
                            Swal.fire({
                                icon: 'success',
                                title: 'สำเร็จ!',
                                text: 'บันทึกข้อมูลเรียบร้อยแล้ว',
                                confirmButtonColor: '#198754',
                                confirmButtonText: 'ตกลง'
                            }).then(() => {
                                // Redirect to pharma index
                                window.location.href = '/Pharma/Index';
                            });
                        }
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: result.message || 'ไม่สามารถบันทึกข้อมูลได้'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้'
                    });
                }
            });
        }

        function resetForm() {
            Swal.fire({
                title: 'ต้องการรีเซ็ตฟอร์มหรือไม่?',
                text: 'การเปลี่ยนแปลงที่ยังไม่ได้บันทึกจะหายไป',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#6c757d',
                cancelButtonColor: '#dc3545',
                confirmButtonText: 'รีเซ็ต',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Clear password fields first
                    $('#currentPassword').val('');
                    $('#newPassword').val('');
                    $('#confirmPassword').val('');
                    
                    // Reload user profile data
                    loadUserProfileData();
                }
            });
        }
    </script>
}
