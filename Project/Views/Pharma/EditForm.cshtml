            opacity: 0.6;
            transition: all 0.3s ease;
        }
        
        .form-type-card.selected-form-type {
            transform: scale(1.05);
            box-shadow: 0 8px 25px rgba(81, 195, 183, 0.3);
            border: 3px solid #51c3b7 !important;
        }
        
        .form-type-display:has(.selected-form-type) {
            opacity: 1;
        }
        
        .selected-indicator {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 50%;
            padding: 5px;
        }
        
        .form-type-card {
            position: relative;
            transition: all 0.3s ease;
            cursor: not-allowed;
        }
        
        .form-type-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .form-type-card.selected-form-type:hover {
            transform: scale(1.05) translateY(-2px);
            box-shadow: 0 10px 30px rgba(81, 195, 183, 0.4);
        }
        
        .question-item, .result-setting-item, .section-item {
            transition: all 0.3s ease;
            border: 1px solid #e9ecef;
        }
        
        .question-item:hover, .result-setting-item:hover, .section-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
        
        .step-container {
            animation: fadeIn 0.5s ease-in-out;
        }
        
        @@keyframes fadeIn {
