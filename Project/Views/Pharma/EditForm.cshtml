        }
        
        .form-control:focus {
            border-color: var(--mint-green);
            box-shadow: 0 0 0 0.2rem rgba(81, 195, 183, 0.25);
        }
        
        .form-select:focus {
            border-color: var(--mint-green);
            box-shadow: 0 0 0 0.2rem rgba(81, 195, 183, 0.25);
        }
        
        .container {
            max-width: 1200px;
        }
        
        .preview-card {
            border: 2px dashed #dee2e6;
            padding: 20px;
            border-radius: 10px;
            background: #f8f9fa;
            transition: all 0.3s ease;
        }
        
        :root {
            --mint-green: #51c3b7;
            --dark-green: #05685e;
        }
    </style>
}
