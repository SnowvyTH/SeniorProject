@{
    ViewData["Title"] = "จัดการฟอร์มประเมิน";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-clipboard-list me-2 mt-4"></i>จัดการฟอร์มประเมิน
            </h2>
            <p class="text-muted mb-0">เพิ่ม แก้ไข และจัดการฟอร์มประเมินในระบบ</p>
        </div>
        <a href="@Url.Action("CreateForm", "Pharma")" class="btn btn-primary mt-4">
            <i class="fas fa-plus me-2"></i>สร้างแบบประเมินใหม่
        </a>
    </div>

   

    <!-- Search and Filter Section -->
    <div class="modern-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label fw-bold">ค้นหาฟอร์ม</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหาชื่อฟอร์ม...">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">ประเภทแบบประเมิน</label>
                    <select class="form-select" id="formTypeFilter">
                        <option value="">ทุกประเภท</option>
                        <option value="1">แบบประเมินทั่วไป</option>
                        <option value="2">แบบประเมินแจงรายละเอียด</option>
                        <option value="3">แบบประเมินชุดคำถาม</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-2"></i>ล้าง
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- Forms Table -->
    <div class="modern-card mt-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="formsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="8%">ลำดับ</th>
                            <th width="35%">ชื่อฟอร์ม</th>
                            <th width="20%">ประเภท</th>
                            <th width="12%">จำนวนคำถาม</th>
                            <th width="18%">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be loaded here -->
                    </tbody>
                </table>
            </div>
            <div id="loadingSpinner" class="text-center p-4" style="display: none;">
                <div class="spinner-border text-pharma" role="status">
                    <span class="visually-hidden">กำลังโหลด...</span>
                </div>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลฟอร์ม</h5>
                <p class="text-muted">ลองเพิ่มฟอร์มใหม่หรือปรับเปลี่ยนการค้นหา</p>
            </div>
        </div>
    </div>
    
    <!-- Pagination -->
    <nav aria-label="Page navigation" class="mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <small class="text-muted" id="paginationInfo"></small>
            </div>
            <ul class="pagination pagination-sm mb-0" id="formsPagination">
                <!-- Pagination will be generated by JavaScript -->
            </ul>
        </div>
    </nav>
</div>

@section Styles {
    <style>
        .modern-card {
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border: none;
        }

        .input-group-text {
            background-color: var(--mint-green);
            color: white;
            border: 1px solid var(--mint-green);
            border-radius: 8px 0 0 8px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            border: none;
        }

        .modern-card .card-body {
            padding: 1.5rem;
        }

        .modern-card .card-header {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border-bottom: none;
            font-weight: 600;
            padding: 1rem 1.5rem;
        }

        .card-pharma {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
        }
        
        .card-success {
            background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
            color: white;
        }
        
        .card-info {
            background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
            color: white;
        }
        
        .card-warning {
            background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
            color: white;
        }

        .stats-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

        .stats-card:hover {
            transform: translateY(-5px);
        }

        .stats-number {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .stats-label {
            font-size: 0.9rem;
            margin: 0;
            opacity: 0.9;
        }

        .stats-icon {
            font-size: 2.5rem;
            opacity: 0.7;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #e0e6ed;
        }

        .input-group .form-control {
            border-radius: 0 8px 8px 0;
        }

        .action-buttons {
            display: flex;
            gap: 0.25rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }

        .text-system-form {
            color: #6c757d;
            font-size: 0.85rem;
        }

        .system-form-row {
            background-color: rgba(108, 117, 125, 0.05);
        }

        .system-form-indicator {
            display: inline-flex;
            align-items: center;
            font-size: 0.75rem;
            color: #6c757d;
            background-color: rgba(108, 117, 125, 0.1);
            padding: 0.25rem 0.5rem;
            border-radius: 12px;
            margin-left: 0.5rem;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/pagination.js"></script>
    <script>
        let currentPage = 1;
        const pageSize = 5;
        let allForms = []; // เก็บข้อมูลฟอร์มทั้งหมด

        $(document).ready(function() {
            loadForms();
            setupFilters();
        });

        function setupFilters() {
            $('#searchInput').on('input', function() {
                currentPage = 1;
                loadForms();
            });

            $('#formTypeFilter').on('change', function() {
                currentPage = 1;
                loadForms();
            });
        }

        function loadForms() {
            $('#loadingSpinner').show();
            $('#noDataMessage').hide();
            
            const search = $('#searchInput').val();
            const formType = $('#formTypeFilter').val();

            $.get('/Pharma/GetForms', {
                search: search,
                formType: formType
            })
                .done(function(data) {
                    allForms = data;
                    displayForms(data);
                })
                .fail(function() {
                    showError('เกิดข้อผิดพลาดในการโหลดข้อมูล');
                })
                .always(function() {
                    $('#loadingSpinner').hide();
                });
        }

        function displayForms(forms) {
            const paginatedData = paginateData(forms, currentPage, pageSize);
            const tbody = $('#formsTable tbody');
            tbody.empty();

            if (paginatedData.items.length === 0) {
                document.getElementById('formsPagination').innerHTML = '';
                $('#noDataMessage').show();
                $('#formsPagination').parent().hide();
                $('#paginationInfo').text('');
                return;
            }

            $('#noDataMessage').hide();
            $('#formsPagination').parent().show();

            paginatedData.items.forEach(function(form, index) {
                const formTypeText = getFormTypeText(form.formType);
                const rowNumber = ((currentPage - 1) * pageSize) + index + 1;
                
                // ตรวจสอบว่าเป็นฟอร์มพิเศษหรือไม่
                const isSpecialForm = ['Mod-SAS', 'Mod-BARS', 'Mod-AIMS'].includes(form.formName);
                
                let actionButtons = '';
                if (isSpecialForm) {
                    // สำหรับฟอร์มพิเศษ ไม่แสดงปุ่มใดๆ
                    actionButtons = `
                        <div class="action-buttons mx-2">
                            <span class="text-muted small">
                                <i class="fas fa-lock me-1"></i>ไม่สามารถแก้ไขได้
                            </span>
                        </div>
                    `;
                } else {
                    // สำหรับฟอร์มทั่วไป แสดงปุ่มแก้ไขและลบ
                    actionButtons = `
                        <div class="action-buttons">
                            <a href="/Pharma/EditForm?formId=${form.formID}" class="btn btn-warning btn-sm mx-1" title="แก้ไข">
                                <i class="fas fa-edit"></i>แก้ไข
                            </a>
                            <button type="button" class="btn btn-danger btn-sm" 
                                    onclick="deleteForm(${form.formID}, '${form.formName}', ${form.hasEvaluations || false})" title="ลบ">
                                <i class="fas fa-trash"></i> ลบ
                            </button>
                        </div>
                    `;
                }
                
                const row = `
                    <tr>
                        <td><span class="text-center mx-4">${rowNumber}</span></td>
                        <td>
                            <div class="fw-bold mx-2">${form.formName}</div>
                        </td>
                        <td>${formTypeText}</td>
                        <td>
                            <span class="mx-3">${form.questionCount} ข้อ</span>
                        </td>
                        <td>
                            ${actionButtons}
                        </td>
                    </tr>
                `;
                tbody.append(row);
            });

            // อัพเดต pagination
            generatePagination(paginatedData.totalPages, currentPage, 'formsPagination', 'changeFormPage');
            updatePaginationInfo(currentPage, pageSize, paginatedData.totalItems, 'paginationInfo');
        }

        function getFormTypeText(formType) {
            switch(formType) {
                case 1: return '<span class="badge bg-primary">แบบประเมินทั่วไป</span>';
                case 2: return '<span class="badge bg-danger">แบบประเมินแจงรายละเอียด</span>';
                case 3: return '<span class="badge bg-success">แบบประเมินชุดคำถาม</span>';
                default: return '<span class="badge bg-secondary">ไม่ระบุ</span>';
            }
        }

        function deleteForm(formId, formName, hasEvaluations = false) {
            let confirmTitle = 'ต้องการลบฟอร์มนี้หรือไม่?';
            let confirmText = `ฟอร์ม "${formName}" และข้อคำถามตัวเลือกทั้งหมดจะถูกลบออก`;
            
            if (hasEvaluations) {
                confirmTitle = 'ฟอร์มนี้มีประวัติการประเมินแล้ว!';
                confirmText = `ฟอร์ม "${formName}" มีประวัติการประเมินของผู้ป่วย หากลบฟอร์มนี้ ประวัติการประเมินที่เกี่ยวข้องทั้งหมดจะถูกลบไปด้วย`;
            }
            
            Swal.fire({
                title: confirmTitle,
                text: confirmText,
                icon: hasEvaluations ? 'error' : 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: hasEvaluations ? 'ลบฟอร์มและประวัติการประเมิน' : 'ลบฟอร์ม',
                cancelButtonText: 'ยกเลิก',
                footer: hasEvaluations ? '<span class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>การกระทำนี้ไม่สามารถย้อนกลับได้</span>' : null
            }).then((result) => {
                if (result.isConfirmed) {
                    // แสดงการยืนยันครั้งสุดท้ายสำหรับฟอร์มที่มีประวัติการประเมิน
                    if (hasEvaluations) {
                        Swal.fire({
                            title: 'ยืนยันการลบอีกครั้ง',
                            text: 'คุณแน่ใจหรือไม่ที่จะลบฟอร์มและประวัติการประเมินทั้งหมด?',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#d33',
                            cancelButtonColor: '#6c757d',
                            confirmButtonText: 'ยืนยันการลบ',
                            cancelButtonText: 'ยกเลิก'
                        }).then((finalResult) => {
                            if (finalResult.isConfirmed) {
                                performDelete(formId, formName, true);
                            }
                        });
                    } else {
                        performDelete(formId, formName, false);
                    }
                }
            });
        }
        
        function performDelete(formId, formName, forceDelete) {
            Swal.fire({
                title: 'กำลังลบ...',
                text: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            $.ajax({
                url: '/Pharma/DeleteForm/' + formId,
                type: 'DELETE',
                data: JSON.stringify({ forceDelete: forceDelete }),
                contentType: 'application/json',
                success: function(response) {
                    if (response.success) {
                        let successText = 'ลบฟอร์มเรียบร้อยแล้ว';
                        if (forceDelete && response.deletedEvaluations > 0) {
                            successText += ` (ลบประวัติการประเมิน ${response.deletedEvaluations} รายการ)`;
                        }
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'ลบสำเร็จ!',
                            text: successText,
                            confirmButtonColor: '#198754'
                        }).then(() => {
                            loadForms();
                            loadStats();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: response.message || 'ไม่สามารถลบฟอร์มได้',
                            confirmButtonColor: '#dc3545'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    let errorMessage = 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้';
                    
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: errorMessage,
                        confirmButtonColor: '#dc3545'
                    });
                }
            });
        }

        function changeFormPage(page) {
            currentPage = page;
            displayForms(filteredForms);
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#formTypeFilter').val('');
            currentPage = 1;
            loadForms();
        }

        function showSuccess(message) {
            alert(message);
        }

        function showError(message) {
            alert('ข้อผิดพลาด: ' + message);
        }
    </script>
}
