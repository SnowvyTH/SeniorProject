@{
    ViewData["Title"] = "จัดการฟอร์มประเมิน";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-clipboard-list me-2 mt-4"></i>จัดการฟอร์มประเมิน
            </h2>
            <p class="text-muted mb-0">เพิ่ม แก้ไข และจัดการฟอร์มประเมินในระบบ</p>
        </div>
        <a href="@Url.Action("CreateForm", "Pharma")" class="btn btn-pharma">
            <i class="fas fa-plus me-2"></i>สร้างแบบประเมินใหม่
        </a>
    </div>

   

    <!-- Search and Filter Section -->

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหาชื่อฟอร์ม...">
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary" onclick="clearSearch()">
                        <i class="fas fa-times me-2"></i>ล้างการค้นหา
                    </button>
                </div>
            </div>


    <!-- Forms Table -->
    <div class="modern-card mt-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="formsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="8%">ลำดับ</th>
                            <th width="35%">ชื่อฟอร์ม</th>
                            <th width="15%">ประเภท</th>
                            <th width="12%">จำนวนคำถาม</th>
                            <th width="12%">การประเมิน</th>
                            <th width="18%">การจัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be loaded here -->
                    </tbody>
                </table>
            </div>
            <div id="loadingSpinner" class="text-center p-4" style="display: none;">
                <div class="spinner-border text-pharma" role="status">
                    <span class="visually-hidden">กำลังโหลด...</span>
                </div>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลฟอร์ม</h5>
                <p class="text-muted">ลองเพิ่มฟอร์มใหม่หรือปรับเปลี่ยนการค้นหา</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-pharma {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
        }
        
        .card-success {
            background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
            color: white;
        }
        
        .card-info {
            background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
            color: white;
        }
        
        .card-warning {
            background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
            color: white;
        }

        .stats-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

        .stats-card:hover {
            transform: translateY(-5px);
        }

        .stats-number {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .stats-label {
            font-size: 0.9rem;
            margin: 0;
            opacity: 0.9;
        }

        .stats-icon {
            font-size: 2.5rem;
            opacity: 0.7;
        }

        .btn-pharma {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            border: none;
            color: white;
            font-weight: 500;
        }

        .btn-pharma:hover {
            background: linear-gradient(135deg, #1976D2 0%, #1565C0 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(33, 150, 243, 0.4);
        }

        .bg-pharma {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%) !important;
        }

        .text-pharma {
            color: #2196F3 !important;
        }

        .badge.bg-pharma {
            background: #2196F3 !important;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
        }

        .form-label.required::after {
            content: " *";
            color: #dc3545;
        }

        .action-buttons {
            display: flex;
            gap: 0.25rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function() {
            loadForms();
            loadStats();

            // Search functionality
            $('#searchInput').on('input', function() {
                loadForms();
            });
        });

        function loadStats() {
            $.get('/Pharma/GetFormStats')
                .done(function(data) {
                    $('#totalForms').text(data.totalForms);
                    $('#formsWithQuestions').text(data.formsWithQuestions);
                    $('#totalQuestions').text(data.totalQuestions);
                    $('#totalEvaluations').text(data.totalEvaluations);
                })
                .fail(function() {
                    console.error('Error loading stats');
                });
        }

        function loadForms() {
            $('#loadingSpinner').show();
            $('#noDataMessage').hide();
            
            const search = $('#searchInput').val();
            
            $.get('/Pharma/GetForms', { search: search })
                .done(function(data) {
                    displayForms(data);
                    $('#formsCount').text(data.length + ' รายการ');
                })
                .fail(function() {
                    showError('เกิดข้อผิดพลาดในการโหลดข้อมูล');
                })
                .always(function() {
                    $('#loadingSpinner').hide();
                });
        }

        function displayForms(forms) {
            const tbody = $('#formsTable tbody');
            tbody.empty();

            if (forms.length === 0) {
                $('#noDataMessage').show();
                return;
            }

            forms.forEach(function(form, index) {
                const formTypeText = getFormTypeText(form.formType);
                const rowNumber = index + 1;
                const row = `
                    <tr>
                        <th><span class="text-center mx-4">${rowNumber}</span></th>
                        <td>
                            <div class="fw-bold">${form.formName || 'ไม่ระบุ'}</div>
                        </td>
                        <td>${formTypeText}</td>
                        <td>
                            <span class="badge bg-info">${form.questionCount} ข้อ</span>
                        </td>
                        <td>
                            <span class="badge bg-success">${form.evaluationCount} ครั้ง</span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a href="/Pharma/EditForm?formId=${form.formID}" class="btn btn-outline-primary btn-sm" title="แก้ไข">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm" 
                                        onclick="deleteForm(${form.formID}, '${form.formName}')" title="ลบ">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.append(row);

            });
        }

        function getFormTypeText(formType) {
            switch(formType) {
                case 1: return '<span class="badge bg-primary">แบบประเมินทั่วไป</span>';
                case 2: return '<span class="badge bg-danger">แบบประเมินข้อยาว</span>';
                case 3: return '<span class="badge bg-success">แบบประเมินหัวข้อใหญ่</span>';
                default: return '<span class="badge bg-secondary">ไม่ระบุ</span>';
            }
        }

        function deleteForm(formId, formName) {
            Swal.fire({
                title: 'ต้องการลบฟอร์มนี้หรือไม่?',
                text: `ฟอร์ม "${formName}" และข้อคำถามตัวเลือกทั้งหมดจะถูกลบออก`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loading
                    Swal.fire({
                        title: 'กำลังลบ...',
                        text: 'กรุณารอสักครู่',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                    
                    $.ajax({
                        url: '/Pharma/DeleteForm/' + formId,
                        type: 'DELETE',
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'ลบสำเร็จ!',
                                    text: 'ลบฟอร์มเรียบร้อยแล้ว',
                                    confirmButtonColor: '#198754'
                                }).then(() => {
                                    loadForms();
                                    loadStats();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'เกิดข้อผิดพลาด',
                                    text: response.message || 'ไม่สามารถลบฟอร์มได้',
                                    confirmButtonColor: '#dc3545'
                                });
                            }
                        },
                        error: function(xhr, status, error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'เกิดข้อผิดพลาด',
                                text: 'ไม่สามารถติดต่อเซิร์ฟเวอร์ได้',
                                confirmButtonColor: '#dc3545'
                            });
                        }
                    });
                }
            });
        }

        function clearSearch() {
            $('#searchInput').val('');
            loadForms();
        }

        function showSuccess(message) {
            alert(message);
        }

        function showError(message) {
            alert('ข้อผิดพลาด: ' + message);
        }
    </script>
}
