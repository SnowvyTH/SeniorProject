@model Project.Models.Entity.Evaluation
@{
    ViewData["Title"] = "รายละเอียดการประเมิน";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
}

<div class="container">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-file-medical me-2 mt-4"></i>รายละเอียดการประเมิน
            </h2>
            <p class="text-muted mb-0">ผลการประเมินของผู้ป่วย</p>
        </div>
        <div>
            <a href="/Pharma/" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>กลับ
            </a>
        </div>
    </div>

    <!-- Patient Information -->
    <div class="modern-card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-user-injured me-2"></i>ข้อมูลผู้ป่วย
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">HN:</label>
                        <span class="ms-2">@Model.Patient?.HN</span>
                    </div>
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">ชื่อ-นามสกุล:</label>
                        <span class="ms-2">@($"{Model.Patient?.Title?.TitleName}{Model.Patient?.FirstName} {Model.Patient?.LastName}")</span>
                    </div>
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">ประเภทผู้ป่วย:</label>
                        <span class="badge @(Model.Patient?.PatientType == "OPD" ? "bg-primary" : "bg-success") ms-2">
                            @Model.Patient?.PatientType
                        </span>
                    </div>
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">วันที่ทำการประเมิน:</label>
                        <span class="ms-2">@Model.RecordDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">ผู้ประเมิน:</label>
                        <span class="ms-2">@($"{Model.User?.Title?.TitleName}{Model.User?.FirstName} {Model.User?.LastName}")</span>
                    </div>
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">แบบประเมิน:</label>
                        <span class="ms-2">@Model.Form?.FormName</span>
                    </div>
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">ระดับความรุนแรง:</label>
                        <span class="badge bg-danger ms-2">@(ViewBag.InterpreterName ?? Model.Result ?? "ไม่ระบุ")</span>
                    </div>
                    <div class="info-item mb-3">
                        <label class="fw-bold text-muted">แนวทางปฎิบัติ:</label>
                        <div class="ms-2 mt-1">
                            <div class="practice-guidelines p-2 bg-light rounded border-start border-warning border-4">
                                @if (!string.IsNullOrEmpty(ViewBag.InterpreterText))
                                {
                                    @Html.Raw(((string)ViewBag.InterpreterText).Replace("\n", "<br>"))
                                }
                                else
                                {
                                    <small class="text-muted">ไม่มีข้อมูลแนวทางปฎิบัติ</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Evaluation Details -->
    <div class="modern-card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-list-check me-2"></i>รายละเอียดการตอบ
            </h5>
        </div>
        <div class="card-body">
            @if (Model.EvaluationDetails?.Any() == true)
            {
                <div class="evaluation-details">
                    @if (Model.Form?.FormType == 3)
                    {
                        // แบบประเมินแบบกลุ่ม - แสดงตาม section
                        var groupedQuestions = Model.EvaluationDetails
                            .Where(d => d.Question != null)
                            .GroupBy(d => d.Question!.Section)
                            .OrderBy(g => g.Key);
                        
                        int overallQuestionIndex = 0;
                        
                        @foreach (var sectionGroup in groupedQuestions)
                        {
                            <div class="section-group mb-4">
                                <div class="section-header mb-3 p-3 bg-primary text-white rounded">
                                    <h5 class="mb-0">
                                        <i class="fas fa-layer-group me-2"></i>
                                        @(sectionGroup.Key ?? "ไม่ระบุหมวดหมู่")
                                    </h5>
                                </div>
                                
                                @foreach (var detail in sectionGroup.OrderBy(d => d.Question?.QuestionID))
                                {
                                    overallQuestionIndex++;
                                    <div class="detail-item mb-3 p-3 border rounded ms-3">
                                        <div class="question-header mb-2">
                                            <h6 class="fw-bold text-primary">
                                                <i class="fas fa-question-circle me-2"></i>
                                                คำถามที่ @overallQuestionIndex
                                            </h6>
                                            <p class="mb-2">@Html.Raw(detail.Question?.QuestionText?.Replace("\n", "<br>"))</p>
                                        </div>
                                        <div class="answer-section">
                                            <div class="selected-answer p-2 bg-light rounded">
                                                <strong>คำตอบที่เลือก:</strong>
                                                <span class="badge bg-success ms-2">@detail.Score คะแนน</span>
                                                <div class="mt-1">
                                                    @{
                                                        var selectedOption = detail.Question?.Options?.FirstOrDefault(o => o.Value == detail.Score);
                                                    }
                                                    @if (selectedOption != null)
                                                    {
                                                        <span class="text-muted">@Html.Raw(selectedOption.OptionText?.Replace("\n", "<br>"))</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        // แบบประเมินมาตรฐาน - แสดงตามลำดับ
                        int questionIndex = 0;
                        @foreach (var detail in Model.EvaluationDetails.OrderBy(d => d.Question?.QuestionID))
                        {
                            questionIndex++;
                            <div class="detail-item mb-4 p-3 border rounded">
                                <div class="question-header mb-2">
                                    <h6 class="fw-bold text-primary">
                                        <i class="fas fa-question-circle me-2"></i>
                                        คำถามที่ @questionIndex
                                    </h6>
                                    <p class="mb-2">@Html.Raw(detail.Question?.QuestionText?.Replace("\n", "<br>"))</p>
                                </div>
                                <div class="answer-section">
                                    <div class="selected-answer p-2 bg-light rounded">
                                        <strong>คำตอบที่เลือก:</strong>
                                        <span class="badge bg-success ms-2">@detail.Score คะแนน</span>
                                        <div class="mt-1">
                                            @{
                                                var selectedOption = detail.Question?.Options?.FirstOrDefault(o => o.Value == detail.Score);
                                            }
                                            @if (selectedOption != null)
                                            {
                                                <span class="text-muted">@Html.Raw(selectedOption.OptionText?.Replace("\n", "<br>"))</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted">
                    <i class="fas fa-exclamation-circle fa-3x mb-3"></i>
                    <p>ไม่พบรายละเอียดการตอบคำถาม</p>
                </div>
            }
        </div>
    </div>

    <!-- Form Information -->
    <div class="modern-card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>ข้อมูลแบบประเมิน
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="info-item mb-2">
                        <label class="fw-bold text-muted">ชื่อแบบประเมิน:</label>
                        <span class="ms-2">@Model.Form?.FormName</span>
                    </div>
                    <div class="info-item mb-2">
                        <label class="fw-bold text-muted">ประเภท:</label>
                        <span class="ms-2">
                            @{
                                string formTypeText = Model.Form?.FormType switch
                                {
                                    1 => "แบบประเมินทั่วไป",
                                    2 => "แบบประเมินแจงรายละเอียด",
                                    3 => "แบบประเมินชุดคำถาม",
                                    _ => "ไม่ระบุ"
                                };
                            }
                            @formTypeText
                        </span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="info-item mb-2">
                        <label class="fw-bold text-muted">วิธีการนับคะแนน:</label>
                        <span class="ms-2">
                            @{
                                string scoringText = Model.Form?.Scoring switch
                                {
                                    "max" => "คะแนนสูงสุด",
                                    "min" => "คะแนนต่ำสุด",
                                    "sum" => "รวมคะแนน",
                                    _ => "รวมคะแนน"
                                };
                            }
                            @scoringText
                        </span>
                    </div>
                    <div class="info-item mb-2">
                        <label class="fw-bold text-muted">จำนวนคำถาม:</label>
                        <span class="ms-2">@(Model.Form?.Questions?.Count ?? 0) ข้อ</span>
                    </div>
                    @if (ViewBag.CalculatedScore != null)
                    {
                        <div class="info-item mb-2">
                            <label class="fw-bold text-muted">คะแนนที่ได้:</label>
                            <span class="badge bg-info ms-2">@ViewBag.CalculatedScore คะแนน</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --mint-green: #51c3b7;
            --dark-green: #05685e;
            --orange: #ff6b35;
            --purple: #6f42c1;
            --teal: #20c997;
            --indigo: #6610f2;
        }

        .modern-card {
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            border: none;
        }

        .modern-card .card-header {
            background: linear-gradient(135deg, var(--mint-green) 0%, var(--dark-green) 100%);
            color: white;
            border-radius: 15px 15px 0 0;
            border-bottom: none;
            font-weight: 600;
            padding: 1rem 1.5rem;
        }

        .modern-card .card-body {
            padding: 1.5rem;
        }

        .page-title {
            color: var(--dark-green);
            font-weight: 700;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
        }

        .info-item label {
            min-width: 140px;
            margin-bottom: 0;
        }

        .practice-guidelines {
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%) !important;
            font-size: 0.9rem;
            line-height: 1.4;
        }

        .detail-item {
            background: #f8f9fa;
            transition: all 0.3s ease;
            border: 1px solid #e9ecef !important;
        }

        .detail-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-color: var(--teal) !important;
        }

        .question-header h6 {
            color: var(--orange) !important;
            font-weight: 700;
        }

        .selected-answer {
            border-left: 4px solid var(--teal);
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        .section-group {
            margin-bottom: 2rem;
        }

        .section-header {
            background: linear-gradient(135deg, var(--purple) 0%, var(--indigo) 100%) !important;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(111, 66, 193, 0.3);
        }

        .section-group .detail-item {
            border-left: 4px solid var(--purple);
            background: #fff;
            margin-left: 1rem;
        }

        .section-group .detail-item:hover {
            border-left-color: var(--indigo);
            background: linear-gradient(135deg, #fff 0%, #f8f9ff 100%);
        }

        .section-group .question-header h6 {
            color: var(--purple) !important;
        }

        .badge {
            border-radius: 6px;
        }

        .badge.bg-danger {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%) !important;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            border-color: #6c757d;
        }
    </style>
}
