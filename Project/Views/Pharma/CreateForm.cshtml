@{
    ViewData["Title"] = "สร้างแบบประเมิน";
    Layout = "~/Views/Shared/_PharmaLayout.cshtml";
}

<div class="container">
    
    <div class="d-flex justify-content-between align-items-center mb-4 mt-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-clipboard-list me-2"></i>สร้างแบบประเมิน
            </h2>
            <p class="text-muted mb-0">สร้างแบบประเมินสำหรับผู้ป่วยใหม่</p>
        </div>
        <a href="#" class="btn btn-warning" onclick="confirmGoBack()">
            <i class="fas fa-arrow-left me-2"></i>กลับไปหน้าแรก
        </a>
    </div>

<div id="step1" class="step-container">
    <div class="row">
        <div class="col-md-8">
            <div class="modern-card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-info-circle me-2"></i>ข้อมูลพื้นฐาน</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4 m-3">
                        <label for="formName" class="form-label fw-bold">ชื่อแบบประเมิน</label>
                        <input type="text" class="form-control form-control-lg" id="formName" 
                               placeholder="กรุณากรอกชื่อแบบประเมิน" onblur="checkFormNameExists()">
                        <div id="formNameFeedback" class="invalid-feedback" style="display: none;"></div>
                    </div>
                    
                    <div class="mb-4 m-3">
                        <label class="form-label fw-bold">เลือกประเภทแบบประเมิน</label>
                        <p class="text-muted small mb-3">เลือกประเภทที่เหมาะสมกับการประเมินของคุณ</p>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-type-card" data-type="1">
                                    <div class="card h-100 form-type-option border-0 shadow-sm">
                                        <div class="card-body text-center p-4">
                                            <div class="mb-3">
                                                <i class="fas fa-list-ul fa-3x text-primary"></i>
                                            </div>
                                            <h5 class="card-title fw-bold">แบบประเมิน ประเภท 1</h5>
                                            <p class="text-muted mb-4">แบบประเมินแบบมาตรฐาน</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-type-card" data-type="2">
                                    <div class="card h-100 form-type-option border-0 shadow-sm">
                                        <div class="card-body text-center p-4">
                                            <div class="mb-3">
                                                <i class="fas fa-check-circle fa-3x text-success"></i>
                                            </div>
                                            <h5 class="card-title fw-bold">แบบประเมิน ประเภท 2</h5>
                                            <p class="text-muted mb-0">แบบประเมินคำตอบมีข้อความยาว</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-type-card" data-type="3">
                                    <div class="card h-100 form-type-option border-0 shadow-sm">
                                        <div class="card-body text-center p-4">
                                            <div class="mb-3">
                                                <i class="fas fa-star fa-3x text-warning"></i>
                                            </div>
                                            <h5 class="card-title fw-bold">แบบประเมิน ประเภท 3</h5>
                                            <p class="text-muted mb-4">แบบประเมินแบบมีหัวข้อใหญ่</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="button" class="btn btn-pharma btn-lg px-4 mb-4 mx-4" onclick="nextStep()">
                            <i class="fas fa-arrow-right me-2"></i>ถัดไป
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="modern-card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-lightbulb me-2"></i>คำแนะนำ</h5>
                </div>
                <div class="card-body pb-4">
                    <div class="alert alert-info border-0 rounded-1 mb-0">
                        <h6 class="fw-bold"><i class="fas fa-info-circle me-2"></i>วิธีการใช้งาน</h6>
                        <ul class="mb-0 ps-3">
                            <li>กรอกชื่อแบบประเมิน</li>
                            <li>เลือกประเภทแบบประเมิน</li>
                            <li>คลิกถัดไปเพื่อดำเนินการต่อ</li>
                        </ul>
                    </div>
                    
                        <div id="preview-container" class="text-center">
                            <div class="text-muted mt-4">
                                <i class="fa-solid fa-arrow-pointer fa-2x"></i>
                                <p class="mb-0">เลือกประเภทแบบประเมินเพื่อดูตัวอย่าง</p>
                            </div>
                        </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div id="step2" class="step-container" style="display: none;">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-edit me-2"></i>สร้างคำถาม</h5>
                </div>
                <div class="card-body">
                    <div id="questions-container">
                       
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div>
                            <button type="button" class="btn btn-success btn-lg px-4 m-4" onclick="addQuestion()" id="addQuestionBtn">
                                <i class="fas fa-plus me-2"></i>เพิ่มคำถาม
                            </button>
                            <button type="button" class="btn btn-warning btn-lg px-4 m-4" onclick="addSection()" id="addSectionBtn" style="display: none;">
                                <i class="fas fa-plus me-2"></i>เพิ่มหัวข้อใหญ่
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-secondary me-2" onclick="prevStep()">
                                <i class="fas fa-arrow-left me-2"></i>กลับ
                            </button>
                            <button type="button" class="btn btn-pharma btn-lg px-4 mx-2 me-4" onclick="nextStep()">
                                <i class="fas fa-arrow-right me-2"></i>ถัดไป
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="step3" class="step-container" style="display: none;">
    <div class="row">
        <div class="col-12">
            <div class="modern-card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="fas fa-calculator me-2"></i>การตั้งค่าผลลัพธ์การประเมิน</h5>
                </div>
                <div class="card-body">
                    <div class="m-4">
                        <label class="form-label fw-bold">วิธีการนับคะแนน</label>
                        <select class="form-select form-select-lg" id="scoringMethod">
                            <option value="max">ตัวเลือกคะแนนมากที่สุด</option>
                            <option value="min">ตัวเลือกคะแนนน้อยที่สุด</option>
                            <option value="sum">รวมคะแนนทั้งหมด</option>
                        </select>
                    </div>
                    
                    <div class="result-settings">
                        <div class="d-flex justify-content-between align-items-center m-4">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="fas fa-star me-2"></i>ช่วงคะแนนและผลลัพธ์</h6>
                                <p class="text-muted small mb-0">กำหนดช่วงคะแนนและการแปลผล</p>
                            </div>
                            <button type="button" class="btn btn-success" onclick="addResultSetting()">
                                <i class="fas fa-plus me-2"></i>เพิ่มช่วงคะแนน
                            </button>
                        </div>
                        
                        <div id="result-settings-container">
                            
                        </div>
                    </div>

                    
                    <div class="d-flex justify-content-between align-items-center m-4">
                        <button type="button" class="btn btn-secondary mb-3" onclick="prevStep()">
                            <i class="fas fa-arrow-left me-2"></i>กลับ
                        </button>
                            <button type="button" class="btn btn-pharma btn-lg px-4 mb-3" onclick="saveForm()">
                            <i class="fas fa-save me-2"></i>บันทึกแบบประเมิน
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

</div> 

@section Scripts {
    <script>
        let currentStep = 1;
        let selectedFormType = 0;
        let questionsCount = 0;
        let resultSettingsCount = 0;
        
        $(document).ready(function() {
            $('.form-type-card').click(function() {
                $('.form-type-option').removeClass('border-primary');
                $(this).find('.form-type-option').addClass('border-primary');
                selectedFormType = $(this).data('type');
                showPreview(selectedFormType);
                
                $('#questions-container').empty();
                questionsCount = 0;
 
                if (selectedFormType === 3) {
                    $('#addQuestionBtn').hide();
                    $('#addSectionBtn').show();
                    addSection();
                } else {
                    $('#addQuestionBtn').show();
                    $('#addSectionBtn').hide();
                    addQuestion();
                }
            });
            
            addResultSetting();
        });
        
        function checkFormNameExists() {
            let formName = $('#formName').val().trim();
            let feedbackDiv = $('#formNameFeedback');
            let formNameInput = $('#formName');
            
            if (!formName) {
                formNameInput.removeClass('is-invalid is-valid');
                feedbackDiv.hide();
                return;
            }
            
            $.ajax({
                url: '@Url.Action("CheckFormNameExists", "Pharma")',
                type: 'POST',
                data: JSON.stringify({ 
                    formName: formName, 
                    excludeFormId: null
                }),
                contentType: 'application/json',
                success: function(result) {
                    if (result.exists) {
                        formNameInput.removeClass('is-valid').addClass('is-invalid');
                        feedbackDiv.text('ชื่อแบบประเมินนี้มีอยู่แล้วในระบบ กรุณาใช้ชื่ออื่น').show();
                    } else {
                        formNameInput.removeClass('is-invalid').addClass('is-valid');
                        feedbackDiv.hide();
                    }
                },
                error: function() {
                    formNameInput.removeClass('is-invalid is-valid');
                    feedbackDiv.hide();
                }
            });
        }
        
        function showPreview(type) {
            let preview = '';
            switch(type) {
                case 1:
                    preview = '<div class="preview-card"><h6 class="fw-bold text-primary">ตัวอย่าง แบบประเมิน ประเภท 1</h6><p class="text-muted mb-2">แบบประเมิน Mod-SAS</p><img class="img-thumbnail" src="/img/form1.png" /></div>';
                    break;
                case 2:
                    preview = '<div class="preview-card"><h6 class="fw-bold text-success">ตัวอย่าง แบบประเมิน ประเภท 2</h6><p class="text-muted mb-2">แบบประเมิน Mod-BARS</p><img class="img-thumbnail" src="/img/form2.png" /></div>';
                    break;
                case 3:
                    preview = '<div class="preview-card"><h6 class="fw-bold text-warning">ตัวอย่าง แบบประเมิน ประเภท 3</h6><p class="text-muted mb-2">แบบประเมิน Mod-AIMS</p><img class="img-thumbnail" src="/img/form3.png" /></div>';
                    break;
            }
            $('#preview-container').html(preview);
        }
        
        function confirmGoBack() {
            Swal.fire({
                title: 'ต้องการกลับไปหน้าแรกหรือไม่?',
                text: 'ข้อมูลที่กรอกจะหายไปทั้งหมด',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#51c3b7',
                cancelButtonColor: '#d33',
                confirmButtonText: 'ตกลง',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Forms", "Pharma")';
                }
            });
        }
        
        function nextStep() {
            if (currentStep === 1) {
                if (!$('#formName').val().trim()) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณากรอกชื่อแบบประเมิน',
                        text: 'โปรดระบุชื่อแบบประเมินก่อนดำเนินการต่อ',
                        confirmButtonColor: '#51c3b7'
                    });
                    return;
                }
                
                if ($('#formName').hasClass('is-invalid')) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ชื่อแบบประเมินซ้ำ',
                        text: 'ชื่อแบบประเมินซ้ำกับที่มีอยู่แล้ว กรุณาเปลี่ยนชื่อก่อนดำเนินการต่อ',
                        confirmButtonColor: '#51c3b7'
                    });
                    $('#formName').focus();
                    return;
                }
                
                if (selectedFormType === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณาเลือกประเภทแบบประเมิน',
                        text: 'โปรดเลือกประเภทแบบประเมินที่ต้องการสร้าง',
                        confirmButtonColor: '#51c3b7'
                    });
                    return;
                }
            }
            
            if (currentStep === 2) {
                if (selectedFormType === 3) {
                    if ($('.section-item').length === 0) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณาเพิ่มหัวข้อใหญ่',
                            text: 'กรุณาเพิ่มหัวข้อใหญ่อย่างน้อย 1 หัวข้อ',
                            confirmButtonColor: '#51c3b7'
                        });
                        return;
                    }
                    
                    let SectionNotFill = false;
                    let QuestionNotFill = false;
                    let OptionNotFill = false;
                    
                    $('.section-item').each(function() {
                        let sectionName = $(this).find('.section-name').val().trim();
                        if (!sectionName) {
                            SectionNotFill = true;
                            return false;
                        }
                        
                        if ($(this).find('.question-in-section-item').length === 0) {
                            QuestionNotFill = true;
                            return false;
                        }
                        
                        $(this).find('.question-in-section-item').each(function() {
                            if (!$(this).find('.question-text').val().trim()) {
                                QuestionNotFill = true;
                                return false;
                            }
                            
                            $(this).find('.option-item').each(function() {
                                let optionValue = $(this).find('.option-value').val();
                                if (!optionValue) {
                                    OptionNotFill = true;
                                    return false;
                                }
                            });
                            
                            if (OptionNotFill) return false;
                        });
                        
                        if (QuestionNotFill || OptionNotFill) return false;
                    });
                    
                    if (SectionNotFill) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณากรอกชื่อหัวข้อใหญ่ให้ครบถ้วน',
                            text: 'มีหัวข้อใหญ่ที่ยังไม่ได้กรอกชื่อ กรุณาตรวจสอบ',
                            confirmButtonColor: '#51c3b7'
                        });
                        return;
                    }
                    
                    if (QuestionNotFill) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณาเพิ่มคำถามในแต่ละหัวข้อ',
                            text: 'ทุกหัวข้อใหญ่ต้องมีคำถามอย่างน้อย 1 คำถาม',
                            confirmButtonColor: '#51c3b7'
                        });
                        return;
                    }
                    
                    if (OptionNotFill) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณากรอกคะแนนให้ครบถ้วน',
                            text: 'มีตัวเลือกที่ยังไม่ได้กรอกคะแนน กรุณาตรวจสอบ',
                            confirmButtonColor: '#51c3b7'
                        });
                        return;
                    }
                } else {
                    if ($('.question-item').length === 0) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณาเพิ่มคำถาม',
                            text: 'กรุณาเพิ่มคำถามอย่างน้อย 1 คำถาม',
                            confirmButtonColor: '#51c3b7'
                        });
                        return;
                    }
                    
                    let QuestionNotFill = false;
                    let OptionNotFill = false;
                    $('.question-item').each(function() {
                        if (!$(this).find('.question-text').val().trim()) {
                            QuestionNotFill = true;
                            return false;
                        }
                        
                        $(this).find('.option-item').each(function() {
                            let optionText = $(this).find('.option-text').val().trim();
                            let optionValue = $(this).find('.option-value').val();
                            
                            if (selectedFormType === 1 || selectedFormType === 2) {
                                if (!optionText || !optionValue) {
                                    OptionNotFill = true;
                                    return false;
                                }
                            }
                        });
                        
                        if (OptionNotFill) return false;
                    });
                    
                    if (QuestionNotFill) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณากรอกคำถามให้ครบถ้วน',
                            text: 'มีคำถามที่ยังไม่ได้กรอกข้อความ กรุณาตรวจสอบ',
                            confirmButtonColor: '#51c3b7'
                        });
                        return;
                    }
                    
                    if (OptionNotFill) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'กรุณากรอกตัวเลือกให้ครบถ้วน',
                            text: 'มีตัวเลือกที่ยังไม่ได้กรอกข้อความหรือคะแนน กรุณาตรวจสอบ',
                            confirmButtonColor: '#51c3b7'
                        });
                        return;
                    }
                }
            }
            
            if (currentStep < 3) {
                $('#step' + currentStep).hide();
                currentStep++;
                $('#step' + currentStep).show();
            }
        }
        
        function prevStep() {
            if (currentStep > 1) {
                $('#step' + currentStep).hide();
                currentStep--;
                $('#step' + currentStep).show();
            }
        }
        
        function addQuestion() {
            questionsCount++;
            let questionHtml = '';
            
            if (selectedFormType === 1) {
                questionHtml = `
                    <div class="question-item mb-4 border-0 shadow-sm rounded-3 p-4" style="background: #f8f9fa;" data-question="${questionsCount}">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-primary mb-0"><i class="fas fa-question-circle me-2"></i>คำถามที่ ${questionsCount}</h6>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestion(${questionsCount})">
                                <i class="fas fa-trash me-1"></i>ลบ
                            </button>
                        </div>
                        <div class="mb-3">
                            <input type="text" class="form-control form-control-lg question-text" placeholder="กรอกคำถาม" required>
                        </div>
                        <div class="options-container" data-question="${questionsCount}">
                            <div class="option-item mb-2">
                                <div class="input-group">
                                    <input type="text" class="form-control option-text" placeholder="ตัวเลือกที่ 1" required>
                                    <input type="number" class="form-control option-value" style="max-width: 100px;" placeholder="คะแนน" required>
                                    <button class="btn btn-outline-success" type="button" onclick="addOption(${questionsCount})">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>`;
            } else if (selectedFormType === 2) {
                questionHtml = `
                    <div class="question-item mb-4 border-0 shadow-sm rounded-3 p-4" style="background: #f8f9fa;" data-question="${questionsCount}">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-success mb-0"><i class="fas fa-question-circle me-2"></i>คำถามที่ ${questionsCount}</h6>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestion(${questionsCount})">
                                <i class="fas fa-trash me-1"></i>ลบ
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">คำถาม</label>
                            <textarea class="form-control question-text" rows="2" placeholder="กรอกคำถาม" required></textarea>
                        </div>
                        <div class="options-container" data-question="${questionsCount}">
                            <div class="option-item mb-3">
                                <div class="row">
                                    <div class="col-md-8">
                                        <label class="form-label">ตัวเลือกที่ 1</label>
                                        <textarea class="form-control option-text" rows="2" placeholder="กรอกตัวเลือก" required></textarea>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">คะแนน</label>
                                        <input type="number" class="form-control option-value" placeholder="คะแนน" required>
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button class="btn btn-outline-success w-100" type="button" onclick="addOption(${questionsCount})">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>`;
            }
            
            $('#questions-container').append(questionHtml);
        }
        
        function addSection() {
            questionsCount++;
            let sectionHtml = `
                <div class="section-item mb-4 border-0 shadow-sm rounded-3 p-4" style="background: #fff8e1; border: 2px dashed #ffa726;" data-section="${questionsCount}">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-warning mb-0"><i class="fas fa-folder-open me-2"></i>หัวข้อใหญ่ที่ ${questionsCount}</h5>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSection(${questionsCount})">
                            <i class="fas fa-trash me-1"></i>ลบหัวข้อ
                        </button>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">ชื่อหัวข้อใหญ่</label>
                        <input type="text" class="form-control form-control-lg section-name" placeholder="I. ใบหน้าและปาก" required>
                    </div>
                    
                    <div class="questions-in-section" data-section="${questionsCount}">
                    </div>
                    
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-success" onclick="addQuestionToSection(${questionsCount})">
                            <i class="fas fa-plus me-2"></i>เพิ่มคำถามในหัวข้อนี้
                        </button>
                    </div>
                </div>`;
            
            $('#questions-container').append(sectionHtml);
        }
        
        function addQuestionToSection(sectionId) {
            let sectionQuestionsCount = $(`.questions-in-section[data-section="${sectionId}"] .question-in-section-item`).length + 1;
            let questionHtml = `
                <div class="question-in-section-item mb-3 p-3 rounded-2" style="background: #ffffff; border: 1px solid #e0e0e0;" data-question="${sectionId}-${sectionQuestionsCount}">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-secondary mb-0"><i class="fas fa-question-circle me-2"></i>คำถามย่อยที่ ${sectionQuestionsCount}</h6>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestionFromSection('${sectionId}-${sectionQuestionsCount}')">
                            <i class="fas fa-trash me-1"></i>ลบ
                        </button>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control question-text" placeholder="กรอกคำถาม" required>
                    </div>
                    <div class="options-container" data-question="${sectionId}-${sectionQuestionsCount}">
                        <div class="option-item mb-2">
                            <div class="input-group">
                                <input type="text" class="form-control option-text" placeholder="ตัวเลือกที่ 1">
                                <input type="number" class="form-control option-value" style="max-width: 100px;" placeholder="คะแนน" required>
                                <button class="btn btn-outline-success" type="button" onclick="addOption('${sectionId}-${sectionQuestionsCount}')">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
            
            $(`.questions-in-section[data-section="${sectionId}"]`).append(questionHtml);
        }
        
        function removeSection(sectionId) {
            Swal.fire({
                title: 'ต้องการลบหัวข้อใหญ่นี้หรือไม่?',
                text: 'การดำเนินการนี้จะลบหัวข้อและคำถามทั้งหมดในหัวข้อนี้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#51c3b7',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $(`.section-item[data-section="${sectionId}"]`).remove();
                    Swal.fire({
                        title: 'ลบสำเร็จ!',
                        text: 'หัวข้อใหญ่ถูกลบแล้ว',
                        icon: 'success',
                        confirmButtonColor: '#51c3b7',
                        timer: 1500
                    });
                }
            });
        }
        
        function removeQuestionFromSection(questionId) {
            Swal.fire({
                title: 'ต้องการลบคำถามนี้หรือไม่?',
                text: 'การดำเนินการนี้ไม่สามารถยกเลิกได้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#51c3b7',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $(`.question-in-section-item[data-question="${questionId}"]`).remove();
                    Swal.fire({
                        title: 'ลบสำเร็จ!',
                        text: 'คำถามถูกลบแล้ว',
                        icon: 'success',
                        confirmButtonColor: '#51c3b7',
                        timer: 1500
                    });
                }
            });
        }
        
        function removeQuestion(questionId) {
            Swal.fire({
                title: 'ต้องการลบคำถามนี้หรือไม่?',
                text: 'การดำเนินการนี้ไม่สามารถยกเลิกได้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#51c3b7',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $(`.question-item[data-question="${questionId}"]`).remove();
                    questionsCount--;
                    Swal.fire({
                        title: 'ลบสำเร็จ!',
                        text: 'คำถามถูกลบแล้ว',
                        icon: 'success',
                        confirmButtonColor: '#51c3b7',
                        timer: 1500
                    });
                }
            });
        }
        
        function addOption(questionId) {
            let optionCount = $(`.options-container[data-question="${questionId}"] .option-item`).length + 1;
            let optionHtml = '';
            
            if (selectedFormType === 1) {
                optionHtml = `
                    <div class="option-item mb-2">
                        <div class="input-group">
                            <input type="text" class="form-control option-text" placeholder="ตัวเลือกที่ ${optionCount}" required>
                            <input type="number" class="form-control option-value" style="max-width: 100px;" placeholder="คะแนน" required>
                            <button class="btn btn-outline-danger" type="button" onclick="$(this).closest('.option-item').remove()">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>`;
            } else if (selectedFormType === 2) {
                optionHtml = `
                    <div class="option-item mb-3">
                        <div class="row">
                            <div class="col-md-8">
                                <label class="form-label">ตัวเลือกที่ ${optionCount}</label>
                                <textarea class="form-control option-text" rows="2" placeholder="กรอกตัวเลือก (สามารถพิมพ์ข้อความยาวได้)" required></textarea>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">คะแนน</label>
                                <input type="number" class="form-control option-value" placeholder="คะแนน" required>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-outline-danger w-100" type="button" onclick="$(this).closest('.option-item').remove()">
                                    <i class="fas fa-minus"></i>
                                </button>
                            </div>
                        </div>
                    </div>`;
            } else if (selectedFormType === 3) {
                optionHtml = `
                    <div class="option-item mb-2">
                        <div class="input-group">
                            <input type="text" class="form-control option-text" placeholder="ตัวเลือกที่ ${optionCount}">
                            <input type="number" class="form-control option-value" style="max-width: 100px;" placeholder="คะแนน" required>
                            <button class="btn btn-outline-danger" type="button" onclick="$(this).closest('.option-item').remove()">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>`;
            }
            
            $(`.options-container[data-question="${questionId}"]`).append(optionHtml);
        }
        
        function addResultSetting() {
            resultSettingsCount++;
            let resultSettingHtml = `
                <div class="result-setting-item mb-4 border-0 shadow-sm rounded-3 p-4" style="background: #f8f9fa;" data-result-setting="${resultSettingsCount}">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold text-primary mb-0"><i class="fas fa-chart-line me-2"></i>ช่วงคะแนนที่ ${resultSettingsCount}</h6>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeResultSetting(${resultSettingsCount})">
                            <i class="fas fa-trash me-1"></i>ลบ
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label fw-bold">คะแนนต่ำสุด</label>
                            <input type="number" class="form-control min-score" placeholder="0" min="0" required>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">คะแนนสูงสุด</label>
                            <input type="number" class="form-control max-score" placeholder="0" min="0" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">ระดับความรุนแรง</label>
                            <input type="text" class="form-control result-name" placeholder="Mild, Moderate, Severe">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold">แนวทางปฎิบัติ</label>
                            <textarea class="form-control result-text" rows="2" placeholder="Consult แพทย์"></textarea>
                        </div>
                    </div>
                </div>`;
            $('#result-settings-container').append(resultSettingHtml);
        }
        
        function removeResultSetting(resultSettingId) {
            Swal.fire({
                title: 'ต้องการลบการตั้งค่าผลลัพธ์นี้หรือไม่?',
                text: 'การดำเนินการนี้ไม่สามารถยกเลิกได้',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#51c3b7',
                confirmButtonText: 'ลบ',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    $(`.result-setting-item[data-result-setting="${resultSettingId}"]`).remove();
                    resultSettingsCount--;
                    Swal.fire({
                        title: 'ลบสำเร็จ!',
                        text: 'การตั้งค่าผลลัพธ์ถูกลบแล้ว',
                        icon: 'success',
                        confirmButtonColor: '#51c3b7',
                        timer: 1500
                    });
                }
            });
        }
        
        function saveForm() {
            if (!$('#formName').val().trim()) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณากรอกชื่อแบบประเมิน',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }
            
            if ($('#formName').hasClass('is-invalid')) {
                Swal.fire({
                    icon: 'error',
                    title: 'ชื่อแบบประเมินซ้ำ',
                    text: 'ชื่อแบบประเมินซ้ำกับที่มีอยู่แล้ว กรุณาเปลี่ยนชื่อ',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }
            
            if (selectedFormType === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเลือกประเภทแบบประเมิน',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }
            
            if (selectedFormType === 3) {
                if ($('.section-item').length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณาเพิ่มหัวข้อใหญ่',
                        text: 'กรุณาเพิ่มหัวข้อใหญ่อย่างน้อย 1 หัวข้อ',
                        confirmButtonColor: '#51c3b7'
                    });
                    return;
                }
            } else {
                if ($('.question-item').length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'กรุณาเพิ่มคำถาม',
                        text: 'กรุณาเพิ่มคำถามอย่างน้อย 1 คำถาม',
                        confirmButtonColor: '#51c3b7'
                    });
                    return;
                }
            }
            
            if ($('.result-setting-item').length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'กรุณาเพิ่มการตั้งค่าผลลัพธ์',
                    text: 'กรุณาเพิ่มการตั้งค่าผลลัพธ์อย่างน้อย 1 ช่วงคะแนน',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }
            
            let ResultNotFill = false;
            $('.result-setting-item').each(function() {
                let minScore = $(this).find('.min-score').val();
                let maxScore = $(this).find('.max-score').val();
                let resultName = $(this).find('.result-name').val();
                let resultText = $(this).find('.result-text').val();
                
                if (!minScore || !maxScore || !resultName.trim() || !resultText.trim()) {
                    ResultNotFill = true;
                    return false;
                }
            });
            
            if (ResultNotFill) {
                Swal.fire({
                    icon: 'warning',
                    title: 'ข้อมูลไม่ครบถ้วน',
                    text: 'กรุณากรอกข้อมูลการตั้งค่าผลลัพธ์ให้ครบถ้วน (คะแนนต่ำสุด, คะแนนสูงสุด, ระดับความรุนแรง, และแนวทางปฎิบัติ)',
                    confirmButtonColor: '#51c3b7'
                });
                return;
            }
            
            Swal.fire({
                title: 'กำลังบันทึก...',
                text: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
            
            let formData = new FormData();
            formData.append('formName', $('#formName').val());
            formData.append('formType', selectedFormType);
            formData.append('scoring', $('#scoringMethod').val());
            
            let questionsData = [];
            
            if (selectedFormType === 3) {
                $('.section-item').each(function() {
                    let sectionName = $(this).find('.section-name').val().trim();
                    
                    if (sectionName) {
                        $(this).find('.question-in-section-item').each(function() {
                            let questionText = $(this).find('.question-text').val().trim();
                            
                            if (questionText) {
                                let question = {
                                    questionText: questionText,
                                    section: sectionName, 
                                    options: []
                                };
                                
                                $(this).find('.option-item').each(function() {
                                    let optionText = $(this).find('.option-text').val().trim();
                                    let optionValue = $(this).find('.option-value').val();
                                    
                                    if (optionValue) { 
                                        question.options.push({
                                            optionText: optionText || '', 
                                            value: parseInt(optionValue) || 0
                                        });
                                    }
                                });
                                
                                if (question.options.length > 0) {
                                    questionsData.push(question);
                                }
                            }
                        });
                    }
                });
            } else {
                $('.question-item').each(function() {
                    let questionText = $(this).find('.question-text').val().trim();
                    
                    if (questionText) {
                        let question = {
                            questionText: questionText,
                            section: null,
                            options: []
                        };
                        
                        $(this).find('.option-item').each(function() {
                            let optionText = $(this).find('.option-text').val().trim();
                            let optionValue = $(this).find('.option-value').val();
                            
                            if (optionText && optionValue) {
                                question.options.push({
                                    optionText: optionText,
                                    value: parseInt(optionValue) || 0
                                });
                            }
                        });
                        
                        if (question.options.length > 0) {
                            questionsData.push(question);
                        }
                    }
                });
            }
            
            let interpretersData = [];
            $('.result-setting-item').each(function() {
                let minScore = $(this).find('.min-score').val();
                let maxScore = $(this).find('.max-score').val();
                let interName = $(this).find('.result-name').val().trim();
                let interText = $(this).find('.result-text').val().trim();
                
                if (minScore && maxScore && interName && interText) {
                    interpretersData.push({
                        minScore: parseInt(minScore),
                        maxScore: parseInt(maxScore),
                        interName: interName,
                        interText: interText
                    });
                }
            });
            
            console.log('Questions Data:', questionsData); 
            console.log('Interpreters Data:', interpretersData); 
            
            formData.append('questionsJson', JSON.stringify(questionsData));
            formData.append('interpretersJson', JSON.stringify(interpretersData));
            
            $.ajax({
                url: '@Url.Action("CreateForm", "Pharma")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(result) {
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'บันทึกสำเร็จ!',
                            text: 'บันทึกแบบประเมินเรียบร้อยแล้ว',
                            confirmButtonColor: '#51c3b7'
                        }).then(() => {
                            window.location.href = '@Url.Action("Forms", "Pharma")';
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'เกิดข้อผิดพลาด',
                            text: 'เกิดข้อผิดพลาดในการบันทึก: ' + result.message,
                            confirmButtonColor: '#51c3b7'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'เกิดข้อผิดพลาดในการบันทึก: ' + error,
                        confirmButtonColor: '#51c3b7'
                    });
                }
            });
        }
    </script>
    
