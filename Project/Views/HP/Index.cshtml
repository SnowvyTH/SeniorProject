@{
    ViewData["Title"] = "ระบบหัวหน้าเภสัชกรรม";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-success">
                    <i class="fas fa-user-md me-2"></i>ระบบหัวหน้าเภสัชกรรม
                </h2>
                <div class="dropdown">
                    <button class="btn btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-user me-1"></i>@ViewBag.UserName
                    </button>
                    <ul class="dropdown-menu">
                        <li><span class="dropdown-item-text">บทบาท: @ViewBag.RoleName</span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="@Url.Action("Logout", "Home")">
                            <i class="fas fa-sign-out-alt me-1"></i>ออกจากระบบ
                        </a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">เภสัชกรทั้งหมด</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-users fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>จำนวนเภสัชกรในแผนก</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">รายงานวันนี้</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-file-alt fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>รายงานที่รอตรวจสอบ</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">การอนุมัติ</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-check-circle fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>รายการรอการอนุมัติ</small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card stats-card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">ปัญหาเร่งด่วน</h4>
                            <h2 class="mb-0">-</h2>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-exclamation-triangle fa-2x"></i>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-dark">
                    <small>ปัญหาที่ต้องแก้ไขด่วน</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>ภาพรวมแผนกเภสัชกรรม
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-chart-line fa-3x mb-3 text-success"></i>
                        <p>กราฟแสดงสถิติการทำงานของแผนกเภสัชกรรม</p>
                        <small>ข้อมูลจะแสดงเมื่อมีการทำงานของเภสัชกร</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card dashboard-card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-tasks me-2"></i>งานที่ต้องดำเนินการ
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-user-check me-2 text-success"></i>อนุมัติการประเมิน</span>
                            <span class="badge bg-success rounded-pill">0</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-file-signature me-2 text-warning"></i>ตรวจสอบรายงาน</span>
                            <span class="badge bg-warning rounded-pill">0</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-cog me-2 text-info"></i>จัดการระบบ</span>
                            <span class="badge bg-info rounded-pill">0</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('HP Dashboard loaded');
            
            // เพิ่ม JavaScript สำหรับฟังก์ชันการทำงานของหัวหน้าเภสัช
        });
    </script>
}
