@model IEnumerable<Project.Models.Entity.Patient>
@using Project.Models.Entity
@{
    ViewData["Title"] = "เวชระเบียนผู้ป่วย";
    Layout = "~/Views/Shared/_HPLayout.cshtml";
}

<div class="container-fluid">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-user-injured me-2"></i>เวชระเบียนผู้ป่วย
            </h2>
        </div>
    </div>

    
    <div class="filter-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label fw-bold">ค้นหาผู้ป่วย</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="ค้นหา HN, ชื่อ-นามสกุล...">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">ประเภทผู้ป่วย</label>
                    <select class="form-select" id="patientTypeFilter">
                        <option value="">ทั้งหมด</option>
                        <option value="OPD">ผู้ป่วยนอก (OPD)</option>
                        <option value="WARD">ผู้ป่วยใน (WARD)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="fas fa-times me-2"></i>ล้าง
                    </button>
                </div>
            </div>
        </div>
    </div>

    
    <div class="chart-card">
        <div class="chart-body p-0">
            <div class="table-responsive" style="overflow: visible;">
                <table class="table table-hover mb-0" id="patientsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="8%">ลำดับ</th>
                            <th width="42%">ชื่อผู้ป่วย</th>
                            <th width="12%">ประเภท</th>
                            <th width="15%">การประเมินล่าสุด</th>
                            <th width="22%">ประวัติการประเมิน</th>
                        </tr>
                    </thead>
                    <tbody id="patientsTableBody">
                        @foreach(var patient in Model)
                        {
                            var age = patient.BirthDate.HasValue ? DateTime.Now.Year - patient.BirthDate.Value.Year : 0;
                            var latestEvaluation = patient.Evaluations?.OrderByDescending(e => e.RecordDate).FirstOrDefault();
                            var evaluationCount = patient.Evaluations?.Count() ?? 0;
                            
                            <tr class="patient-row" 
                                data-hn="@patient.HN" 
                                data-name="@($"{patient.Title?.TitleName}{patient.FirstName} {patient.LastName}")" 
                                data-type="@(patient.PatientType ?? "")"
                                data-evaluated="@(evaluationCount > 0 ? "true" : "false")">
                                <td><span class="text-center mx-3">1</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-2">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@($"{patient.Title?.TitleName}{patient.FirstName} {patient.LastName}")</div>
                                            <div class="small text-muted">@patient.HN</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if(patient.PatientType == "WARD")
                                    {
                                        <span class="badge bg-success bg-gradient">WARD</span>
                                    }
                                    else if(patient.PatientType == "OPD")
                                    {
                                        <span class="badge bg-primary bg-gradient">OPD</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">ไม่ระบุ</span>
                                    }
                                </td>
                                <td>
                                    @if(latestEvaluation != null)
                                    {
                                        <div class="latest-evaluation">
                                            <div class="small fw-bold text-primary">@latestEvaluation.RecordDate.ToString("dd/MM/yyyy")</div>
                                            <div class="small text-muted">@latestEvaluation.Form?.FormName</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">ยังไม่ได้ประเมิน</span>
                                    }
                                </td>
                                <td>
                                    @if(evaluationCount > 0)
                                    {
                                        <div class="dropdown position-static">
                                            <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-history me-1"></i>ดูประวัติ (@evaluationCount ครั้ง)
                                            </button>
                                            <ul class="dropdown-menu shadow-lg">
                                                <li><h6 class="dropdown-header"><i class="fas fa-list me-2"></i>ประวัติการประเมิน</h6></li>
                                                @{
                                                    var evaluationsList = (patient.Evaluations ?? new List<Evaluation>()).OrderByDescending(e => e.RecordDate).Take(5).ToList();
                                                }
                                                @for(int i = 0; i < evaluationsList.Count; i++)
                                                {
                                                    var evaluation = evaluationsList[i];
                                                    var severityClass = "";
                                                    var severityIcon = "";
                                                    var resultText = evaluation.Result ?? "ไม่ระบุ";
                                                    
                                                    // กำหนดสีและไอคอนตามความรุนแรง
                                                    if(resultText.Contains("รุนแรง") || resultText.Contains("Severe"))
                                                    {
                                                        severityClass = "badge-critical";
                                                        severityIcon = "fas fa-exclamation-triangle";
                                                    }
                                                    else if(resultText.Contains("Moderate") || resultText.Contains("ปานกลาง"))
                                                    {
                                                        severityClass = "badge-high-risk";
                                                        severityIcon = "fas fa-exclamation-circle";
                                                    }
                                                    else if(resultText.Contains("Mild") || resultText.Contains("เล็กน้อย"))
                                                    {
                                                        severityClass = "badge-low-risk";
                                                        severityIcon = "fas fa-info-circle";
                                                    }
                                                    else
                                                    {
                                                        severityClass = "badge-safe";
                                                        severityIcon = "fas fa-check-circle";
                                                    }
                                                    
                                                    <li>
                                                        <div class="dropdown-item-text evaluation-item p-2" style="cursor: pointer;" onclick="viewEvaluationDetail(@evaluation.EvaID)">
                                                            <div class="d-flex justify-content-between align-items-center">
                                                                <div class="flex-grow-1">
                                                                    <div class="fw-bold text-primary small">
                                                                        @evaluation.Form?.FormName
                                                                        @if(i == 0)
                                                                        {
                                                                            <span class="text-success small fw-normal">(ล่าสุด)</span>
                                                                        }
                                                                    </div>
                                                                    <div class="small text-muted">@evaluation.RecordDate.ToString("dd/MM/yyyy HH:mm")</div>
                                                                </div>
                                                                <div class="severity-display ms-2">
                                                                    <span class="badge @severityClass small">
                                                                        <i class="@severityIcon me-1"></i>@resultText
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </li>
                                                    @if(i < evaluationsList.Count - 1)
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="fas fa-info-circle me-1"></i>ยังไม่มีการประเมิน
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            
            <div class="mobile-patient-list" id="mobilePatientList">
                
            </div>
            
            <div id="loadingSpinner" class="text-center p-4" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">กำลังโหลด...</span>
                </div>
            </div>
            <div id="noDataMessage" class="text-center p-4" style="display: none;">
                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">ไม่พบข้อมูลผู้ป่วย</h5>
                <p class="text-muted">ลองปรับเปลี่ยนการค้นหาหรือตัวกรอง</p>
            </div>
        </div>
    </div> 
    
    
    <nav aria-label="Page navigation" class="mt-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <small class="text-muted" id="hpPaginationInfo"></small>
            </div>
            <ul class="pagination pagination-sm mb-0" id="hpPagination">
                
            </ul>
        </div>
    </nav>
</div>

@section Styles {
    <style>
        /* HP Theme Variables */
        :root {
            --primary-color: #2c5aa0;
            --secondary-color: #3498db;
            --accent-color: #1abc9c;
            --success-color: #27ae60;
            --warning-color: #f39c12;
            --danger-color: #e74c3c;
            --info-color: #17a2b8;
            --light-color: #ecf0f1;
            --dark-color: #2c3e50;
        }

        .page-title {
            color: var(--primary-color);
            font-weight: 700;
        }

        .avatar-sm {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
            background-color: #f8f9fa;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(44, 90, 160, 0.1);
        }

        .table td {
            overflow: visible !important;
            position: relative;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .dropdown-menu {
            border-radius: 8px;
            min-width: 280px;
            max-width: 320px;
            z-index: 1050 !important;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            border: 1px solid rgba(0,0,0,.125);
            position: absolute !important;
        }

        .dropdown {
            position: static !important;
        }

        .evaluation-item:hover {
            background-color: #f8f9fa;
        }

        .evaluation-item {
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        /* Custom Severity Badge Classes */
        .badge-safe {
            background-color: #28a745 !important;
            color: white;
        }
        
        .badge-low-risk {
            background-color: #20c997 !important;
            color: white;
        }
        
        .badge-medium-risk {
            background-color: #ffc107 !important;
            color: #212529;
        }
        
        .badge-high-risk {
            background-color: #fd7e14 !important;
            color: white;
        }
        
        .badge-critical {
            background-color: #dc3545 !important;
            color: white;
            box-shadow: 0 2px 4px rgba(220, 53, 69, 0.3);
        }

        .patient-row.hidden {
            display: none;
        }

        /* ซ่อนตารางตั้งแต่แรกเพื่อป้องกันการกระพริบ */
        #patientsTable tbody {
            display: none;
        }
        
        #patientsTable tbody.loaded {
            display: table-row-group;
        }

        .latest-evaluation {
            line-height: 1.2;
        }

        /* Patient name display improvements */
        .patient-name-container {
            line-height: 1.3;
        }

        .patient-name-container .fw-bold {
            font-size: 0.95rem;
            margin-bottom: 2px;
        }

        .patient-name-container .small {
            font-size: 0.8rem;
            color: #6c757d !important;
        }

        /* Compact evaluation items */
        .evaluation-item {
            border-radius: 6px;
            margin: 2px 0;
        }

        .evaluation-item .small {
            font-size: 0.75rem;
            line-height: 1.2;
        }

        .evaluation-item .badge.small {
            font-size: 0.7rem;
            padding: 0.3rem 0.5rem;
        }

        .btn {
            border-radius: 8px;
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #e0e6ed;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(44, 90, 160, 0.25);
        }

        .input-group-text {
            background-color: var(--primary-color);
            color: white;
            border: 1px solid var(--primary-color);
            border-radius: 8px 0 0 8px;
        }

        .input-group .form-control {
            border-radius: 0 8px 8px 0;
        }

        .badge {
            border-radius: 6px;
        }

        /* Responsive Design for Patients Page */
        
        /* iPad Portrait (820 x 1180) */
        @@media (min-width: 769px) and (max-width: 1024px) {
            .container-fluid {
                padding: 0 15px;
            }
            
            .page-title {
                font-size: 1.8rem;
                margin-bottom: 1.2rem;
            }
            
            /* Filter Card */
            .filter-card {
                margin-bottom: 1.5rem;
            }
            
            .filter-card .card-body {
                padding: 1.2rem;
            }
            
            .filter-card .row {
                margin: 0 -8px;
            }
            
            .filter-card .col-md-7 {
                width: 100%;
                padding: 0 8px;
                margin-bottom: 1rem;
            }
            
            .filter-card .col-md-3,
            .filter-card .col-md-2 {
                width: 50%;
                padding: 0 8px;
            }
            
            .filter-card label {
                font-size: 0.9rem;
                margin-bottom: 0.4rem;
            }
            
            .filter-card .form-control,
            .filter-card .form-select {
                font-size: 0.95rem;
            }
            
            .filter-card .btn {
                font-size: 0.9rem;
                padding: 0.6rem 1rem;
            }
            
            /* Table */
            .table-responsive {
                border-radius: 12px;
            }
            
            .table th {
                font-size: 0.9rem;
                padding: 0.8rem 0.6rem;
            }
            
            .table td {
                font-size: 0.85rem;
                padding: 0.8rem 0.6rem;
            }
            
            .avatar-sm {
                width: 38px;
                height: 38px;
                font-size: 1.1rem;
            }
            
            .table th[width="8%"] {
                width: 6%;
            }
            
            .table th[width="42%"] {
                width: 40%;
            }
            
            .table th[width="12%"] {
                width: 15%;
            }
            
            .table th[width="15%"] {
                width: 18%;
            }
            
            .table th[width="22%"] {
                width: 21%;
            }
            
            .dropdown-menu {
                min-width: 260px;
                max-width: 300px;
            }
            
            .evaluation-item {
                padding: 0.6rem 0.8rem;
            }
            
            .evaluation-item .small {
                font-size: 0.75rem;
            }
            
            /* Pagination */
            .pagination {
                font-size: 0.9rem;
            }
            
            .pagination .page-link {
                padding: 0.5rem 0.8rem;
            }
        }

        /* Mobile (375 x 667 and similar) - Show cards instead of table */
        @@media (max-width: 768px) {
            .container-fluid {
                padding: 0 10px;
            }
            
            .page-title {
                font-size: 1.5rem;
                margin-bottom: 1rem;
            }
            
            .page-title i {
                font-size: 1.3rem;
            }
            
            .d-flex.justify-content-between {
                flex-direction: column;
                align-items: flex-start !important;
                margin-bottom: 1rem;
            }
            
            /* Filter Card */
            .filter-card {
                margin-bottom: 1rem;
            }
            
            .filter-card .card-body {
                padding: 1rem;
            }
            
            .filter-card .row {
                margin: 0 -8px;
            }
            
            .filter-card .col-md-7,
            .filter-card .col-md-3,
            .filter-card .col-md-2 {
                width: 100%;
                padding: 0 8px;
                margin-bottom: 1rem;
            }
            
            .filter-card .col-md-2 {
                margin-bottom: 0;
            }
            
            .filter-card label {
                font-size: 0.9rem;
                margin-bottom: 0.4rem;
                font-weight: 600;
            }
            
            .filter-card .input-group-text {
                padding: 0.5rem 0.8rem;
            }
            
            .filter-card .form-control,
            .filter-card .form-select {
                font-size: 0.9rem;
                padding: 0.5rem 0.8rem;
            }
            
            .filter-card .btn {
                width: 100%;
                padding: 0.6rem;
                font-size: 0.9rem;
                margin-top: 0 !important;
            }
            
            /* Hide table, show mobile cards */
            .table-responsive {
                display: none !important;
            }
            
            /* Mobile card layout */
            .mobile-patient-list {
                display: block !important;
            }
            
            .patient-card-mobile {
                background: white;
                border-radius: 12px;
                padding: 1rem;
                margin-bottom: 1rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.08);
                border: 1px solid #e9ecef;
            }
            
            .patient-card-mobile .patient-header {
                display: flex;
                align-items: center;
                margin-bottom: 0.8rem;
                padding-bottom: 0.8rem;
                border-bottom: 1px solid #e9ecef;
                gap: 0.8rem;
            }
            
            .patient-card-mobile .avatar-sm {
                width: 45px;
                height: 45px;
                font-size: 1.3rem;
                margin-right: 0;
                flex-shrink: 0;
            }
            
            .patient-card-mobile .patient-name {
                font-size: 1rem;
                font-weight: 600;
                color: var(--dark-color);
                margin-bottom: 0.2rem;
                line-height: 1.3;
                margin-bottom: 0.2rem;
            }
            
            .patient-card-mobile .patient-hn {
                font-size: 0.8rem;
                color: #6c757d;
            }
            
            .patient-card-mobile .patient-info-section {
                margin-bottom: 0.8rem;
            }
            
            .patient-card-mobile .info-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0.6rem 0.8rem;
                background: #f8f9fa;
                border-radius: 8px;
                margin-bottom: 0.5rem;
            }
            
            .patient-card-mobile .info-label {
                color: #6c757d;
                font-weight: 500;
                font-size: 0.85rem;
            }
            
            .patient-card-mobile .latest-eval-card {
                background: #f8f9fa;
                padding: 0.8rem;
                border-radius: 8px;
                margin: 0.8rem 0;
            }
            
            .patient-card-mobile .latest-eval-card .eval-date {
                font-weight: 600;
                color: var(--primary-color);
                font-size: 0.85rem;
            }
            
            .patient-card-mobile .latest-eval-card .eval-form {
                font-size: 0.75rem;
                color: #6c757d;
            }
            
            .patient-card-mobile .action-buttons {
                display: flex;
                gap: 0.5rem;
                margin-top: 0.8rem;
                padding-top: 0.8rem;
                border-top: 1px solid #e9ecef;
            }
            
            .patient-card-mobile .btn-sm {
                flex: 1;
                font-size: 0.85rem;
                padding: 0.6rem;
                white-space: nowrap;
            }
            
            .patient-card-mobile .dropdown {
                position: relative !important;
            }
            
            .patient-card-mobile .dropdown-menu {
                min-width: 280px;
                max-width: calc(100vw - 40px);
                max-height: 70vh;
                overflow-y: auto;
                position: absolute !important;
                z-index: 1060 !important;
            }
            
            .patient-card-mobile .dropdown-toggle {
                width: 100%;
                text-align: left;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            
            .patient-card-mobile .dropdown-toggle::after {
                margin-left: auto;
            }
            
            .dropdown-menu .evaluation-item {
                padding: 0.8rem 1rem;
                border-bottom: 1px solid #f0f0f0;
                cursor: pointer;
            }
            
            .dropdown-menu .evaluation-item:last-child {
                border-bottom: none;
            }
            
            .dropdown-menu .evaluation-item:active {
                background-color: #e9ecef;
            }
            
            /* Pagination */
            .pagination {
                flex-wrap: wrap;
                justify-content: center;
                gap: 0.3rem;
            }
            
            .pagination .page-item {
                margin: 0.2rem;
            }
            
            .pagination .page-link {
                padding: 0.5rem 0.8rem;
                font-size: 0.85rem;
                min-width: 38px;
                text-align: center;
            }
            
            #hpPaginationInfo {
                font-size: 0.8rem;
                text-align: center;
                width: 100%;
                margin-bottom: 0.5rem;
            }
            
            nav[aria-label="Page navigation"] .d-flex {
                flex-direction: column;
                align-items: center;
            }
            
            /* Loading and No Data Messages */
            #loadingSpinner,
            #noDataMessage {
                padding: 2rem 1rem;
            }
            
            #noDataMessage i {
                font-size: 2.5rem;
            }
            
            #noDataMessage h5 {
                font-size: 1rem;
                margin-top: 0.8rem;
            }
            
            #noDataMessage p {
                font-size: 0.85rem;
            }
        }
        
        /* Extra Small Mobile (iPhone SE, etc. - 375px and below) */
        @@media (max-width: 480px) {
            .container-fluid {
                padding: 0 8px;
            }
            
            .page-title {
                font-size: 1.3rem;
            }
            
            .filter-card .card-body {
                padding: 0.8rem;
            }
            
            .filter-card .row {
                margin: 0 -6px;
            }
            
            .filter-card .col-md-7,
            .filter-card .col-md-3,
            .filter-card .col-md-2 {
                padding: 0 6px;
                margin-bottom: 0.8rem;
            }
            
            .filter-card label {
                font-size: 0.85rem;
            }
            
            .filter-card .form-control,
            .filter-card .form-select,
            .filter-card .input-group-text {
                font-size: 0.85rem;
                padding: 0.45rem 0.7rem;
            }
            
            .filter-card .btn {
                padding: 0.5rem;
                font-size: 0.85rem;
            }
            
            .patient-card-mobile {
                padding: 0.8rem;
            }
            
            .patient-card-mobile .avatar-sm {
                width: 40px;
                height: 40px;
                font-size: 1.1rem;
            }
            
            .patient-card-mobile .patient-name {
                font-size: 0.95rem;
            }
            
            .patient-card-mobile .patient-hn {
                font-size: 0.75rem;
            }
            
            .patient-card-mobile .info-row {
                padding: 0.5rem 0.6rem;
            }
            
            .patient-card-mobile .info-label {
                font-size: 0.8rem;
            }
            
            .patient-card-mobile .badge {
                font-size: 0.7rem;
                padding: 0.3rem 0.5rem;
            }
            
            .patient-card-mobile .latest-eval-card {
                padding: 0.6rem;
            }
            
            .patient-card-mobile .latest-eval-card .eval-date {
                font-size: 0.8rem;
            }
            
            .patient-card-mobile .latest-eval-card .eval-form {
                font-size: 0.7rem;
            }
            
            .patient-card-mobile .btn-sm {
                font-size: 0.8rem;
                padding: 0.5rem;
            }
            
            .pagination .page-link {
                padding: 0.4rem 0.6rem;
                font-size: 0.8rem;
                min-width: 34px;
            }
            
            .dropdown-menu {
                min-width: 240px;
                font-size: 0.85rem;
            }
            
            .dropdown-menu .evaluation-item {
                padding: 0.5rem 0.6rem;
            }
            
            .dropdown-menu .small {
                font-size: 0.7rem;
            }
        }
        
        /* Landscape Mode for Mobile */
        @@media (max-height: 500px) and (orientation: landscape) {
            .page-title {
                font-size: 1.2rem;
                margin-bottom: 0.8rem;
            }
            
            .filter-card {
                margin-bottom: 0.8rem;
            }
            
            .filter-card .card-body {
                padding: 0.8rem;
            }
            
            .patient-card-mobile {
                padding: 0.8rem;
                margin-bottom: 0.8rem;
            }
            
            .patient-card-mobile .patient-header {
                margin-bottom: 0.5rem;
                padding-bottom: 0.5rem;
            }
        }

        /* Desktop - Hide mobile cards */
        @@media (min-width: 769px) {
            .mobile-patient-list {
                display: none !important;
            }
        }

        /* Extra small mobile */
        @@media (max-width: 480px) {
            .container-fluid {
                padding: 0 10px;
            }
            
            .page-title {
                font-size: 1.2rem;
            }
            
            .chart-card {
                border-radius: 10px;
            }
            
            .patient-card-mobile {
                padding: 0.8rem;
            }
            
            .patient-card-mobile .patient-name {
                font-size: 0.9rem;
            }
            
            .patient-card-mobile .avatar-sm {
                width: 40px;
                height: 40px;
                font-size: 1.1rem;
            }
            
            .filter-card .form-control,
            .filter-card .form-select {
                font-size: 0.85rem;
            }
        }
    </style>
}

@section Scripts {
    <script src="~/js/pagination.js"></script>
    <script>
        let currentHPPage = 1;
        const hpPageSize = 5;
        let allHPPatients = [];

        $(document).ready(function() {
            loadHPPatients();
            setupHPFilters();
            setupDropdownHandlers();
        });

        function setupHPFilters() {
            $('#searchInput').on('input', function() {
                currentHPPage = 1;
                loadHPPatients();
            });
            $('#patientTypeFilter, #evaluationFilter').on('change', function() {
                currentHPPage = 1;
                loadHPPatients();
            });
        }

        function loadHPPatients() {
            $('#loadingSpinner').show();
            $('#noDataMessage').hide();
            
            const searchQuery = $('#searchInput').val().toLowerCase();
            const patientTypeFilter = $('#patientTypeFilter').val();
            const evaluationFilter = $('#evaluationFilter').val();

            if (allHPPatients.length === 0) {
                $('.patient-row').each(function() {
                    const row = $(this);
                    allHPPatients.push({
                        element: row,
                        hn: row.data('hn') ? row.data('hn').toString().toLowerCase() : '',
                        name: row.data('name') ? row.data('name').toString().toLowerCase() : '',
                        patientType: row.data('type') ? row.data('type').toString() : '',
                        evaluated: row.data('evaluated') ? row.data('evaluated').toString() : 'false'
                    });
                });
            }

            const filteredPatients = allHPPatients.filter(function(patient) {
                const matchesSearch = searchQuery === '' || 
                    patient.hn.includes(searchQuery) || 
                    patient.name.includes(searchQuery);
                const matchesType = !patientTypeFilter || patient.patientType === patientTypeFilter;
                const matchesEvaluation = !evaluationFilter || 
                    (evaluationFilter === 'evaluated' && patient.evaluated === 'true') ||
                    (evaluationFilter === 'not-evaluated' && patient.evaluated === 'false');
                
                return matchesSearch && matchesType && matchesEvaluation;
            });

            displayHPPatients(filteredPatients);
            $('#loadingSpinner').hide();
        }

        function displayHPPatients(patients) {
            const paginatedData = paginateData(patients, currentHPPage, hpPageSize);
            const tbody = $('#patientsTableBody');
            const mobileList = $('#mobilePatientList');
            tbody.empty();
            mobileList.empty();

            if (paginatedData.items.length === 0) {
                document.getElementById('hpPagination').innerHTML = '';
                $('#noDataMessage').show();
                $('#hpPagination').parent().hide();
                $('#hpPaginationInfo').text('');
                $('#patientsTable tbody').hide();
                return;
            }
            
            $('#noDataMessage').hide();
            $('#hpPagination').parent().show();
            $('#patientsTable tbody').addClass('loaded').show();
            
            paginatedData.items.forEach(function(patient, index) {
                const rowNumber = ((currentHPPage - 1) * hpPageSize) + index + 1;
                const newRow = patient.element.clone();
                newRow.find('td:first span').text(rowNumber);
                tbody.append(newRow);
                
                const patientData = extractPatientData(patient.element);
                const mobileCard = createMobilePatientCard(patientData, rowNumber);
                mobileList.append(mobileCard);
            });
            
            generatePagination(paginatedData.totalPages, currentHPPage, 'hpPagination', 'changeHPPage');
            updatePaginationInfo(currentHPPage, hpPageSize, paginatedData.totalItems, 'hpPaginationInfo');
        }
        
        function extractPatientData(rowElement) {
            const row = $(rowElement);
            // เลือกเฉพาะ badge ที่อยู่ในคอลัมน์ "ประเภท" (td ที่ 3) ไม่ใช่ badge ที่อยู่ใน dropdown
            const typeBadge = row.find('td:eq(2) .badge');
            return {
                hn: row.data('hn'),
                name: row.data('name'),
                type: row.data('type'),
                typeDisplay: typeBadge.text().trim(),
                typeBadgeClass: typeBadge.attr('class'),
                latestEvalDate: row.find('.latest-evaluation .fw-bold').text().trim(),
                latestEvalForm: row.find('.latest-evaluation .text-muted').text().trim(),
                hasEvaluation: row.find('.dropdown').length > 0,
                evaluationCount: row.find('.dropdown button').text().match(/\d+/)?.[0] || '0',
                dropdownHtml: row.find('.dropdown').html()
            };
        }
        
        function createMobilePatientCard(data, rowNumber) {
            const hasEval = data.latestEvalDate !== '';
            
            return `
                <div class="patient-card-mobile">
                    <div class="patient-header">
                        <div class="avatar-sm">
                            <i class="fas fa-user"></i>
                        </div>
                        <div style="flex: 1;">
                            <div class="patient-name">${data.name}</div>
                            <div class="patient-hn">HN: ${data.hn}</div>
                        </div>
                    </div>
                    
                    <div class="patient-info-section">
                        <div class="info-row">
                            <span class="info-label">ประเภทผู้ป่วย</span>
                            <span class="${data.typeBadgeClass}">${data.typeDisplay}</span>
                        </div>
                    </div>
                    
                    ${hasEval ? `
                    <div class="latest-eval-card">
                        <div style="font-size: 0.75rem; color: #6c757d; margin-bottom: 0.4rem;">
                            <i class="fas fa-calendar-check me-1"></i>การประเมินล่าสุด
                        </div>
                        <div class="eval-date">${data.latestEvalDate}</div>
                        <div class="eval-form">${data.latestEvalForm}</div>
                    </div>
                    ` : `
                    <div style="text-align: center; padding: 1rem; color: #6c757d; font-size: 0.85rem; background: #f8f9fa; border-radius: 8px; margin-top: 0.8rem;">
                        <i class="fas fa-info-circle me-1"></i>ยังไม่มีการประเมิน
                    </div>
                    `}
                    
                    ${data.hasEvaluation ? `
                    <div class="action-buttons">
                        <div class="dropdown position-static w-100">
                            ${data.dropdownHtml}
                        </div>
                    </div>
                    ` : ''}
                </div>
            `;
        }

        function changeHPPage(page) {
            currentHPPage = page;
            displayHPPatients(allHPPatients.filter(function(patient) {
                const searchQuery = $('#searchInput').val().toLowerCase();
                const patientTypeFilter = $('#patientTypeFilter').val();
                const evaluationFilter = $('#evaluationFilter').val();

                const matchesSearch = searchQuery === '' || 
                    patient.hn.includes(searchQuery) || 
                    patient.name.includes(searchQuery);
                const matchesType = !patientTypeFilter || patient.patientType === patientTypeFilter;
                const matchesEvaluation = !evaluationFilter || 
                    (evaluationFilter === 'evaluated' && patient.evaluated === 'true') ||
                    (evaluationFilter === 'not-evaluated' && patient.evaluated === 'false');
                
                return matchesSearch && matchesType && matchesEvaluation;
            }));
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#patientTypeFilter').val('');
            $('#evaluationFilter').val('');
            currentHPPage = 1;
            loadHPPatients();
        }

        function setupDropdownHandlers() {
            $(document).on('show.bs.dropdown', '.dropdown', function () {
                const dropdown = $(this);
                const menu = dropdown.find('.dropdown-menu');
                
                menu.removeClass('dropdown-menu-end dropdown-menu-start');
                menu.css({
                    'position': 'absolute',
                    'inset': 'auto',
                    'margin': '0',
                    'transform': 'none'
                });
                
                setTimeout(function() {
                    const rect = dropdown[0].getBoundingClientRect();
                    const menuRect = menu[0].getBoundingClientRect();
                    const viewportWidth = window.innerWidth;
                    
                    if (rect.right + menuRect.width > viewportWidth) {
                        menu.addClass('dropdown-menu-end');
                    }
                }, 10);
            });

            $(document).on('hide.bs.dropdown', '.dropdown', function () {
                const menu = $(this).find('.dropdown-menu');
                menu.css({
                    'position': '',
                    'inset': '',
                    'margin': '',
                    'transform': ''
                });
            });

            // ป้องกันการ scroll ปิด dropdown บน mobile
            $(window).on('scroll', function() {
                if ($(window).width() > 768) {
                    $('.dropdown').each(function() {
                        $(this).find('.dropdown-toggle').dropdown('hide');
                    });
                }
            });

            $('.table-responsive').on('scroll', function() {
                $('.dropdown').each(function() {
                    $(this).find('.dropdown-toggle').dropdown('hide');
                });
            });

            // ป้องกัน dropdown ปิดเมื่อคลิกภายในเมนู
            $(document).on('click', '.dropdown-menu', function(e) {
                e.stopPropagation();
            });
        }
            
        function viewEvaluationDetail(evaluationId) {
            $('.dropdown').each(function() {
                $(this).find('.dropdown-toggle').dropdown('hide');
            });
            
            window.location.href = `/HP/EvaluationDetail/${evaluationId}`;
        }
    </script>
}